ZHAMA_HOMEPAGE_IMAGE=ghcr.io/zhama-ai/zhama-homepage:v1.0.0-amd64
# Host port the edge nginx forwards zhama.com.cn to.
HOMEPAGE_PORT=3000

# SMTP settings for the contact form.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60000
