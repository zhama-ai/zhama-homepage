# Written by deploy.sh after each verified release.
HOMEPAGE_IMAGE=ghcr.io/zhama-ai/zhama-homepage:v1.0.0-amd64
# Host port the edge nginx forwards zhama.com.cn to.
HOMEPAGE_PORT=9200

# Contact form mail. Unset values fall back to the defaults in docker-compose.yml.
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@zhama.com
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=
