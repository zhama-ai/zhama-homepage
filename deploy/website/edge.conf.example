# Edge Nginx virtual hosts for the website, for the containerised proxy on the
# deployment host (attached to the same Docker network as zhama-website).
# The website container itself redirects other hosts and HTTP to the canonical
# https://www.zhama.com, so the edge only terminates TLS and forwards.

# Every host on the edge moves from HTTP to HTTPS on the same host.
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name www.zhama.com zhama.com;
    ssl_certificate     /etc/nginx/cert/zhama.com.pem;
    ssl_certificate_key /etc/nginx/cert/zhama.com.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;

    location / {
        # Resolve at request time so the edge starts even while the site is down.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $website http://zhama-website:80;
        proxy_pass $website;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
