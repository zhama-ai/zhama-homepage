---
import type { Locale } from '../data/types';
import { pathFor, appFor, ui } from '../lib/site';
const {locale = 'zh', home = false} = Astro.props as {locale:Locale;home?:boolean};
const zh = locale === 'zh';
---
<section class="site-closing">
  {home && <div class="closing-backdrop" aria-hidden="true">
    <img src="/images/closing/office-skyline_V1.0.webp" alt="" width="2172" height="724" sizes="100vw" loading="lazy" decoding="async"/>
  </div>}
  <div class="container closing-content">
    {home && <p class="ui-meta">TeGo {zh ? '数字员工协作平台' : 'Digital Employee Collaboration Platform'}</p>}
    <h2 class="ui-section-title">{zh ? '让协作看得见，让成果可验收' : 'Make collaboration visible. Make outcomes verifiable.'}</h2>
    <p class="ui-lead">{zh ? '让每一个企业，都拥有一支面向岗位、协同共生、持续进化的数字员工团队。' : 'A role-focused digital workforce that collaborates and evolves with every enterprise.'}</p>
    <div class="site-closing-actions">
      <a class="button" href={pathFor(locale, 'contact')}>
        {ui[locale].contact}
      </a>
      <a class="button button-white" href={appFor(locale)}>{ui[locale].try}</a>
    </div>
  </div>
</section>

<style>
  .site-closing {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-section);
    text-align: center;
  }

  .closing-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .closing-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }

  .closing-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--page-canvas) 0%, #060b121f 22%, #060b1214 70%, var(--page-canvas) 100%),
      radial-gradient(ellipse at 50% 42%, #060b127a 0%, #060b1240 46%, #060b1214 78%);
  }

  .closing-content {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  .closing-content :is(h2, p) { margin: 0; text-wrap: balance; }
  .closing-content h2 { max-width: var(--width-reading); }
  .site-closing-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (max-width: 600px) {
    .closing-backdrop img { object-position: 82% center; }
    .closing-backdrop::after {
      background:
        linear-gradient(180deg, var(--page-canvas), #060b1233 24%, #060b124d 78%, var(--page-canvas)),
        linear-gradient(#060b124d, #060b124d);
    }
  }

</style>
