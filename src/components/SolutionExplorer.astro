---
import { industries, homeIndustrySlugs } from '../data/industries';
import { homeIndustries } from '../data/home-industries';
import type { Locale } from '../data/types';
import { pathFor } from '../lib/site';
import Icon from './Icon.astro';
import SolutionPanelLayout from './SolutionPanelLayout.astro';
import '../styles/industry-tabs.css';
interface Props { locale: Locale; home?: boolean; }
const { locale, home = false } = Astro.props;
const zh = locale === 'zh';
const visibleIndustries = home ? homeIndustrySlugs.map(slug => industries[locale].find(item => item.slug === slug)!) : [...industries[locale]].sort((a, b) => a.slug === 'general' ? -1 : b.slug === 'general' ? 1 : 0);
const defaultSlug = home ? homeIndustrySlugs[0] : 'general';
const idPrefix = home ? 'home-solutions' : 'overview-solutions';
const PanelTitle = home ? 'h3' : 'h2';
const GroupTitle = home ? 'h4' : 'h3';
const BenefitTitle = home ? 'h5' : 'h4';
const industryIcons: Record<string, string> = {
  banking: 'bank', insurance: 'shield', securities: 'chart', trust: 'layers', government: 'landmark', 'state-owned': 'buildings', general: 'users',
};
const industryImages: Record<string, string> = {
  banking: '/images/industries/banking-architecture_V1.1.webp',
  insurance: '/images/industries/insurance-architecture_V1.1.webp',
  securities: '/images/industries/securities-architecture_V1.1.webp',
  trust: '/images/industries/trust-architecture_V1.0.webp',
  government: '/images/industries/government-architecture_V1.1.webp',
  'state-owned': '/images/industries/state-owned-architecture_V1.3.webp',
  general: '/images/solutions/general/general-hero_V2.0.webp',
};
const resultIcons: Record<string, string[]> = {
  banking: ['file-check', 'file-search', 'users'],
  insurance: ['clipboard-check', 'file-search', 'workflow'],
  securities: ['book', 'file-check', 'chart'],
  trust: ['file-search', 'clipboard-check', 'file-check'],
  government: ['file-search', 'folder', 'workflow'],
  'state-owned': ['chart', 'clipboard-check', 'workflow'],
};
const defaultIcons = ['users', 'book', 'chart'];
---
<div class="solution-explorer" data-layout={home ? 'home' : 'overview'} data-solution-explorer data-attribution-group="solutions">
  <div class="industry-navigation">
    {home && <h2 id="industry-title">{zh ? '行业解决方案' : 'Industry solutions'}</h2>}
    <div class="solution-tabs" role="tablist" aria-label={zh ? '行业解决方案' : 'Industry solutions'}>
      {visibleIndustries.map(industry => (
        <button type="button" role="tab" id={`${idPrefix}-tab-${industry.slug}`} aria-selected={industry.slug === defaultSlug} aria-controls={`${idPrefix}-panel-${industry.slug}`} tabindex={industry.slug === defaultSlug ? 0 : -1}>
          <Icon name={home ? industryIcons[industry.slug] : industry.icon} size={20}/>
          {zh ? industry.name.replace('解决方案', '') : industry.name}
        </button>
      ))}
    </div>
  </div>
  {visibleIndustries.map(industry => {
    const content = homeIndustries[locale][industry.slug];
    const panelId = `${idPrefix}-panel-${industry.slug}`;
    return (
    <div class="solution-panel" role="tabpanel" id={panelId} aria-labelledby={`${idPrefix}-tab-${industry.slug}`} tabindex="0" hidden={industry.slug !== defaultSlug}>
      <SolutionPanelLayout home={home}>
          <div class="explorer-scene" slot="scene">
            <img src={industryImages[industry.slug]} alt="" width="1200" height="800" loading="lazy" decoding="async"/>
            <div class="explorer-scene-copy">
              <PanelTitle>{content.title}</PanelTitle>
              <ul aria-label={zh ? '应用场景' : 'Use cases'}>
                {content.scenarios.map(scenario => <li>{scenario}</li>)}
              </ul>
            </div>
          </div>
          <section class="explorer-group" slot="context" aria-labelledby={`${panelId}-context`}>
            <GroupTitle id={`${panelId}-context`}>{zh ? '行业挑战' : 'Industry challenges'}</GroupTitle>
            <p>{content.pain}</p>
          </section>
          <section class="explorer-group" slot="work" aria-labelledby={`${panelId}-approach`}>
            <GroupTitle id={`${panelId}-approach`}>{zh ? '解决方案' : 'Our approach'}</GroupTitle>
            <p>{content.value}</p>
          </section>
          <section class="explorer-benefits explorer-group" slot="results" aria-labelledby={`${panelId}-benefits`}>
            <GroupTitle id={`${panelId}-benefits`}>{zh ? '业务价值' : 'Business value'}</GroupTitle>
            <ul>
              {content.benefits.map((benefit, index) => <li>
                <span class="explorer-benefit-icon"><Icon name={resultIcons[industry.slug]?.[index] ?? defaultIcons[index]} size={20}/></span>
                <div>
                  <BenefitTitle>{benefit.title}</BenefitTitle>
                  <p>{benefit.description}</p>
                </div>
              </li>)}
            </ul>
          </section>
          <a class="button button-outline industry-details-link" slot="action" href={pathFor(locale, `solutions/${industry.slug}`)}>{zh ? '查看行业方案' : 'View industry solution'}</a>
      </SolutionPanelLayout>
    </div>
    );
  })}
</div>
<script>
  import { onPageMount } from '../lib/page-lifecycle';
  onPageMount(signal => {
  document.querySelectorAll<HTMLElement>('[data-solution-explorer]').forEach(explorer=>{
    const tabs = [...explorer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...explorer.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = Math.max(0, tabs.findIndex(tab=>tab.getAttribute('aria-selected')==='true'));
    let panelAnimation: Animation | undefined;
    const select = (tab: HTMLButtonElement, direction?: number) => {
      const nextIndex = tabs.indexOf(tab);
      if (nextIndex === activeIndex) return;
      const slideDirection = direction ?? Math.sign(nextIndex - activeIndex);
      panelAnimation?.cancel();
      activeIndex = nextIndex;
      tabs.forEach(item=>{item.setAttribute('aria-selected',String(item === tab));item.tabIndex=item === tab ? 0 : -1;});
      panels.forEach(panel=>{panel.hidden=panel.id!==tab.getAttribute('aria-controls');});
      const strip = tab.parentElement!;
      const stripBounds = strip.getBoundingClientRect();
      const tabBounds = tab.getBoundingClientRect();
      if (tabBounds.left < stripBounds.left) strip.scrollLeft += tabBounds.left - stripBounds.left;
      if (tabBounds.right > stripBounds.right) strip.scrollLeft += tabBounds.right - stripBounds.right;
      const panel = panels.find(item=>!item.hidden);
      if (panel && !reducedMotion.matches) {
        panelAnimation = panel.animate([
          { opacity: .55, transform: `translateX(${slideDirection * 10}px)` },
          { opacity: 1, transform: 'translateX(0)' },
        ], { duration: 180, easing: 'ease-out' });
      }
    };
    tabs.forEach((tab,index)=>{
      tab.addEventListener('click',()=>select(tab),{ signal });
      tab.addEventListener('keydown',event=>{
        let next:number|undefined;
        if(event.key==='ArrowRight') next=(index+1)%tabs.length;
        if(event.key==='ArrowLeft') next=(index-1+tabs.length)%tabs.length;
        if(event.key==='Home') next=0;
        if(event.key==='End') next=tabs.length-1;
        if (next !== undefined) {
          event.preventDefault();
          const target = tabs[next];
          select(target, event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : undefined);
          target.focus({ preventScroll: true });
        }
      },{ signal });
    });
    signal.addEventListener('abort',()=>panelAnimation?.cancel(),{ once:true });
  });
  });
</script>
