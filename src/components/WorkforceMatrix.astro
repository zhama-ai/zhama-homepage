---
import type { Locale } from '../data/types';
import HomeSectionHeading from './home/HomeSectionHeading.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const domains = [
  {
    zh: '知识管理', en: 'Knowledge management',
    description: { zh: '归集资料、检索复用', en: 'Collect, search & reuse' },
  },
  {
    zh: '方案文书', en: 'Proposals & writing',
    description: { zh: '方案编制、文书起草', en: 'Proposals & document drafting' },
  },
  {
    zh: '经营分析', en: 'Business analysis',
    description: { zh: '分析指标、洞察趋势', en: 'Metrics and trends' },
  },
  {
    zh: '客户经营', en: 'Customer operations',
    description: { zh: '梳理商机、持续跟进', en: 'Opportunities & follow-up' },
  },
  {
    zh: '招投标协作', en: 'Bidding collaboration',
    description: { zh: '核对要求、协同编标', en: 'Check requirements & draft bids' },
  },
  {
    zh: '会议协同', en: 'Meeting collaboration',
    description: { zh: '提炼纪要、跟进行动', en: 'Minutes & action tracking' },
  },
  {
    zh: '项目协作', en: 'Project collaboration',
    description: { zh: '共享资料、协同交付', en: 'Shared files & joint delivery' },
  },
  {
    zh: '研究支持', en: 'Research support',
    description: { zh: '整理资料、支撑研究', en: 'Organize sources for research' },
  },
];
---
<section class="ui-section workforce-matrix" id="work-scenarios" aria-labelledby="domain-title">
  <div class="container matrix-section">
    <HomeSectionHeading id="domain-title">
      {zh ? '让数字员工融入业务作业体系' : 'Bring digital employees into your business workflows'}
      <Fragment slot="description">{zh ? '八大业务域，将智能能力沉淀为可复用的岗位能力矩阵，贯通全岗位业务流程' : 'Across eight business domains, turn intelligent capabilities into a reusable matrix of role capabilities and connect workflows across every role.'}</Fragment>
    </HomeSectionHeading>
    <div class="matrix-layout">
    <div class="matrix-art">
      <img
        src={`/images/workforce/workforce-matrix-${locale}_V3.4.webp`}
        width="3072" height="2048" loading="lazy" decoding="async"
        alt={zh
          ? '八大业务领域以平行堆叠的界面展开：知识管理、方案文书、经营分析、客户经营、招投标协作、会议协同、项目协作与研究支持。'
          : 'Eight business domains in parallel, layered panels: knowledge management, proposals and writing, business analysis, customer operations, bidding collaboration, meeting collaboration, project collaboration and research support.'}
      />
    </div>
      <ul class="matrix-domains" aria-label={zh ? '数字员工业务领域' : 'Digital employee business areas'}>
        {domains.map(domain => (
          <li>
            <h3>{zh ? domain.zh : domain.en}</h3>
            <p>{domain.description[locale]}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .matrix-section { display: grid; gap: var(--space-grid); }
  .matrix-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-grid);
  }
  .matrix-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio-editorial);
    object-fit: contain;
    border-radius: var(--radius-card);
  }
  .matrix-domains {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .matrix-domains h3 {
    margin: 0;
    font-size: var(--type-body);
    font-weight: 600;
    line-height: var(--leading-heading);
    letter-spacing: 0;
  }
  .matrix-domains p {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--type-meta);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .matrix-layout { grid-template-columns: minmax(0, 1fr); }
  }
</style>
