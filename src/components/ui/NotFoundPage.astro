---
import type { Locale } from '../../data/types';
import { pathFor } from '../../lib/site';
import PageIntro from './PageIntro.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
---
<div class="not-found">
  <PageIntro
    title={zh ? '这个页面已不在这里。' : 'This page is no longer here.'}
    description={zh ? '从官网首页继续查找产品、文档和下载资源。' : 'Continue from the homepage to find products, documentation and downloads.'}
  >
    <a class="button" href={pathFor(locale)}>{zh ? '返回首页' : 'Back to home'}</a>
  </PageIntro>
</div>

<style>
  .not-found { padding-bottom: calc(var(--space-section) / 2); }
</style>
