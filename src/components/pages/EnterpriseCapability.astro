---
import Diagram from '../product/CapabilityDiagram.astro';
import CapabilityBreadcrumb from '../product/CapabilityBreadcrumb.astro';
import CapabilityHero from '../product/CapabilityHero.astro';
import CapabilityStory from '../product/CapabilityStory.astro';
import IntegrationsBackdrop from '../product/IntegrationsBackdrop_V1.0.astro';
import type { Locale } from '../../data/types';
import type { CapabilityModule } from '../../features/product/types';
import type { LandingCopy } from '../../features/product/landing-types';
import { productExperiences } from '../../features/product/experiences';
import '../../styles/enterprise-capability.css';
interface Props { locale: Locale; capability: CapabilityModule; copy: LandingCopy; }
const { locale, capability, copy } = Astro.props;
const experience = productExperiences[capability.slug][locale];
---
<div class="capability-product" data-capability={capability.slug}>
  <CapabilityHero locale={locale} copy={copy.hero} fieldClass="cp-hero-field">
    <Fragment slot="backdrop">{capability.slug === 'integrations' && <IntegrationsBackdrop locale={locale}/>}</Fragment>
    <Diagram locale={locale} capability={capability.slug}/>
  </CapabilityHero>
  <div class="container">
    {experience.sections.map((section, index) => (
      <CapabilityStory id={section.id} title={section.title} body={section.body} points={section.points} reverse={index % 2 === 1}>
        <Diagram locale={locale} capability={capability.slug} scene={index}/>
      </CapabilityStory>
    ))}
  </div>
</div>
<CapabilityBreadcrumb locale={locale} slug={capability.slug} name={capability.copy[locale].name}/>
