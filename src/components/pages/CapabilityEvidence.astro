---
import type { Locale } from '../../data/types';
import { capabilityVisuals } from '../../features/product/visuals';
import '../../styles/capability-evidence.css';

interface Props { slug: string; locale: Locale; }
const { slug, locale } = Astro.props;
const visual = capabilityVisuals[slug];
if (!visual) throw new Error(`Missing capability illustration: ${slug}`);
---
<figure class="capability-artwork">
  <picture>
    <source
      media="(max-width: 760px)"
      srcset={visual.mobile.src[locale]}
      width={visual.mobile.width}
      height={visual.mobile.height}
      sizes="calc(100vw - 10px)"
    />
    <img
    src={visual.src[locale]}
    width={visual.width}
    height={visual.height}
    alt={visual.alt[locale]}
    sizes="(max-width: 760px) calc(100vw - 10px), (max-width: 1100px) 60vw, 750px"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    />
  </picture>
</figure>
