---
import type { contactContent } from '../features/contact/content';
interface Props { copy: typeof contactContent.zh.form.expectedReplyTime; }
const { copy } = Astro.props;
---
<div class="field reply-time-controls">
  <label for="enquiry-reply-trigger">{copy.label}</label>
  <input type="hidden" id="enquiry-reply-time" name="expectedReplyTime" />
  <div class="reply-time-field">
    <button id="enquiry-reply-trigger" class="reply-time-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="enquiry-calendar" aria-describedby="enquiry-reply-value">
      <span id="enquiry-reply-value" class="reply-time-value">{copy.defaultValue}</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>
    </button>
    <button class="reply-time-clear" type="button" aria-label={copy.clear} hidden><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </div>
  <div id="enquiry-calendar" class="reply-calendar" popover="auto" role="dialog" aria-label={copy.label} hidden>
    <div class="reply-calendar-heading">
      <button type="button" class="reply-month-previous" aria-label={copy.previousMonth}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 7-5 5 5 5"/></svg></button>
      <span id="enquiry-calendar-month" aria-live="polite"></span>
      <button type="button" class="reply-month-next" aria-label={copy.nextMonth}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 7 5 5-5 5"/></svg></button>
    </div>
    <table role="grid" aria-labelledby="enquiry-calendar-month"><thead><tr class="reply-weekdays"></tr></thead><tbody class="reply-days"></tbody></table>
    <div class="reply-period" role="group" aria-label={copy.period}>
      <label class="reply-period-option"><input type="radio" name="replyPeriod" value="morning" checked /><span>{copy.morning}</span></label>
      <label class="reply-period-option"><input type="radio" name="replyPeriod" value="afternoon" /><span>{copy.afternoon}</span></label>
    </div>
    <div class="reply-calendar-actions"><button type="button" class="reply-calendar-reset">{copy.defaultValue}</button><button type="button" class="button button-small reply-calendar-done">{copy.done}</button></div>
  </div>
</div>
<style>
  .reply-time-field { position: relative; }
  .reply-time-trigger { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; min-height: 52px; padding: 13px 16px 13px 14px; border: 1px solid rgb(255 255 255 / 20%); border-radius: 7px; background: #111; color: var(--ink); font: inherit; font-size: 14px; text-align: left; cursor: pointer; }
  .reply-time-trigger svg { flex: 0 0 auto; color: var(--muted); }
  .reply-time-value { padding-right: 24px; }
  .reply-time-trigger:focus-visible, .reply-time-clear:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .reply-time-clear { position: absolute; right: 40px; top: 50%; transform: translateY(-50%); display: grid; place-items: center; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; }
  .reply-time-clear[hidden], .reply-calendar[hidden] { display: none; }
  .reply-calendar { position: fixed; inset: auto; z-index: 100; width: min(332px, calc(100vw - 32px)); max-height: calc(100dvh - 24px); overflow: auto; margin: 0; padding: 16px; border: 1px solid rgb(255 255 255 / 16%); border-radius: 12px; background: #191c22; color: var(--ink); box-shadow: 0 16px 48px rgb(0 0 0 / 40%); }
  .reply-calendar-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; font-size: 14px; font-weight: 600; }
  .reply-calendar-heading button { display: grid; place-items: center; width: 30px; height: 30px; padding: 0; border: 0; border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; }
  .reply-calendar :global(table) { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 2px; margin: 0; }
  .reply-calendar :global(th) { height: 28px; padding: 0; color: var(--muted); font-size: 11px; font-weight: 400; text-align: center; }
  .reply-calendar :global(td) { height: 34px; padding: 0; border: 0; text-align: center; }
  .reply-calendar :global(.reply-day) { width: 100%; height: 34px; padding: 0; border: 1px solid transparent; border-radius: 7px; background: transparent; color: var(--ink); font: inherit; font-size: 12px; cursor: pointer; }
  .reply-calendar :global(.reply-day[data-outside]) { color: #69717d; }
  .reply-calendar :global(.reply-day[aria-current="date"]) { border-color: rgb(255 255 255 / 28%); }
  .reply-calendar :global(.reply-day.is-selected) { background: var(--accent); color: white; }
  .reply-calendar :global(.reply-day:hover:not(.is-selected)), .reply-calendar-heading button:hover { background: rgb(255 255 255 / 7%); color: var(--ink); }
  .reply-calendar :global(button:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .reply-period { display: flex; gap: 6px; margin-top: 14px; padding: 3px; border-radius: 8px; background: rgb(0 0 0 / 20%); }
  .reply-period .reply-period-option { position: relative; flex: 1; margin: 0; cursor: pointer; }
  .reply-period-option input { position: absolute; opacity: 0; width: 1px; height: 1px; min-height: 0; padding: 0; border: 0; }
  .reply-period-option span { display: block; padding: 8px; border: 1px solid transparent; border-radius: 6px; color: var(--muted); font-size: 12px; font-weight: 400; text-align: center; }
  .reply-period-option input:checked + span { color: var(--ink); border-color: rgb(255 255 255 / 12%); background: #303744; }
  .reply-period-option input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .reply-calendar-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 14px; }
  .reply-calendar-reset { padding: 6px 0; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 12px; cursor: pointer; }
  .reply-calendar-reset:hover, .reply-time-clear:hover { color: var(--ink); }
  .reply-calendar-done { min-height: 32px; padding: 6px 16px; font-size: 12px; }
</style>
