---
import Brand from '../Brand.astro';
import Icon from '../Icon.astro';
import { navigationEntriesFor } from './entries';
import type { Locale } from '../../data/types';
import { site, pathFor, ui } from '../../lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = ui[locale];
const entries = navigationEntriesFor(locale);
const footerGroups = [
  {
    path: 'product',
    label: t.product,
    links: [
      ...entries.products.map(entry => ({ label: entry.label, href: pathFor(locale, entry.path), external: false })),
      { label: zh ? '私有化部署' : 'Private deployment', href: pathFor(locale, 'enterprise'), external: false },
    ],
  },
  {
    path: 'solutions',
    label: t.solutions,
    links: entries.solutions.map(entry => ({ label: entry.label, href: pathFor(locale, entry.path), external: false })),
  },
  { path: 'resources', label: t.resources, links: entries.resources },
];
const contactCodes = [
  {
    src: '/images/contact/wechat-community_V1.0.png',
    size: 396,
    label: zh ? '加入交流群' : 'Join our WeChat group',
    alt: zh ? '微信交流群二维码' : 'QR code to join our WeChat group',
  },
  {
    src: '/images/contact/wechat-official-account_V1.0.jpg',
    size: 1280,
    label: zh ? '关注我们' : 'Follow us',
    alt: zh ? '微信公众号二维码' : 'QR code to follow our WeChat official account',
  },
];
---

<footer class="site-footer tego-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={pathFor(locale)}><Brand locale={locale}/></a>
      <p>{zh ? 'TeGo 数字员工协作平台' : 'TeGo Digital Employee Collaboration Platform'}</p>
      <div class="footer-contact-codes">
        {contactCodes.map((code, index) => (
          <figure class="footer-contact-code">
            <button
              type="button"
              class="footer-qr-image"
              aria-label={zh ? `放大预览：${code.label}` : `Enlarge: ${code.label}`}
              aria-haspopup="dialog"
              aria-controls={`footer-qr-preview-${index}`}
              data-qr-preview={`footer-qr-preview-${index}`}
            >
              <img src={code.src} alt={code.alt} width={code.size} height={code.size} loading="lazy" decoding="async" />
            </button>
            <figcaption>{code.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
    {footerGroups.map(group => (
      <div class="footer-link-group">
        <h2><a href={pathFor(locale, group.path)}>{group.label}</a></h2>
        <ul>
          {group.links.map(entry => <li><a href={entry.href} hreflang={entry.external ? 'zh-CN' : undefined} rel={entry.external ? 'external' : undefined}>{entry.label}</a></li>)}
        </ul>
      </div>
    ))}
    <div class="footer-contact">
      <h2>{zh ? '联系我们' : 'Contact us'}</h2>
      <div class="footer-contact-details" style={{ '--contact-label-width': zh ? '3em' : '4.5em' }}>
        <address class="footer-contact-entry footer-contact-field">
          <span class="footer-contact-label">{zh ? '地址：' : 'Address:'}</span>
          <span class="footer-contact-value">{zh ? '深圳市福田区福田中心区深南路4009号华融大厦' : 'Huarong Building, No. 4009 Shennan Road, Futian Central Area, Futian District, Shenzhen'}</span>
        </address>
        <a class="footer-contact-entry footer-contact-field footer-contact-email" href={`mailto:${site.email}`}>
          <span class="footer-contact-label">{zh ? '邮箱：' : 'Email:'}</span>
          <span class="footer-contact-value">{site.email}</span>
        </a>
        <a class="footer-contact-entry" href={pathFor(locale, 'contact')}>{zh ? '联系我们' : 'Contact us'}</a>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>{zh ? '© 2026 深圳市扎马星辰科技有限公司' : '© 2026 Shenzhen Zhama Xingchen Technology Co., Ltd.'}</span>
    <a href="https://beian.miit.gov.cn/" rel="external" lang="zh-CN">粤ICP备2025426259号-1</a>
    <a href={pathFor(locale, 'privacy')}>{t.privacy}</a>
    <a href={pathFor(locale, 'terms')}>{t.terms}</a>
    <button type="button" class="footer-analytics-preferences" data-analytics-preferences aria-controls="analytics-consent" aria-expanded="false">{zh ? '访问统计设置' : 'Analytics preferences'}</button>
  </div>
</footer>

{contactCodes.map((code, index) => (
  <dialog class="footer-qr-preview" id={`footer-qr-preview-${index}`} aria-labelledby={`footer-qr-title-${index}`}>
    <div class="footer-qr-preview-header">
      <h2 id={`footer-qr-title-${index}`}>{code.label}</h2>
      <button type="button" class="footer-qr-close" aria-label={zh ? '关闭预览' : 'Close preview'} data-qr-close autofocus>
        <Icon name="close" size={22}/>
      </button>
    </div>
    <img src={code.src} alt={code.alt} width={code.size} height={code.size} loading="lazy" decoding="async" />
  </dialog>
))}

<script>
  import { onPageMount } from '../../lib/page-lifecycle';

  onPageMount(signal => document.querySelectorAll<HTMLButtonElement>('[data-qr-preview]').forEach(trigger => {
    const dialog = document.getElementById(trigger.dataset.qrPreview || '');
    if (!(dialog instanceof HTMLDialogElement)) return;

    trigger.addEventListener('click', () => dialog.showModal(), { signal });
    dialog.querySelector('[data-qr-close]')?.addEventListener('click', () => dialog.close(), { signal });
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
        dialog.close();
      }
    }, { signal });
    dialog.addEventListener('close', () => trigger.focus({ preventScroll: true }), { signal });
  }));
</script>

<style>
  .tego-footer { padding-block: var(--space-section) var(--space-6); background: var(--page-canvas); }
  .tego-footer .footer-grid {
    display: grid;
    grid-template-columns: minmax(210px, 1.35fr) repeat(3, minmax(0, 1fr)) minmax(180px, 1.2fr);
    gap: var(--space-grid);
  }
  .tego-footer :global(.footer-brand .official-wordmark) { display: block; width: 172px; max-width: 100%; height: auto; }
  .tego-footer .footer-brand > p {
    margin: var(--space-4) 0 0;
    color: var(--muted);
    font-size: var(--type-ui);
    line-height: var(--leading-body);
  }
  .tego-footer .footer-grid h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--type-body);
    font-weight: 600;
    line-height: var(--leading-heading);
    letter-spacing: 0;
  }
  .footer-link-group ul,
  .footer-contact-details {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-link-group li > a,
  .footer-contact-details,
  .footer-bottom {
    color: var(--muted);
    font-size: var(--type-meta);
    line-height: var(--leading-body);
  }
  .footer-contact-field {
    display: grid;
    grid-template-columns: var(--contact-label-width) minmax(0, 1fr);
    column-gap: var(--space-1);
    align-items: start;
    font-style: normal;
  }
  .footer-contact-value { min-width: 0; overflow-wrap: anywhere; }
  .tego-footer .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-8);
  }
  .tego-footer a:is(:hover, :focus-visible),
  .tego-footer .footer-analytics-preferences:is(:hover, :focus-visible) { color: var(--accent); }
  .tego-footer :is(a, button):focus-visible { outline: 2px solid var(--accent); outline-offset: var(--space-1); }

  .footer-contact-codes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 104px));
    gap: var(--space-3);
    width: min(100%, 220px);
    margin-top: var(--space-5);
  }

  .footer-contact-code {
    min-width: 0;
    margin: 0;
    text-align: center;
  }

  .footer-qr-image {
    display: block;
    width: 100%;
    padding: var(--space-1);
    background: #fff;
    border: 0;
    border-radius: var(--radius-card);
    aspect-ratio: 1;
    cursor: zoom-in;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .footer-qr-image:focus-visible {
    outline: 2px solid #8acfff;
    outline-offset: 4px;
    transform: scale(1.08);
    box-shadow: 0 0 24px #329aff66;
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-contact-code:hover .footer-qr-image {
      transform: scale(1.08);
      box-shadow: 0 0 0 2px #8acfff, 0 0 24px #329aff66;
    }

    .footer-contact-code:hover figcaption { color: #e3f4ff; }
  }

  .footer-qr-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .footer-contact-code figcaption {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--type-meta);
    line-height: var(--leading-body);
    transition: color .2s ease;
  }

  .footer-contact-code:focus-within figcaption { color: #e3f4ff; }

  :global(html:has(.footer-qr-preview[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .footer-qr-preview {
    width: min(440px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: var(--space-card);
    color: #eff8ff;
    background: #0c1928;
    border: 1px solid #9acbff38;
    border-radius: var(--radius-card);
    box-shadow: 0 24px 90px #0009;
  }

  .footer-qr-preview[open] { display: grid; gap: var(--space-5); }

  .footer-qr-preview::backdrop {
    background: #010813d9;
    backdrop-filter: blur(6px);
  }

  .footer-qr-preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .footer-qr-preview h2 { font-size: var(--type-card); font-weight: 600; line-height: var(--leading-heading); }

  .footer-qr-close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    padding: 0;
    color: #bcd2e8;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 50%;
  }

  .footer-qr-close:is(:hover, :focus-visible) { color: #fff; background: #8acfff1a; }
  .footer-qr-close:focus-visible { outline: 2px solid #8acfff; outline-offset: 2px; }

  .footer-qr-preview > img {
    display: block;
    width: min(100%, calc(100dvh - 180px));
    height: auto;
    aspect-ratio: 1;
    margin-inline: auto;
    padding: var(--space-3);
    background: #fff;
    border-radius: var(--radius-card);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-qr-image { transform: none !important; }
  }

  @media (max-width: 1000px) {
    .tego-footer .footer-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tego-footer .footer-contact { grid-column: span 2; }
  }
  @media (max-width: 650px) {
    .tego-footer .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tego-footer .footer-brand { grid-column: 1 / -1; }
    .tego-footer .footer-contact { grid-column: auto; }
  }
  @media (max-width: 440px) {
    .tego-footer .footer-contact { grid-column: 1 / -1; }
  }
</style>
