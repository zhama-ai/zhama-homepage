---
import Icon from './Icon.astro';
import type { Locale } from '../data/types';
export type InterfaceScene = 'workforce'|'knowledge'|'skills'|'document'|'integrations'|'audit'|'access'|'operations';
interface Props { scene: InterfaceScene; locale: Locale; class?: string; }
const {scene,locale,class:className}=Astro.props;
const zh=locale==='zh';
const names={workforce:zh?'数字员工团队':'Your digital workforce',knowledge:zh?'企业知识工作台':'Enterprise knowledge',skills:zh?'企业岗位技能库':'Reusable role skills',document:zh?'项目成果协作':'Review project deliverables',integrations:zh?'企业能力连接':'Connect enterprise capabilities',audit:zh?'任务执行追踪':'Follow the execution',access:zh?'团队权限管理':'Team access management',operations:zh?'数字员工运营':'Digital workforce operations'};
const title=names[scene];
const people=zh?[
 ['file','标书编制专员','拆解采购要求 · 组织响应材料',['响应编制','资料核对']],
 ['chart','客户经营助理','梳理客户需求 · 准备沟通方案',['客户资料','商机跟进']],
 ['book','制度知识助理','查询有效条款 · 回溯原文依据',['制度检索','原文引用']],
 ['chart','财务对账助理','归集业务数据 · 定位账目差异',['明细核对','差异清单']],
 ['message','会议行动助理','整理讨论结论 · 接续待办事项',['会议纪要','行动跟进']],
 ['file','科研资料助理','检索授权文献 · 编写综述初稿',['文献整理','引用核对']],
]:[
 ['file','Bid specialist','Tender analysis · Proposal writing',['Requirements','Responses']],
 ['chart','Sales assistant','Customer records · Follow-ups',['Customer context','Follow-up']],
 ['book','Policy assistant','Policies · Source references',['Knowledge','References']],
 ['chart','Finance assistant','Reconciliation · Review',['Data','Differences']],
 ['message','Meeting assistant','Minutes · Action tracking',['Minutes','Follow-up']],
 ['file','Research assistant','Literature · Review drafts',['Literature','Citations']],
];
const skills=zh?[
 ['book','招标文件分析','采购要求 · 条款与材料'],['file','会议事项整理','业务结构 · 内容与交付'],['message','会议纪要整理','讨论结论 · 行动项清单'],['book','制度知识检索','有效条款 · 原文引用'],['chart','数据核对与汇总','口径整理 · 差异定位'],['clock','周期报告编写','指定资料 · 周期性跟进'],
]:[['book','Tender analysis','Requirements and materials'],['file','Meeting action summary','Structure and deliverables'],['message','Meeting minutes','Decisions and actions'],['book','Policy retrieval','Rules and citations'],['chart','Data review','Reconciliation and differences'],['clock','Recurring reports','Source-based reporting']];
const folders=zh?['企业制度','岗位知识','产品与方案','项目资料']:['Policies','Role knowledge','Products & proposals','Project files'];
const files=zh?[
 ['PDF','产品能力与应用说明.pdf','产品知识'],['DOCX','客户沟通常见问题与应答.docx','岗位方法'],['PDF','企业部署与交付规范.pdf','交付依据'],['MD','行业方案与项目经验.md','历史方案'],
]:[['PDF','Product capabilities.pdf','Product knowledge'],['DOCX','Customer questions and answers.docx','Role methods'],['PDF','Deployment and delivery standards.pdf','Delivery sources'],['MD','Industry proposals and experience.md','Prior proposals']];
const tabs=scene==='audit'?(zh?['概览','任务','溯源','按员工','配置变更']:['Overview','Tasks','Sources','Employees','Changes']):scene==='knowledge'?(zh?['知识库','全局搜索','知识任务']:['Libraries','Search','Knowledge tasks']):scene==='integrations'?(zh?['内置 MCP','外部 MCP']:['Built-in MCP','External MCP']):scene==='skills'?(zh?['全部技能','已具备','我的创建']:['All skills','Available','Created by me']):scene==='workforce'?(zh?['全部','我创建的','团队共享','公司共享']:['All','Created by me','Team','Company']):[];
const alt=title;
---
<figure class:list={['product-interface',`interface-${scene}`,className]} data-product-interface={scene}>
 <div class="ui-window" role="img" aria-label={alt}>
  <div class="ui-window-bar" aria-hidden="true"><span class="ui-app-mark"><Icon name="layers" size={14}/>TeGo</span><span>{title}</span><span class="ui-window-controls"><i></i><i></i><i></i></span></div>
  <div class="ui-app" aria-hidden="true">
   <div class="ui-rail"><span class="ui-rail-logo"><Icon name="layers" size={20}/></span>{['message','folder','file','book','network','plug','shield'].map((icon,index)=><span class:list={['ui-rail-item',{'selected':(scene==='knowledge'?3:scene==='workforce'?4:scene==='integrations'?5:scene==='audit'||scene==='access'?6:2)===index}]}><Icon name={icon} size={17}/></span>)}<span class="ui-rail-bottom">T</span></div>
   <div class="ui-main">
    <div class="ui-page-top"><div><strong>{title}</strong><span>{scene==='workforce'?(zh?'把岗位职责，变成可以交办的工作能力':'The right capabilities for your team'):scene==='knowledge'?(zh?'检索已有资料，回答带上原文依据':'Find materials and cite the original source'):scene==='skills'?(zh?'成熟的业务方法，供不同岗位持续调用':'Reusable capabilities for digital employees'):scene==='integrations'?(zh?'知识、工具与系统，在授权范围内协同':'Knowledge, tools and systems within authorized scope'):scene==='audit'?(zh?'从资料使用到工具调用，沿任务查看过程':'Review execution by task'):scene==='access'?(zh?'按组织与岗位，分配访问和执行范围':'Assign access and execution by role'):scene==='operations'?(zh?'AI 用量 · 采用与互动 · 知识与技能':'AI usage · Adoption · Knowledge'):zh?'围绕同一份成果，讨论、修改与交付':'Review, edit and deliver'}</span></div><span class="ui-primary">{scene==='workforce'?(zh?'+ 配置岗位':'+ Configure role'):scene==='knowledge'?(zh?'导入企业资料':'Import company materials'):scene==='integrations'?(zh?'+ 连接能力':'+ Connect capability'):scene==='access'?(zh?'+ 新建用户':'+ New user'):scene==='audit'?(zh?'查看执行证据':'View execution evidence'):scene==='document'?(zh?'待审阅':'Awaiting review'):scene==='operations'?'2026/11/06 — 11/13':zh?'岗位能力':'Capabilities'}</span></div>
    {tabs.length>0&&<div class="ui-tabs">{tabs.map((tab,index)=><span class:list={{active:index===0}}>{tab}</span>)}</div>}
    {scene==='workforce'&&<div class="ui-workforce-layout"><div class="ui-employee-grid">{people.map(([icon,name,description,tags],index)=><div class="ui-employee-card"><div class="ui-employee-heading"><span class:list={['ui-role-icon',`tone-${index%3}`]}><Icon name={icon as string} size={21}/></span><div><strong>{name}</strong><span><i class="ui-status-dot"></i>{zh?'可交办工作':'Ready'}</span></div></div><p>{description}</p><div class="ui-chips">{(tags as string[]).map(tag=><span>{tag}</span>)}</div></div>)}</div><aside class="ui-deliverable-peek"><div class="ui-peek-label"><Icon name="file" size={14}/>{zh?'从任务到成果':'Deliverable'}</div><div class="ui-paper"><span class="ui-paper-kicker">TeGo / WORKSPACE</span><strong>{zh?'数字员工\n建设与实施方案':'Digital workforce\nImplementation proposal'}</strong><p>{zh?'业务目标与实施路径':'Business goals and delivery plan'}</p><div class="ui-paper-block"><Icon name="network" size={36}/></div><p>{zh?'资料 · 协作 · 执行 · 交付':'Sources · Work · Delivery'}</p></div><div class="ui-peek-types"><span>PDF</span><span>Word</span><span>Excel</span><span>PPT</span></div></aside></div>}
    {scene==='knowledge'&&<div class="ui-knowledge-layout"><aside class="ui-library-list">{folders.map((folder,index)=><span class:list={{selected:index===2}}><Icon name="book" size={14}/>{folder}</span>)}</aside><div class="ui-file-area"><div class="ui-file-toolbar"><strong>{zh?'产品与方案知识库':'Product and proposal knowledge'}</strong><span><Icon name="network" size={13}/>{zh?'成员':'Members'}<Icon name="layers" size={13}/></span></div><div class="ui-file-list">{files.map(([type,name,category])=><div class="ui-file-row"><span class="ui-file-type">{type}</span><span><strong>{name}</strong><small>{category}</small></span><Icon name="download" size={14}/></div>)}</div><div class="ui-knowledge-note"><Icon name="key" size={14}/>{zh?'资料按授权使用，回答保留原文引用':'Use authorized sources with original references'}</div></div></div>}
    {scene==='skills'&&<><div class="ui-category-row">{(zh?['文档编制','数据处理','知识检索','业务支持']:['Documents','Data','Knowledge','Business']).map((name,index)=><span class:list={{active:index===0}}>{name}</span>)}</div><div class="ui-skills-grid">{skills.map(([icon,name,category])=><div class="ui-skill-card"><span class="ui-role-icon"><Icon name={icon} size={19}/></span><strong>{name}</strong><p>{category}</p><div><span>{zh?'岗位方法':'Role method'}</span></div></div>)}</div></>}
    {scene==='document'&&<div class="ui-editor-layout"><aside class="ui-document-sidebar"><span><Icon name="folder" size={14}/>{zh?'项目文件':'Project files'}</span><span class="selected">{zh?'数字员工建设方案.docx':'Digital workforce proposal.docx'}</span><span>{zh?'项目需求与业务范围.md':'Project requirements.md'}</span><span>{zh?'资料与交付清单.xlsx':'Delivery checklist.xlsx'}</span></aside><div class="ui-document-main"><div class="ui-editor-tools">{(zh?['开始','注释','编辑','页面','视图']:['Home','Comment','Edit','Page','View']).map((label,index)=><span class:list={{active:index===1}}>{label}</span>)}<Icon name="download" size={13}/></div><div class="ui-preview-paper"><span class="ui-paper-kicker">TeGo / INDUSTRY SOLUTIONS</span><strong>{zh?'企业数字员工\n建设与实施方案':'Bring digital employees\ninto business workflows'}</strong><p>{zh?'明确岗位任务，组织资料与能力，规划交付路径。':'Connect roles, knowledge, tools and collaboration.'}</p><div class="ui-document-cards">{(zh?['需求分析','岗位设计','交付计划']:['Requirements','Role design','Delivery plan']).map((label,index)=><div><Icon name={['book','plug','file'][index]} size={18}/><span>{label}</span></div>)}</div></div></div></div>}
    {scene==='integrations'&&<div class="ui-service-table"><div class="ui-service-row header"><span>{zh?'名称':'Name'}</span><span>{zh?'分类':'Category'}</span><span>{zh?'状态':'Status'}</span></div>{[[zh?'企业知识检索':'Knowledge retrieval',zh?'检索已授权资料，保留原文依据':'Authorized materials with source references',zh?'知识服务':'Knowledge'],[zh?'产品资料引用':'Product references',zh?'把产品说明与方案材料带入工作':'Use product guides and proposal materials',zh?'资料服务':'Materials'],[zh?'岗位方法检索':'Role knowledge',zh?'查找岗位规则与工作方法':'Find role rules and working methods',zh?'知识服务':'Knowledge']].map(([name,description,category])=><div class="ui-service-row"><span><span class="ui-service-name"><Icon name="plug" size={15}/><strong>{name}</strong></span><small>{description}</small></span><span class="ui-service-category">{category}</span><span class="ui-service-status"><i class="ui-status-dot"></i>{zh?'平台提供':'Platform service'}</span></div>)}<div class="ui-connector-strip"><span>MCP</span><Icon name="arrow" size={15}/><strong>TeGo</strong><Icon name="arrow" size={15}/><span>OpenAPI</span></div></div>}
    {scene==='audit'&&<div class="ui-audit-layout"><div class="ui-audit-tasks"><span class="ui-mini-heading">{zh?'任务':'Tasks'}</span>{[zh?'行业方案资料研究':'Industry proposal research',zh?'客户方案准备':'Customer proposal preparation',zh?'会议事项整理':'Meeting action summary'].map((name,index)=><div class:list={{selected:index===0}}><Icon name="file" size={15}/><span><strong>{name}</strong></span></div>)}</div><div class="ui-audit-detail"><div class="ui-detail-heading"><strong>{zh?'行业方案 · 执行过程':'Industry proposal · Execution'}</strong><span>{zh?'溯源':'Sources'}</span></div><ol class="ui-timeline">{(zh?['接收方案任务','检索产品资料','调用编制技能','整理项目成果']:['Receive proposal task','Research product materials','Apply proposal skill','Organize deliverables']).map((step,index)=><li><span><Icon name={['clock','book','plug','file'][index]} size={14}/></span><div><strong>{step}</strong><small>{[zh?'确认目标与本次资料范围':'Confirm the goal and source scope',zh?'保留所使用的原文依据':'Retain the original source evidence',zh?'按岗位方法组织方案结构':'Structure the proposal using role methods',zh?'关联输出文件与运行记录':'Link output files and run records'][index]}</small></div><Icon name="key" size={12}/></li>)}</ol></div></div>}
    {scene==='access'&&<div class="ui-access-layout"><aside class="ui-admin-menu">{(zh?['用户管理','组织管理','角色管理','授权管理','认证设置']:['Users','Organization','Roles','Authorization','Authentication']).map((name,index)=><span class:list={{selected:index===0}}><Icon name={['network','folder','shield','key','layers'][index]} size={14}/>{name}</span>)}</aside><div class="ui-access-main"><div class="ui-access-filters"><Icon name="search" size={14}/><span>{zh?'搜索用户名、邮箱、姓名':'Search users'}</span><span>{zh?'全部角色':'All roles'}</span></div><div class="ui-access-row header"><span>{zh?'用户':'User'}</span><span>{zh?'角色':'Role'}</span><span>{zh?'状态':'Status'}</span></div>{(zh?['林嘉宁','陈知远','周明澈']:['Jianing Lin','Zhiyuan Chen','Mingche Zhou']).map((name,index)=><div class="ui-access-row"><span class="ui-account"><span class="ui-account-mark"><Icon name="network" size={15}/></span><strong>{name}</strong></span><span>{index===2?(zh?'管理员':'Admin'):(zh?'普通用户':'Member')}</span><span class="ui-service-status"><i class="ui-status-dot"></i>{zh?'已启用':'Enabled'}</span></div>)}</div></div>}
    {scene==='operations'&&<div class="ui-operations">
     <div class="ui-operation-metrics">{(zh?[
      ['network','启用数字员工','13','位'],['book','知识文档','113','份'],['layers','已安装技能种类','376','种'],['plug','工具调用','3,119','次']
     ]:[['network','Enabled employees','13',''],['book','Knowledge documents','113',''],['layers','Installed skills','376',''],['plug','Tool calls','3,119','']]).map(([icon,label,value,unit])=><div><span class="ui-metric-label"><Icon name={icon} size={15}/>{label}</span><strong class="ui-metric-value">{value}<small>{unit}</small></strong></div>)}</div>
     <div class="ui-operation-detail"><div class="ui-tool-chart"><div class="ui-chart-heading"><strong>{zh?'高频执行动作':'Frequent tool calls'}</strong><span>{zh?'调用次数':'Calls'}</span></div><div class="ui-tool-bars">{[[zh?'任务执行':'Execution',981],[zh?'工具协同':'Tool calls',700],[zh?'文件读取':'Read files',330],[zh?'网页取材':'Web sources',204],[zh?'能力检索':'Tool discovery',98]].map(([name,count])=><div class="ui-tool-bar"><span>{name}</span><div><i style={`width:${Number(count)/1000*100}%`}></i></div><strong>{Number(count).toLocaleString('en-US')}</strong></div>)}</div><div class="ui-chart-axis"><span>0</span><span>500</span><span>1,000</span></div></div><div class="ui-usage-summary"><span class="ui-mini-heading">{zh?'模型使用概况':'AI usage'}</span><span>{zh?'模型处理 Token':'Total tokens'}</span><strong>{zh?'7,571.2':'75.712'}<small>{zh?'万':'M'}</small></strong><div><span>{zh?'计量事件':'Metering events'}</span><strong>2,057</strong></div><div class="ui-usage-categories">{(zh?['采用与互动','能力与质量','知识与技能']:['Adoption','Quality','Knowledge']).map(label=><span>{label}</span>)}</div></div></div>
    </div>}
   </div>
  </div>
 </div>
</figure>
