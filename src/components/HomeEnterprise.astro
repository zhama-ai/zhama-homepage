---
import type { Locale } from '../data/types';
import Icon from './Icon.astro';
import HomeSectionHeading from './home/HomeSectionHeading.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const networkIllustration = `/images/enterprise/home-enterprise-network-${locale}`;
const networkVersion = 'V12.10';
const deployment = [
  { icon: 'buildings', text: zh ? '企业环境' : 'Your infrastructure' },
  { icon: 'cpu', text: zh ? '本地模型' : 'Local models' },
  { icon: 'layers', text: zh ? '容器化部署' : 'Containerized deployment' },
];
const governance = [
  { icon: 'users', text: zh ? '组织身份' : 'Organizational identity' },
  { icon: 'key-round', text: zh ? '资源与委托' : 'Access & delegation' },
  { icon: 'file-check', text: zh ? '审核与记录' : 'Reviews & records' },
];
---

<section class="ui-section home-enterprise" id="enterprise-control" aria-labelledby="enterprise-control-title">
  <div class="container enterprise-section">
    <HomeSectionHeading id="enterprise-control-title">
      {zh
        ? '按企业边界部署，按组织规则运行'
        : 'Deploy within your boundaries. Follow your organization’s rules.'}
      <Fragment slot="description">{zh
        ? '私有化部署，数据不出域，全程可审计'
        : 'Private deployment. Data stays within your boundary. Auditable from start to finish.'}</Fragment>
    </HomeSectionHeading>

    <div class="enterprise-layout">
      <div class="enterprise-topics">
        <article class="enterprise-topic">
          <h3>{zh ? '私有化部署' : 'Private deployment'}</h3>
          <p>{zh
            ? '平台与资料部署在企业环境，按需接入本地模型，支持 Compose 与 Kubernetes。'
            : 'Deploy the platform and data in your environment with Compose or Kubernetes, and connect local models.'}
          </p>
          <ul class="enterprise-capabilities">
            {deployment.map(item => <li><Icon name={item.icon} size={22} /><span>{item.text}</span></li>)}
          </ul>
        </article>

        <article class="enterprise-topic">
          <h3>{zh ? '企业治理' : 'Enterprise governance'}</h3>
          <p>{zh
            ? '对齐组织身份，分别管理资源权限与业务委托，保留审核决定和执行记录。'
            : 'Align organizational identities, manage resource access and business delegation separately, and retain review decisions and execution records.'}
          </p>
          <ul class="enterprise-capabilities">
            {governance.map(item => <li><Icon name={item.icon} size={22} /><span>{item.text}</span></li>)}
          </ul>
        </article>
      </div>

      <figure class="enterprise-environment">
        <picture>
          <source media="(max-width: 560px)" srcset={`${networkIllustration}-mobile_${networkVersion}.svg`} width="400" height="635" />
          <img
            src={`${networkIllustration}_${networkVersion}.svg`}
            width="900" height="464" loading="lazy" decoding="async"
            alt={zh
              ? '企业知识库、Compose 或 Kubernetes 部署的 TeGo 平台与 vLLM、Qwen 本地模型服务连接同一企业内网，业务系统通过 MCP、RESTful API 或数据库接入，并纳入组织身份权限和审核审计。'
              : 'Enterprise knowledge, the TeGo platform deployed with Compose or Kubernetes, and local vLLM and Qwen model services connect through the enterprise network, alongside business systems using MCP, RESTful APIs or databases, with organizational identity, access, review and audit.'}
          />
        </picture>
        <figcaption>{zh ? '企业内网 · 私有化部署' : 'Enterprise network · Private deployment'}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .enterprise-section, .enterprise-topics { display: grid; gap: var(--space-grid); }
  .enterprise-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    align-items: center;
    gap: var(--space-grid);
  }
  .enterprise-environment { min-width: 0; margin: 0; }
  .enterprise-environment img { display: block; width: 100%; height: auto; }
  .enterprise-environment figcaption {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--type-meta);
    line-height: var(--leading-body);
    text-align: center;
  }
  .enterprise-topic h3 {
    margin: 0;
    font-size: var(--type-subhead);
    font-weight: 600;
    line-height: var(--leading-heading);
    letter-spacing: 0;
  }
  .enterprise-topic p {
    margin: var(--space-2) 0 0;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: var(--leading-body);
    text-wrap: pretty;
  }
  .enterprise-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .enterprise-capabilities li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    color: #b8c8dd;
    font-size: var(--type-meta);
    line-height: var(--leading-heading);
  }
  .enterprise-capabilities :global(svg) { flex-shrink: 0; width: 20px; height: 20px; color: #91b4e0; }
  @media (max-width: 900px) {
    .enterprise-layout { grid-template-columns: minmax(0, 1fr); }
    .enterprise-topics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .enterprise-topics { grid-template-columns: minmax(0, 1fr); }
  }
</style>
