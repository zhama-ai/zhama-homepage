---
import type { Locale } from '../data/types';
// Home-only styles (hero, dashboard and section layout); every other page skips them.
import '../styles/hero-workspace.css';
import '../styles/business-dashboard.css';
import '../styles/hero-landscape.css';
import '../styles/hero-motion.css';
import '../styles/insight-typewriter.css';
import '../styles/work-anywhere.css';
import '../styles/hero-luminance.css';
import '../styles/hero-spectrum.css';
import '../styles/hero-space.css';
import '../styles/home-layout.css';
import '../styles/hero-workspace-theme.css';
import '../styles/hero-duty-theme.css';
import WorkforceMatrix from './WorkforceMatrix.astro';
import HeroCarousel from './HeroCarousel.astro';
import SolutionExplorer from './SolutionExplorer.astro';
import WorkAnywhere from './WorkAnywhere.astro';
import HomeEnterprise from './HomeEnterprise.astro';
import CallToAction from './CallToAction.astro';
interface Props { locale: Locale; }
const {locale} = Astro.props;

---
<div class="home-value-edition">
<HeroCarousel locale={locale}/>
<WorkAnywhere locale={locale}/>
<HomeEnterprise locale={locale}/>
<WorkforceMatrix locale={locale}/>
<section class="value-section industry-section" id="solutions" aria-labelledby="industry-title">
  <div class="container">
    <SolutionExplorer locale={locale} home/>
  </div>
</section>
<CallToAction locale={locale} home/>
</div>
