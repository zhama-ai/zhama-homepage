---
import Icon from '../Icon.astro';
import type { Locale } from '../../data/types';
interface Props { locale: Locale; scene?: number; }
const { locale, scene = -1 } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const descriptions = [
  t('CRM 客户、项目文件和数据库查询结果进入客户经营任务，各项资料保留来源。','Customer records, project files and query results become sourced context for one customer task.'),
  t('客户沟通整理为跟进事项，经负责人确认后写入 CRM 客户时间线。','A conversation becomes follow-up actions, confirmed by the owner before being recorded in the CRM timeline.'),
  t('外部业务系统通过绑定用户与作用域的 OpenAPI 提交任务和附件，接收执行状态与成果文件。','A business system submits a task and attachments through scoped, user-bound OpenAPI, then retrieves status and deliverables.'),
];
---
<figure class:list={['cp-art', 'integration-art', `integration-scene-${scene}`, { 'integration-en': !zh }]} role="img" aria-label={scene < 0 ? t('数字员工通过业务插件、专业工具和数据连接读取业务资料、执行授权动作，并把成果接回业务系统。','A digital employee reads business records, uses authorized tools and returns results to business systems.') : descriptions[scene]}>
  <div aria-hidden="true">
    {scene < 0 && <div class="integration-overview">
      <div class="business-sources">
        <div class="business-source"><span class="source-symbol"><Icon name="users" size={20}/></span><div><strong>CRM</strong><p>{t('客户 · 商机 · 跟进','Customers · Deals · Follow-ups')}</p></div><span class="connection-kind">{t('业务插件','Plugin')}</span></div>
        <div class="business-source"><span class="source-symbol source-violet"><Icon name="wrench" size={20}/></span><div><strong>{t('专业工具','Specialist tools')}</strong><p>{t('检索 · 计算 · 处理','Search · Calculate · Process')}</p></div><span class="connection-kind">MCP</span></div>
        <div class="business-source"><span class="source-symbol source-teal"><Icon name="chart" size={20}/></span><div><strong>{t('业务数据','Business data')}</strong><p>{t('经营台账 · 查询结果','Business records · Query results')}</p></div><span class="connection-kind">{t('数据库','Database')}</span></div>
      </div>
      <div class="source-convergence"><svg viewBox="0 0 44 270" preserveAspectRatio="none"><path d="M0 43H13Q23 43 23 63V115Q23 135 43 135M0 135H43M0 227H13Q23 227 23 207V155Q23 135 43 135"/></svg><Icon name="arrow" size={20}/></div>
      <div class="integration-employee elevated"><span class="employee-symbol"><Icon name="user-check" size={27}/></span><strong>{t('客户经营数字员工','Customer operations digital employee')}</strong><p>{t('归集资料，整理跟进事项','Gather context and prepare follow-up')}</p><div class="integration-work-methods"><span><Icon name="file-search" size={13}/>{t('查询分析','Analyze')}</span><span><Icon name="plug" size={13}/>{t('授权办理','Act with permission')}</span></div></div>
      <div class="result-transfer"><Icon name="arrow" size={20}/><span>API</span></div>
      <div class="business-return"><div class="return-heading"><Icon name="clipboard-check" size={19}/><strong>{t('客户跟进','Customer follow-up')}</strong></div><div class="return-row"><i></i><span>{t('沟通纪要','Conversation notes')}</span></div><div class="return-row"><i></i><span>{t('后续事项','Next actions')}</span></div><div class="return-row"><i></i><span>{t('CRM 时间线','CRM timeline')}</span></div><div class="return-file"><Icon name="file" size={15}/>{t('客户跟进摘要.docx','Follow-up brief.docx')}</div></div>
    </div>}
    {scene === 0 && <div class="context-illustration">
      <div class="context-records"><div class="record-file"><div class="record-title"><Icon name="users" size={17}/><strong>{t('客户与商机','Customer and deal')}</strong><span>CRM</span></div><dl><div><dt>{t('项目','Project')}</dt><dd>{t('设备巡检数字化','Equipment inspection')}</dd></div><div><dt>{t('进展','Progress')}</dt><dd>{t('需求沟通与方案准备','Requirements and proposal')}</dd></div></dl></div><div class="record-file"><div class="record-title"><Icon name="folder" size={17}/><strong>{t('项目资料','Project materials')}</strong></div><div class="source-file"><Icon name="file" size={15}/>{t('需求访谈纪要.docx','Interview notes.docx')}</div><div class="source-file"><Icon name="file-check" size={15}/>{t('产品能力清单.xlsx','Product capabilities.xlsx')}</div></div><div class="record-query"><Icon name="chart" size={17}/><span>{t('经营数据查询结果','Business query results')}</span><b>{t('数据库','Database')}</b></div></div>
      <div class="context-arrow"><Icon name="arrow" size={23}/></div>
      <div class="context-task elevated"><div class="task-heading"><Icon name="message" size={18}/><strong>{t('客户经营任务','Customer operations task')}</strong></div><p class="task-request">{t('整理客户沟通与项目进展，准备后续方案交流材料。','Organize the conversations and project progress. Prepare materials for the next proposal discussion.')}</p><div class="context-bound"><Icon name="network" size={14}/><span>{t('关联本次工作的资料','Materials linked to this task')}</span></div><ul class="context-attached"><li><Icon name="users" size={15}/>{t('客户档案与商机进展','Customer record and deal progress')}</li><li><Icon name="file" size={15}/>{t('项目需求与产品资料','Requirements and product materials')}</li><li><Icon name="chart" size={15}/>{t('有来源的查询结果','Sourced query results')}</li></ul></div>
    </div>}
    {scene === 1 && <div class="followup-illustration">
      <div class="followup-input"><div class="mini-heading"><Icon name="message" size={17}/><strong>{t('客户沟通','Customer conversation')}</strong></div><div class="conversation-quote">{t('请补充设备巡检方案，下次交流重点看实施安排。','Please expand the inspection proposal. Focus the next discussion on implementation.')}</div><div class="source-file"><Icon name="file" size={14}/>{t('客户交流纪要.docx','Customer meeting notes.docx')}</div></div>
      <div class="flow-arrow"><Icon name="arrow" size={21}/></div>
      <div class="followup-draft elevated"><div class="mini-heading"><Icon name="file-check" size={18}/><strong>{t('跟进事项','Follow-up actions')}</strong></div><ul><li><Icon name="check" size={14}/>{t('补充巡检服务方案','Expand the service proposal')}</li><li><Icon name="check" size={14}/>{t('准备实施安排材料','Prepare the implementation plan')}</li></ul><div class="human-check"><Icon name="user-check" size={15}/><span>{t('负责人确认','Owner confirmation')}</span><b>{t('已确认','Confirmed')}</b></div></div>
      <div class="flow-arrow"><Icon name="arrow" size={21}/></div>
      <div class="followup-timeline"><div class="mini-heading"><Icon name="users" size={17}/><strong>{t('CRM 客户时间线','CRM customer timeline')}</strong></div><div class="timeline-entry"><span>{t('沟通结论','Discussion outcome')}</span><p>{t('聚焦设备巡检场景与实施安排','Focus on inspection needs and implementation')}</p></div><div class="timeline-entry"><span>{t('后续工作','Next actions')}</span><p>{t('完善方案，准备下一次交流','Refine the proposal for the next discussion')}</p></div><div class="timeline-receipt"><Icon name="check" size={14}/>{t('跟进记录已写入','Follow-up record saved')}</div></div>
    </div>}
    {scene === 2 && <div class="api-illustration">
      <div class="api-business"><div class="mini-heading"><Icon name="buildings" size={19}/><strong>{t('企业业务系统','Business system')}</strong></div><div class="api-work-item"><span>{t('待处理工作','Work to perform')}</span><strong>{t('编制项目服务方案','Prepare a service proposal')}</strong><p>{t('明确实施安排与交付内容','Define implementation and deliverables')}</p></div><div class="source-file"><Icon name="file" size={15}/>{t('项目需求清单.xlsx','Project requirements.xlsx')}</div></div>
      <div class="api-bridge"><span>OpenAPI</span><Icon name="arrow" size={23}/><div><Icon name="key" size={13}/>{t('用户 · scope','User · scope')}</div></div>
      <div class="api-execution elevated"><div class="mini-heading"><Icon name="user-check" size={20}/><strong>{t('数字员工作业','Digital employee execution')}</strong></div><div class="api-modes"><span>{t('同步','Sync')}</span><span>{t('异步','Async')}</span><span>{t('流式','Stream')}</span></div><div class="api-execution-line"><Icon name="check" size={14}/>{t('任务与附件','Task and attachments')}</div><div class="api-execution-line"><Icon name="check" size={14}/>{t('执行状态与事件','Status and events')}</div><div class="api-output"><Icon name="file-check" size={19}/><div><strong>{t('项目服务方案.docx','Service proposal.docx')}</strong><span>{t('成果文件','Deliverable')}</span></div></div></div>
      <div class="api-return"><Icon name="arrow" size={18}/><span>{t('状态、结果与文件返回原业务系统','Status, results and files return to the business system')}</span></div>
    </div>}
  </div>
</figure>
<style>
.integration-art{--ia-line:#91b8d83d;--ia-ink:#dce9f4;--ia-dim:#93abc1;--ia-blue:#98c4eb;--ia-green:#91c6bc;padding:22px 4px;box-sizing:border-box;line-height:1.6}
.integration-art :is(strong,b){font-weight:550}.integration-art strong{font-size:14px;color:var(--ia-ink);line-height:1.55}.integration-art p{font-size:12px;line-height:1.8;color:var(--ia-dim);margin-top:7px}.integration-art :global(svg){flex-shrink:0;color:var(--ia-blue)}
.elevated{background:linear-gradient(145deg,#1d3851,#112638);border:1px solid #a2c4e642;border-radius:9px;box-shadow:0 19px 35px -9px #0009,0 2px 9px #0004}
.integration-overview{display:grid;grid-template-columns:minmax(0,1.05fr) 35px minmax(0,1fr) 30px minmax(0,1fr);align-items:center;gap:0;min-height:340px}
.business-sources{display:grid;gap:17px}.business-source{display:flex;gap:9px;align-items:center;padding:14px 10px;background:#102435;border:1px solid #8bb5d328;border-radius:6px;position:relative;box-shadow:0 7px 17px #0002}.source-symbol{width:29px;height:32px;display:grid;place-items:center;border-radius:5px;background:#8bbaec12}.source-violet{background:#9ca4e313}.source-violet :global(svg){color:#afaee3}.source-teal{background:#81bdb712}.source-teal :global(svg){color:#96c8c0}.business-source strong{font-size:13px}.business-source p{font-size:10px;margin-top:3px}.connection-kind{position:absolute;right:6px;top:-9px;font-size:9px;color:#9abbd8;background:#0b1b29;padding:0 5px;border-radius:2px}
.source-convergence{height:270px;position:relative}.source-convergence>svg:first-child{width:100%;height:100%;stroke:var(--ia-line);stroke-width:1.1;fill:none}.source-convergence>:global(svg):last-child{position:absolute;right:0;top:calc(50% - 10px)}
.integration-employee{text-align:center;padding:24px 11px;position:relative;z-index:1}.employee-symbol{display:grid;place-items:center;width:47px;height:47px;margin:0 auto 13px;background:radial-gradient(circle,#86b3e029,#86b3e007);border-radius:50%}.integration-employee strong{font-size:15px}.integration-employee p{font-size:11px}.integration-work-methods{display:grid;grid-template-columns:minmax(0,1fr);gap:7px;margin-top:19px;border-top:1px solid #93b7d52a;padding-top:13px}.integration-work-methods>span{display:flex;gap:5px;align-items:center;justify-content:center;font-size:10px;color:#a6c3da}
.result-transfer{text-align:center;color:#93abc1;font-size:9px}.result-transfer span{display:block;margin-top:1px}.business-return{margin-top:25px;padding:19px 11px;background:#152a35;border:1px solid #8ab8bc30;border-radius:7px;box-shadow:0 12px 23px #0004}.return-heading{display:flex;align-items:center;gap:7px;margin-bottom:19px}.return-heading strong{font-size:13px}.return-heading :global(svg){color:#94c7bd}.return-row{display:flex;align-items:center;gap:8px;margin:13px 0;font-size:11px;color:#b3c9d7}.return-row i{width:5px;height:5px;background:#85b3ac;border-radius:50%;box-shadow:0 0 0 4px #88beb40b}.return-file{display:flex;align-items:center;gap:5px;font-size:9px;overflow-wrap:anywhere;margin-top:18px;padding-top:13px;border-top:1px solid #8db8bb24;color:#9dbdbd}.return-file :global(svg){color:#9dbdbd}
.context-illustration{display:grid;grid-template-columns:minmax(0,1fr) 42px minmax(0,1fr);align-items:center;gap:0}.context-records{display:grid;gap:16px}.record-file{padding:16px;background:#122638;border:1px solid #9bb9d32b;border-radius:7px;box-shadow:0 8px 21px #0003}.record-title{display:flex;align-items:center;gap:7px}.record-title strong{font-size:13px}.record-title>span{margin-left:auto;font-size:10px;color:#89a9c4}.record-file dl{margin:14px 0 0;display:grid;gap:10px}.record-file dl>div{display:grid;grid-template-columns:30px 1fr;gap:10px;font-size:11px}.record-file dt{color:#7f9ab2}.record-file dd{margin:0;color:#b8cbdc}.source-file{display:flex;align-items:center;gap:6px;font-size:11px;color:#b5c9db;margin-top:12px;overflow-wrap:anywhere}.source-file :global(svg){color:#afaee0}.record-query{display:flex;align-items:center;gap:7px;padding:14px 13px;background:#122b31;border:1px solid #83bab12a;border-radius:6px;font-size:11px;color:#b3ceca}.record-query :global(svg){color:#8fc4b9}.record-query b{font-size:9px;margin-left:auto;color:#8bb0ad}.context-arrow{text-align:center}.context-task{padding:24px 20px}.task-heading,.mini-heading{display:flex;align-items:center;gap:8px}.context-task .task-request{font-size:13px;color:#ccdeed;line-height:1.9;margin-top:19px}.context-bound{display:flex;align-items:center;gap:6px;margin-top:22px;font-size:10px;color:#94b3cf}.context-attached{list-style:none;padding:0;margin:13px 0 0;display:grid;gap:11px}.context-attached li{display:flex;gap:7px;align-items:center;font-size:11px;color:#b6cbdc}.context-attached :global(svg){color:#9bbbd4}
.followup-illustration{display:grid;grid-template-columns:minmax(0,1fr) 35px minmax(0,1.05fr) 35px minmax(0,1fr);align-items:center;gap:9px;max-width:960px;margin-inline:auto}.followup-input{padding:19px 13px}.mini-heading strong{font-size:14px}.conversation-quote{margin-top:20px;padding:15px;background:#132a3c;border:1px solid #91b7d22a;border-radius:7px;color:#bed3e5;font-size:12px;line-height:1.9;box-shadow:0 7px 18px #0003}.flow-arrow{text-align:center}.followup-draft{padding:23px 18px}.followup-draft ul{list-style:none;margin:24px 0 0;padding:0;display:grid;gap:16px}.followup-draft li{display:flex;align-items:flex-start;gap:8px;font-size:12px;color:#c4d7e6}.followup-draft li :global(svg){color:#8ebeb6;margin-top:3px}.human-check{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-top:24px;padding-top:16px;border-top:1px solid #8eb6d530;font-size:11px;color:#9fbdd4}.human-check b{color:#95c5b6;margin-left:auto;font-size:10px}.human-check :global(svg){color:#95c5b6}.followup-timeline{padding:18px;background:#112932;border:1px solid #86b6b42d;border-radius:7px;box-shadow:0 13px 25px #0004}.followup-timeline .mini-heading{margin-bottom:23px}.timeline-entry{padding:0 0 16px 15px;border-left:1px solid #8ebdbb55;position:relative}.timeline-entry:before{content:'';position:absolute;left:-3px;top:5px;width:5px;height:5px;border-radius:50%;background:#90beb7}.timeline-entry>span{font-size:10px;color:#86acae}.timeline-entry p{font-size:12px;margin-top:5px;color:#b9cfd5}.timeline-receipt{display:flex;gap:6px;align-items:center;font-size:10px;color:#95c9bb;margin-top:5px}
.api-illustration{display:grid;grid-template-columns:minmax(0,1fr) 74px minmax(0,1.05fr);align-items:center;padding-bottom:35px;position:relative}.api-business{padding:19px 15px;background:#122638;border:1px solid #98b8d32c;border-radius:7px;box-shadow:0 12px 25px #0003}.api-work-item{margin-top:22px;padding:15px 12px;background:#0c1a28;border-radius:5px}.api-work-item>span{font-size:10px;color:#7f9db8;display:block;margin-bottom:7px}.api-work-item strong{font-size:13px}.api-work-item p{font-size:11px}.api-bridge{display:flex;flex-direction:column;align-items:center;gap:9px;font-size:11px;color:#b1cce3}.api-bridge>div{display:flex;align-items:center;gap:4px;font-size:9px;color:#8faac1}.api-execution{padding:23px 18px}.api-modes{display:flex;gap:8px;flex-wrap:wrap;margin:19px 0}.api-modes>span{font-size:10px;padding:3px 7px;color:#a6c5df;background:#86b5e414;border:1px solid #8eb8dc24;border-radius:3px}.api-execution-line{display:flex;gap:7px;font-size:11px;color:#abc3d7;margin-top:11px;align-items:center}.api-execution-line :global(svg){color:#91c4b6}.api-output{display:flex;align-items:center;gap:9px;margin-top:20px;padding:12px 9px;background:#112d37;border:1px solid #8abeb72e;border-radius:5px}.api-output strong{font-size:11px;overflow-wrap:anywhere}.api-output span{display:block;margin-top:3px;font-size:9px;color:#8ab3b3}.api-output :global(svg){color:#9ac8bc}.api-return{display:flex;align-items:center;gap:8px;grid-column:1/-1;justify-content:center;color:#91afc5;font-size:10px;padding-top:22px}.api-return :global(svg){transform:rotate(180deg);color:#8bb8b9}
@media(max-width:1100px) and (min-width:851px){.integration-overview{max-width:750px;margin-inline:auto}.integration-overview .business-source strong{font-size:14px}.integration-overview .business-source p{font-size:11px}.integration-overview .business-return{padding-inline:18px}}
@media(max-width:600px){.integration-art{padding-block:14px}.integration-overview{grid-template-columns:minmax(0,1fr) 29px minmax(0,1fr);gap:0;min-height:0}.business-source{padding:12px 8px;gap:6px}.source-symbol{width:23px}.business-source strong{font-size:12px}.business-source p{font-size:9px}.connection-kind{font-size:8px}.business-sources{gap:18px}.integration-employee{padding:22px 11px}.integration-employee strong{font-size:14px}.result-transfer{grid-column:3;height:29px;display:flex;align-items:center;justify-content:center;gap:6px}.result-transfer :global(svg){transform:rotate(90deg);width:17px}.result-transfer span{margin:0}.business-return{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:8px 15px;margin-top:0;padding:18px}.return-heading{margin:0;grid-row:1/3;align-items:center}.return-row{margin:0;font-size:11px}.return-row:last-of-type{grid-column:2}.return-file{grid-column:1/-1;margin-top:6px;padding-top:11px;font-size:10px}.context-illustration{grid-template-columns:minmax(0,1fr);gap:17px}.context-records{grid-template-columns:1fr 1fr;gap:12px}.record-file{padding:14px 11px}.record-title{gap:5px;flex-wrap:wrap}.record-title strong{font-size:12px}.record-file dl>div{grid-template-columns:1fr;gap:3px}.record-title>span{font-size:9px}.record-query{grid-column:1/-1;padding:12px}.source-file{font-size:10px;gap:5px}.context-arrow :global(svg){transform:rotate(90deg)}.context-task{padding:23px}.context-attached{gap:12px}.context-task .task-request{font-size:13px}.followup-illustration{grid-template-columns:minmax(0,1fr);gap:12px}.followup-input{padding:8px 4px}.conversation-quote{margin-top:13px}.flow-arrow :global(svg){transform:rotate(90deg)}.followup-draft{padding:22px}.followup-draft ul{margin-top:19px}.followup-timeline{padding:22px}.api-illustration{grid-template-columns:minmax(0,1fr);gap:17px;padding-bottom:0}.api-business{padding:20px}.api-bridge{flex-direction:row;justify-content:center;gap:14px}.api-bridge>:global(svg){transform:rotate(90deg)}.api-execution{padding:22px}.api-return{padding:0 8px;font-size:10px;grid-column:auto;text-align:center}.api-modes{gap:10px}.integration-en .business-source p{font-size:9px}.integration-en .business-source strong{font-size:11px}.integration-en .return-heading strong{font-size:12px}.integration-en .return-row{font-size:10px}}
</style>
