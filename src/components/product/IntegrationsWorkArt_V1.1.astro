---
import Icon from '../Icon.astro';
import type { Locale } from '../../data/types';
interface Props { locale: Locale; scene?: number; }
const { locale, scene = -1 } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const sources = [
  { icon:'users', title:t('客户档案与商机','Customer & deal'), source:t('CRM 业务插件','CRM plugin'), detail:t('需求沟通与方案准备','Requirements & proposal') },
  { icon:'file', title:t('需求访谈纪要.docx','Interview notes.docx'), source:t('项目资料','Project files'), detail:t('设备巡检需求','Inspection requirements') },
  { icon:'file-check', title:t('产品能力清单.xlsx','Product capabilities.xlsx'), source:t('项目资料','Project files'), detail:t('方案能力与实施范围','Capabilities & scope') },
  { icon:'chart', title:t('经营数据查询结果','Business query results'), source:t('数据库','Database'), detail:t('按账号权限查询','Account-scoped query') },
];
const steps = [
  [t('关联客户与项目','Link customer and project'),t('客户档案、沟通记录','Customer record and notes'),t('业务插件','Plugin'),'users'],
  [t('检索方案资料','Retrieve proposal materials'),t('需求纪要、产品能力清单','Requirements and capabilities'),'MCP','file-search'],
  [t('整理后续工作','Prepare follow-up actions'),t('巡检方案、实施安排','Inspection and implementation'),t('任务成果','Deliverables'),'file-check'],
];
const alt = scene < 0 ? t('客户经营数字员工关联 CRM、项目资料和数据库，通过工具整理巡检方案与实施安排，确认后的跟进事项写入客户时间线。','A customer operations digital employee uses CRM records, project files and database context to prepare inspection follow-up and record confirmed actions in the customer timeline.') : [t('客户档案、项目文件与数据库结果按来源关联到设备巡检方案任务。','Customer records, project files and query results retain sources in an inspection proposal task.'),t('客户交流纪要经过读取、对象关联、事项整理和负责人确认，形成 CRM 跟进记录及成果文件。','Meeting notes become a CRM follow-up record and deliverables through source reading, record matching, action drafting and owner confirmation.'),t('业务系统通过绑定用户和作用域调用平台 OpenAPI，提交任务与附件，取得状态、人工事项和成果文件。','A business system uses user-bound scoped Platform OpenAPI to submit tasks and attachments and receive status, human work items and deliverables.')][scene];
---
<figure class:list={['cp-art','iw-art',`iw-scene-${scene}`,{'iw-en':!zh}]} role="img" aria-label={alt}>
<div aria-hidden="true">
  {scene < 0 && <div class="iw-hero-composition">
    <div class="iw-window iw-task-window">
      <div class="iw-window-bar"><span class="iw-product-mark"><Icon name="layers" size={15}/>TeGo</span><span class="iw-breadcrumb">{t('客户经营','Customer operations')}<span>/</span>{t('设备巡检方案','Inspection proposal')}</span><Icon name="external" size={13}/></div>
      <div class="iw-task-title"><span class="iw-employee"><Icon name="user-check" size={17}/></span><div><strong>{t('客户经营数字员工','Customer operations digital employee')}</strong><span>{t('设备巡检数字化','Equipment inspection')}</span></div><span class="iw-muted-label">{t('工作任务','Task')}</span></div>
      <div class="iw-task-tools"><span><Icon name="plug" size={13}/>MCP</span><span><Icon name="terminal" size={13}/>RESTful API</span><span><Icon name="chart" size={13}/>{t('数据库','Database')}</span></div>
      <div class="iw-hero-work">
        <div class="iw-hero-execution"><div class="iw-request">{t('整理客户沟通与项目进展，准备后续方案交流材料。','Organize customer conversations and project progress for the next proposal discussion.')}</div><div class="iw-execution-list">{steps.map(([title,detail,method,icon])=><div class="iw-execution-row"><span class="iw-trace-dot"><Icon name={icon} size={14}/></span><div><strong>{title}</strong><span>{detail}</span></div><em>{method}</em></div>)}</div></div>
        <div class="iw-hero-sources"><div class="iw-section-label">{t('关联资料','Linked context')}</div>{sources.map(source=><div class="iw-source-compact"><Icon name={source.icon} size={15}/><div><strong>{source.title}</strong><span>{source.source}</span></div></div>)}</div>
      </div>

    </div>
    <div class="iw-window iw-crm-return">
      <div class="iw-return-bar"><strong><Icon name="users" size={15}/>CRM<span>/</span>{t('客户时间线','Customer timeline')}</strong><span class="iw-state"><Icon name="check" size={13}/>{t('已写入','Saved')}</span></div>
      <div class="iw-return-content"><div class="iw-record-meta"><span class="iw-record-dot"></span><strong>{t('方案交流跟进','Proposal follow-up')}</strong><span>{t('设备巡检数字化','Equipment inspection')}</span></div><p>{t('沟通结论：聚焦设备巡检场景与实施安排。','Discussion: focus on inspection needs and implementation.')}</p><div class="iw-next-actions"><span><Icon name="check" size={12}/>{t('补充巡检服务方案','Expand the service proposal')}</span><span><Icon name="check" size={12}/>{t('准备实施安排材料','Prepare the implementation plan')}</span></div><div class="iw-file-row"><Icon name="file" size={14}/>{t('客户跟进摘要.docx','Customer follow-up brief.docx')}<span>{t('负责人已确认','Owner confirmed')}</span></div></div>
    </div>
  </div>}
  {scene === 0 && <div class="iw-context-composition">
    <div class="iw-window">
      <div class="iw-window-bar"><Icon name="folder" size={16}/><strong>{t('设备巡检数字化','Equipment inspection')}</strong><span class="iw-bar-end">{t('关联资料','Linked context')}</span></div>
      <div class="iw-object-line"><span class="iw-object-label">CRM</span><div><strong>{t('客户与商机','Customer & deal')}</strong><span>{t('需求沟通与方案准备','Requirements and proposal preparation')}</span></div><Icon name="network" size={18}/></div>
      <div class="iw-source-table"><div class="iw-source-header"><span>{t('资料','Material')}</span><span>{t('来源','Source')}</span></div>{sources.slice(1).map(source=><div class="iw-source-line"><Icon name={source.icon} size={16}/><div><strong>{source.title}</strong><span>{source.detail}</span></div><span>{source.source}</span></div>)}</div>
    </div>
    <div class="iw-context-task"><span class="iw-employee"><Icon name="user-check" size={17}/></span><div><strong>{t('准备后续方案交流材料','Prepare the next proposal discussion')}</strong><p>{t('客户沟通、项目需求与查询结果共同进入本次工作。','Customer conversations, requirements and query results inform the same task.')}</p><div class="iw-inline-files"><span><Icon name="file" size={13}/>{t('客户沟通纪要.docx','Conversation notes.docx')}</span><span><Icon name="file-check" size={13}/>{t('商机跟进清单.xlsx','Deal action list.xlsx')}</span></div></div></div>
  </div>}
  {scene === 1 && <div class="iw-action-composition">
    <div class="iw-window iw-processing-window"><div class="iw-window-bar"><Icon name="user-check" size={16}/><strong>{t('客户跟进任务','Customer follow-up task')}</strong><span class="iw-bar-end">{t('执行记录','Execution record')}</span></div><div class="iw-meeting-source"><Icon name="message" size={16}/><div><span class="iw-section-label">{t('客户交流纪要.docx','Customer meeting notes.docx')}</span><p>{t('请补充设备巡检方案，下次交流重点看实施安排。','Please expand the inspection proposal. Focus the next discussion on implementation.')}</p></div></div><div class="iw-process-rows">{[
      [t('资料读取','Read materials'),t('归集通话与会议纪要','Collect call and meeting notes'),'MCP'],
      [t('对象关联','Match records'),t('匹配客户与商机资料','Match customers and deal context'),t('CRM 插件','CRM plugin')],
      [t('事项整理','Prepare actions'),t('归纳沟通结论与后续工作','Organize outcomes and next actions'),t('任务成果','Deliverables')],
    ].map(([title,detail,method])=><div><Icon name="check" size={13}/><span>{title}</span><strong>{detail}</strong><em>{method}</em></div>)}</div><div class="iw-owner-gate"><Icon name="user-check" size={15}/>{t('负责人确认','Owner confirmation')}<span>{t('已确认','Confirmed')}</span><Icon name="arrow" size={15}/><span>RESTful API</span></div></div>
    <div class="iw-window iw-action-result"><div class="iw-return-bar"><strong><Icon name="users" size={15}/>CRM<span>/</span>{t('客户时间线','Customer timeline')}</strong><span class="iw-state"><Icon name="check" size={13}/>{t('已写入','Saved')}</span></div><div class="iw-action-record"><div class="iw-timeline-pin"></div><div><strong>{t('设备巡检方案 · 跟进记录','Inspection proposal · Follow-up')}</strong><p>{t('完善巡检方案；准备实施安排，接续下一次交流。','Refine the inspection proposal and implementation plan for the next discussion.')}</p><div class="iw-inline-files"><span><Icon name="file" size={13}/>{t('客户跟进摘要.docx','Follow-up brief.docx')}</span><span><Icon name="file-check" size={13}/>{t('商机行动清单.xlsx','Deal action list.xlsx')}</span></div></div></div></div>
  </div>}
  {scene === 2 && <div class="iw-api-composition">
    <div class="iw-window iw-api-request"><div class="iw-window-bar"><Icon name="buildings" size={16}/><strong>{t('企业业务系统','Business system')}</strong><span class="iw-bar-end">OpenAPI</span></div><div class="iw-api-task"><span class="iw-section-label">{t('任务请求','Task request')}</span><strong>{t('根据项目附件编制服务方案，并整理交付事项清单。','Use the project attachments to prepare a service proposal and delivery action list.')}</strong><div class="iw-inline-files"><span><Icon name="file-check" size={14}/>{t('项目需求清单.xlsx','Project requirements.xlsx')}</span></div></div><div class="iw-identity-row"><Icon name="key" size={14}/>{t('绑定执行用户','Bound user')}<span>scope</span><span>{t('幂等信息','Idempotency')}</span></div><div class="iw-api-modes"><div><strong>{t('同步','Sync')}</strong><span>{t('请求与结果','Request & result')}</span></div><div><strong>{t('异步','Async')}</strong><span>{t('任务与状态','Task & status')}</span></div><div><strong>{t('流式','Stream')}</strong><span>{t('过程与输出','Progress & output')}</span></div></div></div>
    <div class="iw-window iw-api-result"><div class="iw-return-bar"><strong><Icon name="arrow" size={15}/>{t('返回原业务入口','Back to the business app')}</strong><span class="iw-state">{t('成果返回','Results')}</span></div><div class="iw-api-response-body"><div class="iw-result-status"><span><Icon name="check" size={13}/>{t('执行状态','Task status')}</span><span><Icon name="message" size={13}/>{t('人工事项与回应','Human work items & responses')}</span></div><div class="iw-deliverable"><Icon name="file" size={24}/><div><strong>{t('项目服务方案.docx','Service proposal.docx')}</strong><span>{t('实施安排与交付内容','Implementation and deliverables')}</span></div><Icon name="download" size={15}/></div><div class="iw-deliverable"><Icon name="file-check" size={24}/><div><strong>{t('交付事项清单.xlsx','Delivery action list.xlsx')}</strong><span>{t('交付事项与后续工作','Deliverables and next actions')}</span></div><Icon name="download" size={15}/></div></div></div>
  </div>}
</div>
</figure>
<style>
.iw-art{--iw-bg:#0e1825;--iw-panel:#111e2d;--iw-line:#9ab0c51c;--iw-muted:#91a5ba;--iw-ink:#dae5ef;--iw-accent:#9abce0;color:var(--iw-ink);padding:8px 0;line-height:1.55}.iw-art::before{content:none}
.iw-art :global(svg){flex-shrink:0;color:#8faac3;stroke-width:1.5}.iw-art strong{display:block;font-size:12px;line-height:1.6;font-weight:500;color:#d7e2ed}.iw-art p{font-size:12px;line-height:1.8;color:#b3c4d5;margin:0}.iw-art em{font-style:normal;font-size:10px;color:#a1b5c8}.iw-art :is(div,span){min-width:0}.iw-window{background:var(--iw-bg);border:1px solid #a0b9d22b;border-radius:8px;overflow:hidden;box-shadow:0 22px 42px -18px #0009}
.iw-window-bar{display:flex;align-items:center;gap:9px;padding:13px 17px;min-height:45px;box-sizing:border-box;border-bottom:1px solid var(--iw-line);background:#15233355;font-size:11px;color:#9eb0c3}.iw-window-bar>strong{font-size:12px}.iw-window-bar>svg:last-child{margin-left:auto}.iw-bar-end{margin-left:auto;font-size:10px;color:#8a9fb5}.iw-product-mark{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:#e0e9f2}.iw-breadcrumb{display:flex;align-items:center;gap:9px;margin-left:12px;font-size:10px}.iw-breadcrumb>span{color:#586d82}.iw-employee{display:grid;place-items:center;flex-shrink:0;width:30px;height:30px;border-radius:7px;background:#20364f;color:#bdd6ee}.iw-employee>svg{color:inherit}
.iw-task-title{display:flex;align-items:center;gap:10px;padding:18px 19px 14px}.iw-task-title strong{font-size:14px}.iw-task-title>div>span{display:block;font-size:10px;color:var(--iw-muted);margin-top:2px}.iw-muted-label{font-size:10px;color:#9cafc2;margin-left:auto}.iw-hero-work{display:grid;grid-template-columns:1.3fr 1fr;gap:18px;padding:17px 19px 43px}.iw-request{font-size:13px;color:#c2d2e1;line-height:1.85;margin-bottom:17px}.iw-hero-sources{padding-left:17px;border-left:1px solid var(--iw-line)}.iw-section-label{display:block;color:#a1b5c8;font-size:10px;line-height:1.6}.iw-source-compact{display:flex;gap:8px;align-items:center;margin-top:14px}.iw-source-compact strong{font-size:11.5px;overflow-wrap:anywhere}.iw-source-compact>div>span{font-size:10px;color:#9cafc2;display:block;margin-top:2px}
.iw-execution-list{display:grid;gap:13px}.iw-execution-row{display:flex;gap:8px;align-items:flex-start}.iw-trace-dot{width:21px;height:21px;display:grid;place-items:center;flex-shrink:0;background:#20344a65;border-radius:50%}.iw-execution-row>div{flex:1}.iw-execution-row strong{font-size:12px}.iw-execution-row>div>span{font-size:10px;line-height:1.7;color:#a1b5c8;display:block;margin-top:2px}.iw-execution-row em{font-size:10px;white-space:nowrap;margin-top:2px}.iw-task-tools{display:flex;align-items:center;gap:23px;padding:12px 19px;border-block:1px solid var(--iw-line);font-size:10px;color:#a5bed4;background:#09131e70}.iw-task-tools>span{display:flex;align-items:center;gap:6px}
.iw-hero-composition{padding:0 0 5px}.iw-task-window{width:92%}.iw-crm-return{width:79%;margin:-27px 0 0 auto;position:relative;background:#152437;border-color:#8da9c33b;box-shadow:0 19px 45px -15px #000b}.iw-return-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--iw-line);background:#172a3c90}.iw-return-bar>strong{display:flex;align-items:center;gap:8px;font-size:11px}.iw-return-bar>strong>span{color:#627b93;font-size:10px}.iw-state{display:flex;align-items:center;gap:4px;color:#9dc5bf;font-size:10px;white-space:nowrap}.iw-state>svg{color:#9dc5bf}.iw-return-content{padding:15px 17px}.iw-record-meta{display:flex;align-items:center;gap:8px;margin-bottom:9px}.iw-record-meta>strong{font-size:12px}.iw-record-meta>span:last-child{margin-left:auto;font-size:10px;color:#8da5ba}.iw-record-dot{width:5px;height:5px;border-radius:50%;background:#94b7d6}.iw-return-content p{font-size:11px}.iw-next-actions{display:flex;gap:9px 17px;margin-top:10px;flex-wrap:wrap}.iw-next-actions>span{font-size:10px;color:#a6bdcf;display:flex;gap:5px;align-items:center}.iw-file-row{display:flex;gap:6px;align-items:center;font-size:10px;color:#aec5d9;border-top:1px solid var(--iw-line);padding-top:11px;margin-top:13px}.iw-file-row>span{margin-left:auto;font-size:10px;color:#8fa8bc}
.iw-object-line{display:flex;align-items:center;gap:12px;padding:19px;border-bottom:1px solid var(--iw-line)}.iw-object-label{font-size:11px;letter-spacing:.03em;width:39px;height:39px;display:grid;place-items:center;border:1px solid #82a4c433;border-radius:7px;background:#172a3d;color:#bad0e4}.iw-object-line>div{flex:1}.iw-object-line strong{font-size:14px}.iw-object-line>div>span{font-size:11px;color:#879eb4;display:block;margin-top:3px}.iw-source-table{padding:0 19px 6px}.iw-source-header{display:grid;grid-template-columns:1fr 92px;gap:10px;padding:13px 0 5px;font-size:10px;color:#9cafc2}.iw-source-line{display:grid;grid-template-columns:18px minmax(0,1fr) 92px;gap:10px;align-items:center;border-bottom:1px solid var(--iw-line);padding:14px 0}.iw-source-line:last-child{border:0}.iw-source-line strong{font-size:12px;overflow-wrap:anywhere}.iw-source-line>div>span{font-size:10px;display:block;color:#9cafc2;margin-top:3px}.iw-source-line>span{font-size:11px;color:#9db3c8}.iw-context-task{display:flex;gap:12px;margin:19px 0 0 34px;padding:20px;border-left:1px solid #678cb25e;background:linear-gradient(110deg,#15283c85,transparent)}.iw-context-task>div{flex:1}.iw-context-task strong{font-size:13px}.iw-context-task p{font-size:11px;margin-top:7px}.iw-inline-files{display:flex;gap:9px 17px;flex-wrap:wrap;margin-top:14px}.iw-inline-files>span{display:flex;gap:5px;align-items:center;font-size:10px;color:#9db6cc;overflow-wrap:anywhere}
.iw-processing-window{width:92%}.iw-meeting-source{display:flex;gap:11px;padding:17px 18px;border-bottom:1px solid var(--iw-line)}.iw-meeting-source>svg{margin-top:3px}.iw-meeting-source p{margin-top:6px;font-size:12px}.iw-process-rows{padding:5px 18px 8px}.iw-process-rows>div{display:grid;grid-template-columns:13px 60px minmax(0,1fr) auto;gap:8px;align-items:center;padding:12px 0;border-bottom:1px solid var(--iw-line)}.iw-process-rows>div:last-child{border:0}.iw-process-rows>div>span{font-size:10px;color:#8da5bd}.iw-process-rows strong{font-size:11px}.iw-process-rows em{font-size:10px}.iw-owner-gate{display:flex;align-items:center;gap:9px;font-size:10px;color:#a8bfd4;padding:13px 18px;background:#17283a;border-top:1px solid var(--iw-line);flex-wrap:wrap}.iw-owner-gate>span:first-of-type{color:#98bfb8;margin-left:auto}.iw-owner-gate>span:last-child{font-size:10px;color:#9eb5cc}.iw-action-result{width:85%;position:relative;margin:17px 0 0 auto;background:#122434}.iw-action-record{display:flex;gap:13px;padding:19px}.iw-timeline-pin{position:relative;flex-shrink:0;width:1px;background:#85aeb547;margin:7px 3px 0}.iw-timeline-pin:before{content:'';position:absolute;left:-2px;top:0;width:5px;height:5px;border-radius:50%;background:#9bbfbf}.iw-action-record strong{font-size:13px}.iw-action-record p{font-size:11px;margin-top:8px}.iw-action-record .iw-inline-files{margin-top:12px}
.iw-api-request{width:92%}.iw-api-task{padding:19px}.iw-api-task>strong{font-size:13px;line-height:1.85;margin-top:7px}.iw-identity-row{display:flex;align-items:center;gap:8px;padding:11px 19px;font-size:10px;background:#09131c85;color:#93adc4;border-block:1px solid var(--iw-line)}.iw-identity-row>span{margin-left:13px;color:#819bb4}.iw-api-modes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:16px 19px;gap:17px}.iw-api-modes>div+div{border-left:1px solid var(--iw-line);padding-left:17px}.iw-api-modes strong{font-size:11px}.iw-api-modes span{display:block;font-size:10px;color:#87a0b8;margin-top:3px}.iw-api-result{width:84%;margin:17px 0 0 auto;background:#142436}.iw-api-response-body{padding:16px 18px}.iw-result-status{display:flex;align-items:center;gap:16px;margin-bottom:5px;flex-wrap:wrap}.iw-result-status>span{display:flex;align-items:center;gap:5px;font-size:10px;color:#94b3c5}.iw-deliverable{display:flex;align-items:center;gap:12px;padding:15px 0;border-bottom:1px solid var(--iw-line)}.iw-deliverable:last-child{padding-bottom:2px;border:0}.iw-deliverable>div{flex:1}.iw-deliverable strong{font-size:12px;overflow-wrap:anywhere}.iw-deliverable>div>span{display:block;font-size:10px;color:#8ca8bd;margin-top:4px}.iw-deliverable>svg:first-child{color:#9cb7d0}.iw-deliverable>svg:last-child{color:#728ea8}
.iw-en .iw-breadcrumb{font-size:10px;gap:6px;margin-left:3px}.iw-en .iw-hero-work{grid-template-columns:1.15fr 1fr;gap:14px}.iw-en .iw-hero-sources{padding-left:13px}.iw-en .iw-task-title strong{font-size:13px}.iw-en .iw-execution-row em{font-size:9.5px}.iw-en .iw-record-meta{flex-wrap:wrap}.iw-en .iw-record-meta>span:last-child{margin-left:0}.iw-en .iw-file-row>span{font-size:9.5px}.iw-en .iw-process-rows>div{grid-template-columns:13px minmax(0,.85fr) minmax(0,1.6fr);gap:8px}.iw-en .iw-process-rows em{grid-column:3;padding-left:0}.iw-en .iw-process-rows>div>span{font-size:10px}.iw-en .iw-source-line{grid-template-columns:18px minmax(0,1fr) 88px}
