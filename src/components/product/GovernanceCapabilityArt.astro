---
import Icon from '../Icon.astro';
import type { Locale } from '../../data/types';
interface Props { locale: Locale; scene?: number; }
const { locale, scene = -1 } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const resources = [
 {icon:'book', name:t('交付制度知识库','Delivery policy library'), policy:t('知识库授权','Library permissions'), detail:t('查看 · 检索','View · Retrieve')},
 {icon:'folder', name:t('服务方案项目','Service proposal project'), policy:t('当前项目角色','Current project role'), detail:t('成员范围内访问','Access within membership')},
 {icon:'plug', name:t('客户经营插件','Customer management plugin'), policy:t('显式业务委托','Explicit delegation'), detail:t('委托人可见记录','Records visible to delegator')},
];
---
<figure class:list={['cp-art','governance-art',`governance-scene-${scene}`]} role="img" aria-label={t('数字员工按身份与资源授权工作，审核保留提交内容，执行记录关联来源和交付成果','Identity and resource authorization, retained review submissions, and execution records linked to evidence and deliverables')}>
 {scene === -1 && <div class="governance-overview">
   <div class="employee-task"><div class="task-person"><img src="/images/product/digital-employees/employee-portrait-public-service_V1.1.webp" width="42" height="42" alt="" loading="lazy"/><div><strong>{t('方案文书数字员工','Proposal and Writing digital employee')}</strong><span>{t('数字员工','Digital employee')}</span></div></div><div class="task-request"><Icon name="message" size={16}/><p>{t('依据交付制度与项目资料，编制验收准备清单。','Prepare an acceptance checklist using the delivery policy and project files.')}</p></div></div>
   <div class="governance-core raised"><div class="art-heading"><Icon name="key-round" size={20}/><strong>{t('按授权使用资源','Use authorized resources')}</strong></div><div class="overview-resources">{resources.map(resource=><div><Icon name={resource.icon} size={17}/><strong>{resource.name}</strong><span>{resource.policy}</span><Icon name="check" size={14}/></div>)}</div></div>
   <div class="execution-trace"><div class="trace-point"><Icon name="clipboard-check" size={17}/><span>{t('创建与开放审核','Creation & availability review')}</span></div><div class="trace-point"><Icon name="workflow" size={17}/><span>{t('执行步骤与工具调用','Steps & tool calls')}</span></div><div class="trace-point"><Icon name="file-search" size={17}/><span>{t('成果与来源记录','Deliverables & sources')}</span></div></div>
 </div>}
 {scene === 0 && <div class="authorization-composition">
   <div class="identity-source"><div class="identity-avatar"><Icon name="users" size={23}/></div><strong>{t('项目业务人员','Project colleague')}</strong><p>LDAP / OIDC</p><span>{t('租户身份 · 组织角色','Tenant identity · Organization role')}</span></div>
   <div class="resource-grants">{resources.map((resource,index)=><div class:list={['resource-grant',{'raised':index===1}]}><div class="resource-symbol"><Icon name={resource.icon} size={22}/></div><div><strong>{resource.name}</strong><p>{resource.policy}</p><span>{resource.detail}</span></div><Icon name="key-round" size={16}/></div>)}</div>
 </div>}
 {scene === 1 && <div class="review-composition">
   <div class="review-submission raised"><div class="art-heading"><Icon name="user-check" size={21}/><strong>{t('数字员工开放申请','Digital employee availability request')}</strong></div><div class="submission-name"><Icon name="file-check" size={20}/><div><strong>{t('方案文书数字员工','Proposal and Writing digital employee')}</strong><span>{t('申请范围：项目服务团队','Requested scope: project service team')}</span></div></div><div class="submission-assets"><div><Icon name="clipboard-check" size={15}/>{t('岗位职责','Responsibilities')}</div><div><Icon name="layers" size={15}/>{t('专业技能','Specialist skills')}</div><div><Icon name="key-round" size={15}/>{t('使用与资源范围','Usage and resource scope')}</div></div><div class="submission-snapshot"><Icon name="file" size={16}/>{t('本次提交快照','This submission snapshot')}</div></div>
   <div class="review-decisions"><div class="review-node"><Icon name="users" size={23}/><strong>{t('组织审核','Organizational review')}</strong></div><div class="review-outcomes"><div class="review-approved"><Icon name="check" size={18}/><div><strong>{t('审核通过','Approved')}</strong><span>{t('按批准范围开放','Available within the approved scope')}</span></div></div><div class="review-returned"><Icon name="message" size={18}/><div><strong>{t('审核拒绝','Rejected')}</strong><span>{t('保留拒绝理由','Retain the rejection reason')}</span></div></div></div><div class="decision-record"><Icon name="file-check" size={15}/>{t('保留审核决定与提交内容','Retain decisions and submitted content')}</div></div>
 </div>}
 {scene === 2 && <div class="audit-composition">
   <div class="execution-record"><div class="art-heading"><Icon name="workflow" size={20}/><strong>{t('项目验收准备','Acceptance preparation')}</strong></div><div class="audit-events">{[
    ['message',t('任务输入','Task input'),t('交付要求与项目资料','Requirements and project files')],
    ['search',t('检索与读取','Retrieve and read'),t('交付制度 · 已授权项目文件','Policy · Authorized project files')],
    ['users',t('人工确认','Human confirmation'),t('核对交付范围与确认事项','Check scope and confirmations')],
    ['file-check',t('形成成果','Create deliverable'),t('验收准备清单.docx','Acceptance preparation.docx')],
   ].map(([icon,title,body])=><div class="audit-event"><div class="event-icon"><Icon name={icon} size={16}/></div><div><strong>{title}</strong><p>{body}</p></div></div>)}</div></div>
   <div class="evidence-document raised"><div class="art-heading"><Icon name="file-search" size={20}/><strong>{t('执行回执','Execution receipt')}</strong></div><div class="receipt-file"><Icon name="file-check" size={25}/><strong>{t('验收准备清单.docx','Acceptance preparation.docx')}</strong><span>{t('成果文件','Deliverable')}</span></div><dl class="receipt-links"><div><dt>{t('关联任务','Task')}</dt><dd>{t('项目验收准备','Acceptance preparation')}</dd></div><div><dt>{t('来源依据','Sources')}</dt><dd>{t('交付制度与项目资料','Policy and project files')}</dd></div><div><dt>{t('执行过程','Execution')}</dt><dd>{t('步骤 · 调用 · 人工回应','Steps · Calls · Human response')}</dd></div></dl><div class="integrity-state"><Icon name="shield" size={16}/>{t('摘要核验与授权导出','Digest verification & scoped export')}</div></div>
 </div>}
</figure>
<style>
.governance-art{color:#c9d8e7;line-height:1.7;min-width:0}.governance-art :global(svg){flex-shrink:0;color:#92b9db}.governance-art strong{font-weight:550}.governance-art .art-heading{display:flex;align-items:center;gap:8px}.governance-art .art-heading strong{font-size:14px}.governance-art .raised{background:linear-gradient(145deg,#19354c,#112333);border:1px solid #93b9db3d;border-radius:8px;box-shadow:0 19px 36px -9px #0009,0 2px 10px #0004}.governance-overview{display:grid;gap:0;padding:20px 7px}.employee-task{display:flex;align-items:center;gap:25px;padding:18px 20px;background:#101f2e;border:1px solid #8caac72b;border-radius:7px;margin:0 21px -8px;position:relative;z-index:2;box-shadow:0 9px 20px #0004}.task-person{display:flex;align-items:center;gap:9px;flex-shrink:0}.task-person img{width:36px;height:36px;object-fit:cover;border-radius:6px}.task-person strong{font-size:13px}.task-person span{display:block;font-size:10px;color:#839db4;margin-top:2px}.task-request{display:flex;gap:7px;align-items:flex-start}.task-request p{font-size:11px;color:#9fb5c9;line-height:1.8;margin:0}.task-request :global(svg){margin-top:3px}.governance-core{padding:30px 23px 21px}.overview-resources{display:grid;gap:0;margin-top:17px}.overview-resources>div{display:grid;grid-template-columns:18px 1fr auto 15px;align-items:center;gap:8px;padding:15px 0;border-top:1px solid #8dacc41c}.overview-resources strong{font-size:12px}.overview-resources span{font-size:10px;color:#82a3bc}.overview-resources>div>:global(svg):last-child{color:#8bbfb4}.execution-trace{display:flex;gap:18px;justify-content:center;align-items:flex-start;margin-top:24px}.trace-point{display:flex;gap:6px;align-items:center;font-size:10px;color:#86a7be}.authorization-composition{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr);gap:45px;align-items:center;padding:25px 4px}.identity-source{text-align:center;position:relative}.identity-avatar{display:grid;place-items:center;width:55px;height:55px;border-radius:50%;background:#173149;border:1px solid #81acc638;margin:0 auto 17px;box-shadow:0 8px 20px #0004}.identity-source strong{font-size:15px}.identity-source p{font-size:12px;color:#94b5d0;margin-top:12px}.identity-source>span{font-size:10px;color:#7e9bb2;display:block;margin-top:8px}.resource-grants{display:grid;gap:16px;position:relative}.resource-grants::after{content:'';position:absolute;top:50%;right:100%;width:45px;border-top:1px solid #87b3d65e}.resource-grants::before{content:'';position:absolute;top:16%;bottom:16%;left:-16px;border-left:1px solid #87b3d65e}.resource-grant{display:flex;align-items:center;gap:12px;position:relative;padding:19px 16px;background:#112634;border:1px solid #83abc32a;border-radius:6px;box-shadow:0 8px 19px #0003}.resource-grant::before{content:'';position:absolute;left:-16px;top:50%;width:15px;border-top:1px solid #87b3d65e}.resource-symbol{display:grid;place-items:center;width:33px;height:38px;border-right:1px solid #8caecc24;padding-right:10px;box-sizing:content-box}.resource-grant>div:nth-child(2){flex:1}.resource-grant strong{font-size:13px}.resource-grant p{font-size:11px;color:#97b6ce;margin-top:4px}.resource-grant span{font-size:10px;color:#7e9fb6;display:block;margin-top:5px}.resource-grant>:global(svg):last-child{color:#82aca9}.review-composition{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:65px;align-items:center;padding:25px 22px}.review-submission{padding:27px}.submission-name{display:flex;align-items:center;gap:10px;margin-top:25px;padding-bottom:20px;border-bottom:1px solid #8eafd027}.submission-name strong{font-size:14px}.submission-name span{display:block;font-size:11px;color:#91abc0;margin-top:5px}.submission-assets{display:grid;gap:14px;margin-top:22px;font-size:12px;color:#a3bdd3}.submission-assets>div{display:flex;gap:9px;align-items:center}.submission-snapshot{display:flex;gap:7px;align-items:center;padding:13px 11px;border:1px solid #93b1d229;background:#09172585;border-radius:4px;margin-top:25px;font-size:11px;color:#91b5d1}.review-decisions{position:relative}.review-decisions::before{content:'→';position:absolute;left:-42px;top:30px;font-size:25px;color:#8fb6d7}.review-node{display:flex;align-items:center;gap:12px;margin-bottom:25px}.review-node strong{font-size:16px}.review-outcomes{display:grid;gap:20px;margin-left:11px;padding-left:24px;border-left:1px solid #8daecb40}.review-outcomes>div{position:relative;display:flex;align-items:flex-start;gap:9px}.review-outcomes>div::before{content:'';position:absolute;left:-24px;top:11px;width:16px;border-top:1px solid #8daecb40}.review-outcomes :global(svg){margin-top:3px}.review-outcomes strong{font-size:13px}.review-outcomes span{display:block;margin-top:5px;color:#8ea7bf;font-size:11px}.review-approved :global(svg){color:#8dc1b4}.review-returned :global(svg){color:#b5b0d8}.decision-record{display:flex;align-items:center;gap:6px;font-size:10px;color:#88a5bd;margin-top:30px}.audit-composition{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:26px;align-items:center;padding:25px 0}.execution-record{padding:10px 0}.audit-events{display:grid;margin-top:24px}.audit-event{display:flex;align-items:flex-start;gap:11px;position:relative;padding-bottom:23px}.audit-event:not(:last-child)::after{content:'';position:absolute;left:15px;top:31px;bottom:0;border-left:1px solid #79a4c33d}.event-icon{display:grid;place-items:center;width:31px;height:31px;background:#142e40;border:1px solid #84adc129;border-radius:5px;flex-shrink:0}.audit-event strong{font-size:12px}.audit-event p{font-size:11px;color:#8aa7be;margin-top:5px}.audit-event:last-child{padding-bottom:0}.evidence-document{padding:24px 18px}.receipt-file{padding:20px 0;border-bottom:1px solid #8dafcb24;margin-bottom:18px}.receipt-file>strong{font-size:12px;margin-top:9px}.receipt-file>span{display:block;font-size:10px;color:#83a7c0;margin-top:5px}.receipt-links{display:grid;gap:16px}.receipt-links>div{display:grid;gap:5px}.receipt-links dt{font-size:10px;color:#7f9bb1}.receipt-links dd{font-size:11px;color:#b4c8d9;margin:0}.integrity-state{display:flex;gap:6px;align-items:center;font-size:10px;color:#8eb7ac;margin-top:21px;border-top:1px solid #8cacc527;padding-top:15px}
@media(max-width:580px){.governance-overview{padding:10px 0}.employee-task{margin-inline:8px;padding:16px;flex-direction:column;align-items:flex-start;gap:14px}.task-person strong{font-size:14px}.task-request p{font-size:12px}.governance-core{padding:27px 17px 18px}.overview-resources>div{grid-template-columns:18px 1fr 15px;gap:8px;padding-block:14px}.overview-resources span{grid-column:2;grid-row:auto;font-size:11px}.overview-resources>div>:global(svg):last-child{grid-column:3;grid-row:1/3}.overview-resources strong{font-size:12px}.execution-trace{gap:12px;flex-wrap:wrap;justify-content:flex-start;margin-inline:9px}.trace-point{font-size:10px}.authorization-composition{grid-template-columns:1fr;gap:26px;padding:10px 0}.identity-source{display:grid;grid-template-columns:48px 1fr;text-align:left;column-gap:13px}.identity-avatar{grid-row:1/4;width:44px;height:44px;margin:0}.identity-source p{margin-top:4px}.identity-source>span{margin-top:3px}.resource-grants::after,.resource-grants::before,.resource-grant::before{display:none}.resource-grants{gap:13px}.resource-grant{padding:18px}.resource-grant strong{font-size:14px}.resource-grant p{font-size:12px}.resource-grant span{font-size:11px}.review-composition{grid-template-columns:1fr;gap:28px;padding:10px 0}.review-submission{padding:24px}.review-decisions{padding:3px 15px}.review-decisions::before{display:none}.review-outcomes{gap:21px}.decision-record{font-size:11px}.audit-composition{grid-template-columns:1fr;gap:25px;padding:10px 0}.audit-event strong{font-size:14px}.audit-event p{font-size:12px}.evidence-document{padding:24px}.receipt-links>div{grid-template-columns:70px 1fr;gap:10px}.receipt-links dt,.receipt-links dd{font-size:11px}}
</style>
