---
interface Props { label: string; method?: string; reverse?: boolean; vertical?: boolean; }
const { label, method, reverse = false, vertical = false } = Astro.props;
---
<div class:list={['ifr', { 'ifr-reverse': reverse, 'ifr-vertical': vertical }]}>
  <span class="ifr-label">{label}</span>
  <span class="ifr-arrow"></span>
  {method && <span class="ifr-method">{method}</span>}
</div>
<style>
.ifr{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;width:100%;min-width:0;color:#c4daee;line-height:1.45;text-align:center}
.ifr-label{font-size:11px}.ifr-method{font-size:10px;color:#9cb9d3;overflow-wrap:anywhere}
.ifr-arrow{display:block;width:100%;height:28px;flex-shrink:0;background:linear-gradient(90deg,#527eac08,#679bd260 43%,#a6c9ead9);clip-path:polygon(0 28%,66% 28%,66% 0,100% 50%,66% 100%,66% 72%,0 72%)}
.ifr-reverse .ifr-arrow{transform:rotate(180deg)}
.ifr-vertical{height:55px;position:relative;gap:3px;align-items:flex-start;padding-left:calc(50% + 22px);box-sizing:border-box;text-align:left}
.ifr-vertical .ifr-arrow{position:absolute;left:calc(50% - 12px);top:0;width:24px;height:100%;background:linear-gradient(#527eac08,#679bd260 43%,#a6c9ead9);clip-path:polygon(28% 0,72% 0,72% 66%,100% 66%,50% 100%,0 66%,28% 66%);transform:none}
@media(max-width:580px){.ifr-label{font-size:10px}}
</style>
