---
interface Props { label: string; method?: string; reverse?: boolean; }
const { label, method, reverse = false } = Astro.props;
---
<div class:list={['it2-transfer', {'it2-reverse': reverse}]}>
  <span class="it2-label">{label}</span>
  <span class="it2-arrow"></span>
  {method && <span class="it2-method">{method}</span>}
</div>
<style>
  .it2-transfer{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;min-width:0;width:100%;text-align:center;line-height:1.5}
  .it2-label{color:#c5d9ec;font-size:11px;overflow-wrap:anywhere}
  .it2-method{color:#91abc3;font-size:10px;overflow-wrap:anywhere}
  .it2-arrow{display:block;flex-shrink:0;width:100%;height:34px;background:linear-gradient(90deg,#547da90a,#719cc263 43%,#aacce8d9);clip-path:polygon(0 27%,65% 27%,65% 0,100% 50%,65% 100%,65% 73%,0 73%)}
  .it2-reverse .it2-arrow{transform:rotate(180deg)}
  @container integration-art (max-width:500px){
    .it2-transfer{position:relative;min-height:76px;box-sizing:border-box;align-items:flex-start;padding-left:calc(50% + 25px);gap:3px;text-align:left}
    .it2-transfer .it2-arrow{position:absolute;left:calc(50% - 14px);top:6px;bottom:6px;width:28px;height:calc(100% - 12px);background:linear-gradient(#547da90a,#719cc263 43%,#aacce8d9);clip-path:polygon(27% 0,73% 0,73% 65%,100% 65%,50% 100%,0 65%,27% 65%);transform:none}
  }
</style>
