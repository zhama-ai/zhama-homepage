---
import Icon from '../Icon.astro';
import type { Locale } from '../../data/types';
interface Props { locale: Locale; scene?: number; }
const { locale, scene = -1 } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const sources = [t('项目交付管理办法.pdf','Delivery policy.pdf'),t('交付物验收清单.xlsx','Acceptance checklist.xlsx'),t('年度服务方案.docx','Annual service proposal.docx')];
---
<figure class:list={['cp-art','knowledge-art',`knowledge-scene-${scene}`]} role="img" aria-label={t('企业知识从授权资料、检索引用到业务文稿的过程','Authorized enterprise sources, retrieval, citations and business documents')}>
  {scene === -1 && <div class="knowledge-overview">
    <div class="source-collection"><div class="art-heading"><Icon name="book" size={19}/><strong>{t('企业知识库','Enterprise knowledge')}</strong></div>{sources.map((name,i)=><div class="source-file"><Icon name={['book','chart','file'][i]} size={20}/><span>{name}</span></div>)}<div class="access-mark"><Icon name="key-round" size={14}/>{t('按调用人权限检索','Retrieve with caller permissions')}</div></div>
    <div class="knowledge-to-work"><Icon name="arrow" size={26}/></div>
    <div class="answer-sheet raised"><div class="question"><Icon name="search" size={17}/><strong>{t('项目验收要准备什么？','What does acceptance require?')}</strong></div><p>{t('按交付制度，准备以下材料：','Prepare the material required by the delivery policy:')}</p><ul class="answer-items"><li><Icon name="check" size={15}/>{t('核对约定成果与交付清单','Check agreed deliverables')}<sup>[1]</sup></li><li><Icon name="check" size={15}/>{t('整理文档版本与确认材料','Prepare revisions and confirmations')}<sup>[1]</sup></li></ul><div class="citation"><Icon name="book" size={14}/>[1] {t('项目交付管理办法 · 验收准备','Delivery policy · Acceptance')}</div><div class="deliverable"><Icon name="file-check" size={22}/><div><strong>{t('验收准备清单.docx','Acceptance preparation.docx')}</strong><span>{t('成果清单 · 版本核对 · 确认事项','Deliverables · Revisions · Confirmations')}</span></div></div></div>
  </div>}
  {scene === 0 && <div class="library-composition">
    <div class="library-list"><div class="art-heading"><Icon name="book" size={19}/><strong>{t('项目交付知识库','Project delivery library')}</strong></div><div class="library-table"><div class="library-columns"><span>{t('资料','Source material')}</span><span>{t('状态','State')}</span></div>{sources.map((name,i)=><div class:list={['library-file',{'selected':i===0}]}><Icon name={['file','chart','file'][i]} size={17}/><strong>{name}</strong><span><Icon name="check" size={11}/>{t('可检索','Indexed')}</span></div>)}</div><div class="processing"><span>{t('原文件','Source file')}</span><Icon name="arrow" size={14}/><span>{t('解析分段','Parse & chunk')}</span><Icon name="arrow" size={14}/><span>{t('检索索引','Search index')}</span></div></div>
    <div class="passage-preview raised"><div class="art-heading"><Icon name="file-search" size={18}/><strong>{t('原文与检索片段','Original and passage')}</strong></div><span class="passage-source">{t('项目交付管理办法.pdf','Delivery policy.pdf')}</span><h4>{t('验收准备','Acceptance preparation')}</h4><p>{t('核对约定成果与交付清单，记录文档版本与待确认事项。','Check agreed deliverables against the list. Record revisions and open confirmations.')}</p><mark>{t('交付资料应包含成果清单、版本记录与确认材料。','Include deliverables, revision records and confirmations.')}</mark><div class="passage-meta"><Icon name="layers" size={14}/>{t('片段关联原文件','Passage linked to source')}</div></div>
  </div>}
  {scene === 1 && <div class="citation-composition">
    <div class="original-sheet"><div class="art-heading"><Icon name="book" size={18}/><strong>{t('项目交付管理办法','Project delivery policy')}</strong></div><h4>{t('验收准备','Acceptance preparation')}</h4><p>{t('核对约定成果与交付清单，记录文档版本与待确认事项。','Check agreed deliverables and record revisions and open confirmations.')}</p><mark><span>[1]</span>{t('交付资料应包含成果清单、版本记录与确认材料。','Include deliverables, revision records and confirmations.')}</mark><div class="source-anchor"><Icon name="external" size={14}/>{t('原文片段与上下文','Original passage and context')}</div></div>
    <div class="citation-link"><Icon name="arrow" size={25}/></div>
    <div class="draft-sheet raised"><div class="art-heading"><Icon name="file-check" size={19}/><strong>{t('验收准备清单','Acceptance preparation')}</strong></div><div class="draft-title">{t('材料准备','Required materials')}</div><ul class="draft-checklist"><li><Icon name="check" size={14}/>{t('约定成果与交付清单','Agreed deliverables')}<sup>[1]</sup></li><li><Icon name="check" size={14}/>{t('文档版本记录','Revision records')}<sup>[1]</sup></li><li><Icon name="check" size={14}/>{t('确认材料与待办事项','Confirmations and actions')}<sup>[1]</sup></li></ul><div class="citation"><Icon name="book" size={14}/>[1] {t('项目交付管理办法','Delivery policy')}</div></div>
  </div>}
  {scene === 2 && <div class="boundary-composition">
    <div class="context-boundaries">
      <div class="boundary-source boundary-enterprise"><Icon name="book" size={19}/><div><strong>{t('企业知识','Enterprise knowledge')}</strong><p>{t('长期维护 · 跨任务复用','Maintained · Reused across tasks')}</p><span><Icon name="key-round" size={12}/>{t('知识库授权','Library permissions')}</span></div></div>
      <div class="boundary-source boundary-project"><Icon name="folder" size={19}/><div><strong>{t('项目资料','Project material')}</strong><p>{t('当前项目 · 文件与成果','Current project · Files and results')}</p><span><Icon name="users" size={12}/>{t('项目成员范围','Project membership')}</span></div></div>
      <div class="boundary-source boundary-memory"><Icon name="clock" size={19}/><div><strong>{t('工作记忆','Work memory')}</strong><p>{t('已确认背景 · 持续事项','Confirmed context · Ongoing work')}</p><span><Icon name="user-check" size={12}/>{t('成员与数字员工上下文','Member and digital employee context')}</span></div></div>
    </div>
    <div class="boundary-routing" aria-hidden="true"><svg viewBox="0 0 74 270" preserveAspectRatio="none"><path d="M1 45H25V135H73M1 135H73M1 225H25V135"/><circle cx="1" cy="45" r="2.5"/><circle cx="1" cy="135" r="2.5"/><circle cx="1" cy="225" r="2.5"/><circle cx="72" cy="135" r="3"/></svg></div>
    <div class="current-work raised"><div class="art-heading"><Icon name="file-search" size={20}/><strong>{t('当前任务','Current task')}</strong></div><p class="current-work-request">{t('依据交付制度和项目资料，更新下一阶段服务方案。','Update the next service phase proposal using policy and project material.')}</p><div class="context-used"><div><span>{t('制度依据','Policy evidence')}</span><b>{t('企业知识','Enterprise knowledge')}</b></div><div><span>{t('当前范围','Current scope')}</span><b>{t('项目资料','Project files')}</b></div><div><span>{t('已确认背景','Confirmed context')}</span><b>{t('工作记忆','Work memory')}</b></div></div><div class="scope-separation"><Icon name="shield" size={14}/>{t('各自校验访问范围，不自动合并授权','Separate access checks; no automatic permission sharing')}</div></div>
  </div>}
</figure>
<style>
.knowledge-art{line-height:1.7;color:#c8d7e7;min-width:0}.knowledge-art :is(strong,h4){font-weight:550}.knowledge-art .art-heading{display:flex;align-items:center;gap:8px;color:#a6c7e5}.knowledge-art .art-heading strong{font-size:14px}.knowledge-art :global(svg){flex-shrink:0;color:#91b9de}.knowledge-art p{font-size:12px;line-height:1.9;color:#a8bdd0}.knowledge-art .raised{background:linear-gradient(145deg,#1b354b,#112232);border:1px solid #8cb3d83d;border-radius:8px;box-shadow:0 18px 35px -8px #0008,0 2px 9px #0004}.knowledge-overview{display:grid;grid-template-columns:minmax(0,.9fr) 32px minmax(0,1.3fr);align-items:center;gap:10px;padding:24px 0}.source-collection{padding:8px 0}.source-file{display:flex;align-items:center;gap:9px;padding:15px 10px;margin-top:11px;background:#112535;border:1px solid #7fa4c323;border-radius:5px;box-shadow:0 6px 14px #0002;font-size:11px}.source-file:nth-of-type(3) :global(svg){color:#89b8aa}.source-file:nth-of-type(4) :global(svg){color:#b4afe0}.access-mark{display:flex;gap:5px;align-items:center;color:#88a9c0;font-size:10px;margin-top:17px}.knowledge-to-work{display:grid;place-items:center}.answer-sheet{padding:23px 20px}.question{display:flex;align-items:flex-start;gap:8px}.knowledge-art .question strong{font-size:14px}.answer-sheet>p{margin-top:18px}.answer-items{display:grid;gap:13px;list-style:none;padding:0;margin:16px 0 0;font-size:11px}.answer-items li,.draft-checklist li{display:flex;align-items:center;gap:6px}.answer-items :global(svg),.draft-checklist :global(svg){color:#8bbeb5}.knowledge-art sup{color:#9bc8f4;font-size:10px;align-self:flex-start}.citation{display:flex;gap:5px;align-items:center;border-top:1px solid #9cbada26;padding-top:14px;margin-top:20px;font-size:10px;color:#8fbbdd}.deliverable{display:flex;gap:10px;align-items:center;margin:24px -7px -6px;padding:14px 11px;background:#203c4b;border:1px solid #86b9cb29;border-radius:5px;box-shadow:0 9px 18px #0004}.knowledge-art .deliverable strong{font-size:12px}.deliverable span{display:block;color:#8fafbf;font-size:10px;margin-top:4px}.library-composition{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:20px;align-items:center;padding:25px 0}.library-list{padding:21px 16px;background:#101f2d;border:1px solid #83a8c42b;border-radius:7px;box-shadow:0 10px 20px #0003}.library-table{margin-top:18px}.library-columns{display:flex;justify-content:space-between;font-size:10px;color:#7794ae;padding:0 8px 10px}.library-file{display:flex;gap:7px;align-items:center;padding:15px 8px;border-top:1px solid #8fb4ce16}.knowledge-art .library-file strong{font-size:11px;flex:1}.library-file>span{display:flex;gap:3px;align-items:center;font-size:9px;white-space:nowrap;color:#86b5aa}.library-file.selected{background:#73ace512;border-radius:4px}.processing{display:flex;align-items:center;gap:7px;font-size:10px;color:#7f9fb9;margin-top:20px;flex-wrap:wrap}.passage-preview{padding:22px 19px;position:relative}.passage-source{display:block;margin-top:14px;color:#7e9db7;font-size:10px}.knowledge-art h4{font-size:14px;margin-top:19px;margin-bottom:9px}.knowledge-art mark{display:block;margin-top:17px;padding:11px;color:#bbdcd9;background:#80beb615;line-height:1.9;font-size:12px;border-radius:3px}.passage-meta{display:flex;align-items:center;gap:6px;font-size:10px;color:#91b3c9;margin-top:19px}.citation-composition{display:grid;grid-template-columns:minmax(0,1fr) 35px minmax(0,1fr);align-items:center;gap:18px;padding:25px 6px}.original-sheet{padding:27px;background:#11252f;border:1px solid #7fafa52b;border-radius:7px;box-shadow:0 10px 23px #0004}.original-sheet mark{position:relative;padding:13px}.original-sheet mark>span{display:block;color:#92c9c3;font-size:10px;margin-bottom:4px}.source-anchor{display:flex;gap:6px;align-items:center;margin-top:25px;color:#809fb4;font-size:10px}.citation-link{display:grid;place-items:center}.draft-sheet{padding:29px}.draft-title{font-size:13px;margin-top:25px;color:#c8d9e7}.draft-checklist{list-style:none;padding:0;display:grid;gap:20px;margin-top:20px;font-size:12px}.reuse-composition{display:grid;grid-template-columns:minmax(0,1fr) 95px minmax(0,1.1fr);align-items:center;gap:10px;padding:28px 0}.past-project{padding:20px 15px;border:1px solid #7ca8c32b;border-radius:6px;background:#102332;box-shadow:0 10px 20px #0003}.project-scope{display:flex;gap:5px;align-items:center;color:#87a7bc;font-size:10px;margin-top:14px}.project-files{display:grid;gap:10px;margin-top:24px}.project-files>div{display:flex;align-items:center;gap:7px;padding:12px 8px;background:#0716228c;border-radius:4px;font-size:11px}.reuse-transfer{display:flex;align-items:center;flex-direction:column;gap:12px;text-align:center;font-size:10px;color:#8fb3d0;padding-inline:5px}.current-project{padding:22px 17px}.project-draft{padding:18px 13px;margin-top:21px;background:#142d3d;border:1px solid #8ab3d527;border-radius:4px}.project-draft>strong{font-size:13px;margin-top:10px}.project-draft p{font-size:11px;margin-top:9px}.project-draft>span{display:inline-block;margin-top:14px;font-size:10px;color:#91bfb7}.current-project>.project-scope{padding-top:14px;border-top:1px solid #8fb7cf20;margin-top:20px}
.boundary-composition{display:grid;grid-template-columns:minmax(0,1fr) 74px minmax(0,1.08fr);align-items:center;padding:19px 0}.context-boundaries{display:grid;gap:12px}.boundary-source{display:grid;grid-template-columns:30px minmax(0,1fr);gap:11px;align-items:start;padding:14px 13px;border:1px solid #83a8c42b;border-radius:6px;background:#102332;box-shadow:0 8px 18px #0003}.boundary-source>div{min-width:0}.boundary-source>div>strong{font-size:12px}.boundary-source p{margin-top:3px;font-size:10px}.boundary-source span{display:flex;align-items:center;gap:5px;margin-top:8px;color:#82a2ba;font-size:9px}.boundary-project{border-color:#76aaa338;background:#10282d}.boundary-project>:global(svg),.boundary-project span :global(svg){color:#83bdb2}.boundary-memory{border-color:#9f98d237;background:#1b2036}.boundary-memory>:global(svg),.boundary-memory span :global(svg){color:#aaa4df}.boundary-routing{height:270px}.boundary-routing svg{width:100%;height:100%;overflow:visible;fill:none;stroke:#7ea8c24f;stroke-width:1.1;stroke-linecap:square;stroke-linejoin:miter;vector-effect:non-scaling-stroke}.boundary-routing circle{fill:#87badb;stroke:none}.boundary-routing circle:last-child{fill:#7ec2b8;transform-origin:72px 135px;animation:knowledge-pulse 2.8s ease-in-out infinite}.current-work{padding:23px 19px}.current-work-request{margin-top:19px!important;color:#c6d8e6!important;font-size:12px!important}.context-used{display:grid;gap:0;margin-top:18px}.context-used>div{display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-top:1px solid #8fb4ce1c;font-size:10px}.context-used span{color:#9eb6c9}.context-used b{color:#87b9d5;font-size:9px}.context-used>div:nth-child(2) b{color:#83bdb2}.context-used>div:nth-child(3) b{color:#aaa4df}.scope-separation{display:flex;align-items:center;gap:6px;margin-top:17px;padding-top:14px;border-top:1px solid #8fb4ce24;color:#8db6ad;font-size:9px}.scope-separation :global(svg){color:#86baaf}@keyframes knowledge-pulse{0%,100%{opacity:.55;transform:scale(.8)}50%{opacity:1;transform:scale(1.35)}}
@media(max-width:580px){.knowledge-overview{grid-template-columns:minmax(0,.82fr) 20px minmax(0,1.3fr);padding:8px 0;gap:5px}.source-collection{padding:0}.source-file{padding:9px 7px;margin-top:7px;gap:5px;font-size:9px}.source-file :global(svg){width:14px}.access-mark{margin-top:10px;font-size:9px}.knowledge-to-work{height:auto;transform:none}.knowledge-to-work :global(svg){width:16px}.answer-sheet{padding:15px 11px}.knowledge-art .question{gap:5px}.knowledge-art .question strong{font-size:11px}.knowledge-art .answer-sheet>p{margin-top:10px;font-size:9px;line-height:1.7}.answer-items{gap:8px;margin-top:10px;font-size:9px}.citation{margin-top:10px;padding-top:8px;font-size:8px}.deliverable{margin:12px -3px -2px;padding:8px 7px}.knowledge-art .deliverable strong{font-size:9px}.deliverable span{font-size:8px}.library-composition{grid-template-columns:1fr;gap:18px;padding:12px 0}.library-file{padding:15px 9px}.knowledge-art .library-file strong{font-size:12px}.library-file>span{font-size:10px}.library-columns{font-size:11px}.processing{font-size:11px}.passage-preview{padding:23px}.citation-composition{grid-template-columns:1fr;gap:14px;padding:10px 0}.original-sheet,.draft-sheet{padding:24px}.citation-link{height:22px;transform:rotate(90deg)}.reuse-composition{grid-template-columns:1fr;gap:18px;padding:10px 0}.reuse-transfer{flex-direction:row;justify-content:center;font-size:11px}.reuse-transfer :global(svg){transform:rotate(90deg)}.project-files>div{font-size:12px}.project-scope{font-size:11px}.project-draft>strong{font-size:14px}.boundary-composition{grid-template-columns:1fr;gap:0;padding:10px 0}.boundary-source{padding:15px}.boundary-source>div>strong{font-size:13px}.boundary-source p{font-size:11px}.boundary-source span{font-size:10px}.boundary-routing{height:32px;display:grid;place-items:center}.boundary-routing svg{width:66px;height:26px;transform:rotate(90deg)}.current-work{padding:23px}.current-work-request{font-size:13px!important}.context-used>div{font-size:11px}.context-used b,.scope-separation{font-size:10px}}
</style>
