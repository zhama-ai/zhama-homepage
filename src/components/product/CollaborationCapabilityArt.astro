---
import Icon from '../Icon.astro';
import type { Locale } from '../../data/types';
interface Props { locale: Locale; scene?: number; }
const { locale, scene = -1 } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const files = [t('需求访谈纪要.docx','Interview notes.docx'),t('服务需求清单.xlsx','Requirements.xlsx'),t('项目服务方案.docx','Service proposal.docx')];
const descriptions = [
 t('项目成员按角色访问已提交资料。数字员工对话归发起人，主动分享后可由项目成员只读查看。','Members access submitted materials by project role. Digital employee conversations belong to their initiator and can be shared for project members to read.'),
 t('方案文稿、评审批注与版本历史对应。补充实施安排后提交 V1.4，保留此前的 V1.2 和 V1.3。','A proposal connects its review comment with revision history. An implementation update is submitted as V1.4, preserving V1.2 and V1.3.'),
 t('数字员工将方案交付范围提交负责人审批，收到确认后回到原任务继续整理交付清单。','A digital employee asks the owner to approve delivery scope, then continues the original task after the response.'),
];
---
<figure class:list={['cp-art','collaboration-art',`collaboration-scene-${scene}`,{'collaboration-en':!zh}]} role="img" aria-label={scene<0?t('同一个方案项目中，成员与数字员工使用项目资料，审阅具体文稿并提交成果新版本。','In one proposal project, people and digital employees use shared materials, review the document and submit a new revision.'):descriptions[scene]}>
  <div aria-hidden="true">
    {scene<0 && <div class="project-overview">
      <div class="project-materials"><div class="mini-title"><Icon name="folder" size={18}/><strong>{t('项目资料','Project materials')}</strong></div>{files.slice(0,2).map((file,i)=><div class="material-file"><Icon name={i===0?'file':'chart'} size={18}/><span>{file}</span><b>{i===0?'V1.2':'V1.1'}</b></div>)}<div class="material-access"><Icon name="users" size={14}/>{t('项目成员按角色访问','Access by project role')}</div></div>
      <div class="project-link"><Icon name="arrow" size={20}/></div>
      <div class="overview-document lifted"><div class="document-kicker"><Icon name="file" size={16}/><span>DOCX</span><b>V1.4</b></div><strong class="document-title">{t('项目服务方案','Project service proposal')}</strong><div class="document-section"><span>{t('实施安排','Implementation')}</span><p>{t('需求确认、方案实施与成果交接分阶段推进。','Confirm requirements, implement the plan and hand over deliverables in stages.')}</p></div><div class="document-section"><span>{t('交付内容','Deliverables')}</span><p>{t('服务方案 · 实施计划 · 交付清单','Proposal · Implementation plan · Delivery list')}</p></div><div class="submitted-state"><Icon name="check" size={14}/>{t('新版本已提交','New revision submitted')}</div></div>
      <div class="review-comment"><div class="mini-title"><Icon name="message" size={16}/><strong>{t('项目评审意见','Project review')}</strong></div><p>{t('请补充每个阶段的交付内容，与实施计划对应。','Add the deliverables for each stage and align them with the implementation plan.')}</p><div><Icon name="user-check" size={14}/>{t('方案文书数字员工 · 已处理','Proposal and Writing digital employee · Addressed')}</div></div>
    </div>}
    {scene===0 && <div class="shared-context-illustration">
      <div class="shared-project lifted"><div class="shared-project-heading"><Icon name="folder" size={21}/><div><strong>{t('服务方案评审项目','Service proposal review')}</strong><span>{t('项目共享资料','Shared project materials')}</span></div></div><div class="project-file-list">{files.map((file,i)=><div><Icon name={i===1?'chart':'file'} size={18}/><strong>{file}</strong><b>{['V1.2','V1.1','V1.3'][i]}</b></div>)}</div><div class="project-roles"><span>{t('所有者','Owner')}</span><span>{t('可编辑成员','Editor')}</span><span>{t('查看者','Viewer')}</span></div></div>
      <div class="context-conversation"><div class="private-conversation"><div class="mini-title"><Icon name="message" size={17}/><strong>{t('数字员工对话','Digital employee conversation')}</strong><span><Icon name="key" size={12}/>{t('仅发起人','Initiator only')}</span></div><p>{t('基于项目资料，补充服务方案的实施安排。','Use the project materials to expand the implementation plan.')}</p><div class="conversation-file"><Icon name="file-check" size={14}/>{t('项目服务方案.docx','Service proposal.docx')}</div></div><div class="share-conversation"><Icon name="arrow" size={16}/><span>{t('主动分享至项目','Share to the project')}</span></div><div class="shared-conversation"><Icon name="users" size={17}/><div><strong>{t('项目成员查看','Project members can read')}</strong><span>{t('分享的对话只读查看','Shared conversations are read-only')}</span></div></div></div>
    </div>}
    {scene===1 && <div class="revision-illustration">
      <div class="revision-document lifted"><div class="document-kicker"><Icon name="file" size={17}/><span>DOCX</span><b>V1.4</b></div><strong class="revision-title">{t('项目服务方案','Project service proposal')}</strong><div class="revision-columns"><section><h4>{t('实施安排','Implementation plan')}</h4><p>{t('需求确认：梳理业务范围与资料。','Requirements: confirm the scope and materials.')}</p><p>{t('方案实施：按阶段完成配置与验证。','Implementation: complete configuration and validation by stage.')}</p><p>{t('成果交接：核对文件与交付清单。','Handover: check files against the delivery list.')}</p></section><section class="updated-content"><span class="updated-label"><Icon name="check" size={13}/>{t('本次补充','This revision')}</span><h4>{t('阶段交付内容','Stage deliverables')}</h4><ul><li>{t('需求与范围确认稿','Confirmed scope and requirements')}</li><li>{t('实施计划与验证记录','Implementation plan and validation')}</li><li>{t('成果文件与交付清单','Final files and delivery list')}</li></ul></section></div><div class="inline-review"><Icon name="message" size={16}/><div><strong>{t('评审意见','Review comment')}</strong><p>{t('补充阶段成果，使交付内容与实施计划对应。','Add stage deliverables to match the implementation plan.')}</p></div><span>{t('已处理','Addressed')}</span></div></div>
      <div class="revision-history"><strong class="history-title">{t('提交历史','Revision history')}</strong>{[['V1.2',t('归集需求与服务范围','Requirements and scope')],['V1.3',t('完善方案与交付内容','Proposal and deliverables')],['V1.4',t('补充阶段交付安排','Stage delivery plan')]].map(([version,title],i)=><div class:list={['history-entry',{'current':i===2}]}><span class="history-dot"></span><b>{version}</b><p>{title}</p>{i===2&&<span class="current-label"><Icon name="check" size={12}/>{t('当前版本','Current revision')}</span>}</div>)}</div>
    </div>}
    {scene===2 && <div class="human-handoff-illustration">
      <div class="original-task"><div class="mini-title"><Icon name="message" size={17}/><strong>{t('原任务','Original task')}</strong></div><p>{t('编制项目服务方案，并整理配套交付材料。','Prepare the service proposal and supporting delivery materials.')}</p><div class="task-source"><Icon name="folder" size={14}/>{t('服务方案评审项目','Service proposal review')}</div></div>
      <div class="handoff-arrow"><Icon name="arrow" size={21}/></div>
      <div class="approval-item lifted"><div class="approval-heading"><span><Icon name="user-check" size={17}/>{t('审批事项','Approval item')}</span><b>{t('已回应','Responded')}</b></div><strong class="approval-title">{t('确认方案交付范围','Confirm the delivery scope')}</strong><div class="approval-content"><span>{t('本次交付','Deliverables')}</span><p>{t('项目服务方案、实施计划与交付清单。','Service proposal, implementation plan and delivery list.')}</p></div><div class="approval-response"><Icon name="check" size={17}/><div><strong>{t('项目负责人','Project owner')}</strong><p>{t('同意，按上述范围继续整理。','Approved. Continue within this scope.')}</p></div></div></div>
      <div class="handoff-arrow"><Icon name="arrow" size={21}/></div>
      <div class="continued-task"><div class="mini-title"><Icon name="workflow" size={18}/><strong>{t('接续原任务','Resume the task')}</strong></div><p>{t('采用已确认范围，继续编制交付清单。','Use the confirmed scope to prepare the delivery list.')}</p><div class="handoff-output"><Icon name="file-check" size={21}/><div><strong>{t('交付材料清单.xlsx','Delivery materials.xlsx')}</strong><span>{t('交付内容与成果文件对应','Deliverables linked to files')}</span></div></div></div>
      <div class="handoff-return"><Icon name="arrow" size={16}/><span>{t('人工回应返回原会话与运行','The response returns to the original conversation and run')}</span></div>
    </div>}
  </div>
</figure>
<style>
.collaboration-art{--ca-line:#8db6d438;--ca-ink:#dce8f4;--ca-muted:#91abc3;--ca-blue:#96bee6;--ca-green:#96c5b8;box-sizing:border-box;padding:23px 5px;color:var(--ca-ink);line-height:1.65}.collaboration-art :is(strong,b){font-weight:550}.collaboration-art strong{font-size:14px;line-height:1.55;color:var(--ca-ink)}.collaboration-art p{font-size:12px;line-height:1.85;color:#b0c4d6;margin-top:7px}.collaboration-art :global(svg){color:var(--ca-blue);flex-shrink:0}.lifted{background:linear-gradient(145deg,#1c354f,#112536);border:1px solid #a0c2e041;border-radius:8px;box-shadow:0 21px 36px -9px #0009,0 2px 11px #0004}.mini-title{display:flex;align-items:center;gap:7px}.mini-title strong{font-size:13px}.project-overview{position:relative;display:grid;grid-template-columns:minmax(0,.95fr) 35px minmax(0,1.2fr);align-items:center;padding:9px 0 18px}.project-materials{padding:18px 13px;background:#112333;border:1px solid #88afd02d;border-radius:7px;box-shadow:0 10px 23px #0003}.material-file{display:grid;grid-template-columns:18px 1fr;gap:3px 7px;margin-top:20px;font-size:11px;color:#becfe0}.material-file b{grid-column:2;color:#7f9db8;font-size:10px}.material-file :global(svg){grid-row:1/3}.material-file:nth-of-type(3) :global(svg){color:#8dbbb1}.material-access{display:flex;gap:5px;align-items:center;color:#8cabc5;font-size:10px;margin-top:20px;padding-top:14px;border-top:1px solid #89adca23}.project-link{text-align:center}.overview-document{position:relative;padding:22px 20px;min-height:275px}.document-kicker{display:flex;align-items:center;gap:6px;color:#8fb6d8;font-size:10px}.document-kicker b{margin-left:auto;font-size:10px;color:#9cc9ba}.collaboration-art .document-title{display:block;font-size:19px;margin-top:19px}.document-section{margin-top:22px}.document-section>span{font-size:11px;color:#93b4d0}.document-section p{font-size:12px}.submitted-state{display:flex;align-items:center;gap:6px;font-size:10px;color:#9bcab9;margin-top:23px}.submitted-state :global(svg){color:#9bcab9}.review-comment{position:relative;grid-column:2/-1;justify-self:end;width:87%;box-sizing:border-box;margin-top:-14px;margin-right:15px;padding:16px 17px;z-index:2;background:#1b3044;border:1px solid #a0bdd63b;border-radius:7px;box-shadow:0 14px 28px #0007}.review-comment .mini-title strong{font-size:12px}.review-comment p{font-size:11px;color:#b7cde0}.review-comment>div:last-child{display:flex;align-items:center;gap:5px;margin-top:13px;font-size:9px;color:#8bbdb0}.review-comment>div:last-child :global(svg){color:#8bbdb0}
.shared-context-illustration{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:24px;align-items:center}.shared-project{padding:23px 18px}.shared-project-heading{display:flex;align-items:center;gap:9px}.shared-project-heading strong{font-size:15px}.shared-project-heading div>span{display:block;font-size:10px;color:#89a8c2;margin-top:4px}.project-file-list{margin-top:19px}.project-file-list>div{display:grid;grid-template-columns:17px 1fr;gap:3px 8px;padding:13px 0;border-bottom:1px solid #8bb1d019}.project-file-list strong{font-size:11px}.project-file-list :global(svg){grid-row:1/3}.project-file-list>div:nth-child(2) :global(svg){color:#94c6ba}.project-file-list b{grid-column:2;font-size:9px;color:#85a4bf}.project-roles{display:flex;flex-wrap:wrap;gap:7px 12px;font-size:9px;color:#94b2c8;margin-top:20px}.context-conversation{padding-top:20px}.private-conversation{padding:18px 14px;border:1px solid #a2b0de2e;border-radius:7px;background:#172638;box-shadow:0 10px 24px #0003}.private-conversation .mini-title{flex-wrap:wrap}.private-conversation .mini-title>span{display:flex;align-items:center;gap:3px;font-size:9px;color:#9dacc9}.private-conversation p{font-size:12px;margin-top:16px}.conversation-file{display:flex;align-items:center;gap:5px;margin-top:15px;padding:9px 0 0;border-top:1px solid #8da6cc23;font-size:10px;color:#a9c2d7;overflow-wrap:anywhere}.share-conversation{display:flex;align-items:center;justify-content:center;gap:6px;padding:19px 0;color:#99b9d5;font-size:10px}.share-conversation :global(svg){transform:rotate(90deg)}.shared-conversation{display:flex;align-items:center;gap:9px;padding:16px 13px;border:1px solid #8db7b82f;border-radius:6px;background:#112c33}.shared-conversation :global(svg){color:#95c8bb}.shared-conversation strong{font-size:12px}.shared-conversation div>span{display:block;font-size:9px;color:#87afad;margin-top:4px}
.revision-illustration{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(0,.7fr);gap:48px;align-items:center;max-width:950px;margin-inline:auto}.revision-document{padding:27px 30px}.collaboration-art .revision-title{display:block;font-size:22px;margin-top:19px}.revision-columns{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:27px}.revision-columns h4{margin:0;font-size:13px;color:#c8dcee;line-height:1.6}.revision-columns p{font-size:12px;line-height:1.9;margin-top:13px}.updated-content{background:#8abcb50a;border:1px solid #90bab526;border-radius:4px;padding:14px}.updated-label{display:flex;gap:5px;align-items:center;color:#91c3b4;font-size:9px;margin-bottom:12px}.updated-label :global(svg){color:#91c3b4}.updated-content ul{padding-left:15px;font-size:11px;color:#b2cdd0;display:grid;gap:12px;margin-top:15px}.inline-review{display:flex;gap:8px;align-items:flex-start;background:#96aee409;border:1px solid #94acd528;border-radius:5px;padding:13px 14px;margin-top:24px}.inline-review>:global(svg){color:#a6b4df;margin-top:3px}.inline-review strong{font-size:10px;color:#9eb6d1}.inline-review p{font-size:11px;margin-top:5px}.inline-review>span{font-size:9px;color:#95c3b3;white-space:nowrap;margin-left:auto}.history-title{display:block;margin:0 0 20px 16px;font-size:12px!important;color:#a2bfd7!important}.history-entry{position:relative;margin-left:7px;padding:0 0 27px 25px;border-left:1px solid #8bb1d33b}.history-entry:last-child{border-color:transparent;padding-bottom:0}.history-dot{position:absolute;left:-4px;top:6px;width:7px;height:7px;border-radius:50%;background:#6e91b3}.history-entry>b{font-size:15px;color:#b5cce0}.history-entry p{font-size:11px;line-height:1.6;margin-top:5px}.history-entry.current .history-dot{background:#9bc6be;box-shadow:0 0 0 5px #90bfb411}.history-entry.current>b{color:#abd1ed}.current-label{display:flex;gap:5px;align-items:center;font-size:9px;color:#8ec2b2;margin-top:9px}.current-label :global(svg){color:#8ec2b2}
.human-handoff-illustration{display:grid;grid-template-columns:minmax(0,.9fr) 30px minmax(0,1.2fr) 30px minmax(0,.9fr);gap:8px;align-items:center}.original-task,.continued-task{padding:16px 9px}.original-task>p,.continued-task>p{font-size:12px;margin-top:18px}.task-source{display:flex;align-items:center;gap:5px;margin-top:20px;color:#91afc7;font-size:10px}.handoff-arrow{text-align:center}.approval-item{padding:20px 17px}.approval-heading{display:flex;gap:5px;align-items:center;justify-content:space-between}.approval-heading>span{display:flex;align-items:center;gap:6px;font-size:11px;color:#a1c4e2}.approval-heading>b{font-size:9px;color:#91c3b2}.collaboration-art .approval-title{display:block;font-size:16px;margin-top:23px}.approval-content{padding:13px 11px;background:#0d2031;border-radius:4px;margin-top:16px}.approval-content>span{font-size:10px;color:#85a4c0}.approval-content p{font-size:11px;margin-top:7px;color:#bed0e0}.approval-response{display:flex;gap:8px;align-items:flex-start;margin-top:19px}.approval-response>:global(svg){color:#91c2b1;margin-top:3px}.approval-response strong{font-size:10px;color:#95b5c9}.approval-response p{font-size:11px;margin-top:5px;color:#b8d0cc}.handoff-output{display:flex;align-items:center;gap:8px;padding:13px 10px;background:#112b32;border:1px solid #8eb6b631;border-radius:5px;margin-top:22px}.handoff-output>:global(svg){color:#9ac7ba}.handoff-output strong{font-size:11px;overflow-wrap:anywhere}.handoff-output div>span{display:block;color:#86b0af;font-size:9px;margin-top:5px}.handoff-return{display:flex;align-items:center;justify-content:center;gap:8px;grid-column:1/-1;margin-top:18px;font-size:10px;color:#90aec5}.handoff-return :global(svg){transform:rotate(180deg);color:#8bbcb3}
@media(max-width:600px){.collaboration-art{padding:13px 1px}.project-overview{grid-template-columns:minmax(0,1fr) 24px minmax(0,1.15fr);padding-bottom:19px}.project-materials{padding:15px 10px}.material-file{font-size:10px;grid-template-columns:15px 1fr;gap:3px 5px}.material-file :global(svg){width:15px}.material-access{font-size:9px;gap:4px}.overview-document{padding:18px 13px;min-height:280px}.collaboration-art .document-title{font-size:16px}.document-section{margin-top:19px}.document-section>span{font-size:10px}.document-section p{font-size:11px}.review-comment{width:92%;grid-column:1/-1;margin-top:-6px;margin-right:0;padding:15px}.review-comment p{font-size:11px}.shared-context-illustration{grid-template-columns:1fr;gap:21px}.shared-project{padding:23px}.project-file-list>div{grid-template-columns:20px 1fr auto;align-items:center;gap:9px}.project-file-list :global(svg){grid-row:auto}.project-file-list strong{font-size:12px}.project-file-list b{grid-column:auto}.project-roles{font-size:10px;gap:18px}.context-conversation{padding-top:0}.private-conversation{padding:20px}.private-conversation .mini-title>span{margin-left:auto}.shared-conversation{padding:17px 20px}.private-conversation p{font-size:13px}.conversation-file{font-size:11px}.shared-conversation strong{font-size:13px}.shared-conversation div>span{font-size:10px}.revision-illustration{grid-template-columns:1fr;gap:27px}.revision-document{padding:23px 20px}.collaboration-art .revision-title{font-size:21px}.revision-columns{gap:15px;margin-top:23px}.revision-columns p{font-size:11px}.updated-content{padding:12px 9px}.updated-content ul{font-size:10px;gap:10px;padding-left:12px}.revision-columns h4{font-size:12px}.inline-review{padding:12px 10px;gap:6px}.inline-review p{font-size:10px}.inline-review>span{font-size:9px}.revision-history{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.history-title{grid-column:1/-1;margin:0 0 0 4px}.history-entry{border-left:none;border-top:1px solid #8bb1d33b;margin:0;padding:17px 2px 0}.history-entry:last-child{padding:17px 2px 0;border-top-color:#8bb1d33b}.history-dot{left:0;top:-4px}.history-entry>b{font-size:14px}.history-entry p{font-size:10px}.current-label{font-size:9px}.human-handoff-illustration{grid-template-columns:1fr;gap:11px}.original-task,.continued-task{padding:9px 6px}.original-task>p,.continued-task>p{font-size:13px;margin-top:12px}.task-source{margin-top:13px}.handoff-arrow :global(svg){transform:rotate(90deg)}.approval-item{padding:23px}.approval-content{padding:14px}.approval-content p{font-size:12px}.approval-response p{font-size:12px}.approval-heading>b{font-size:10px}.handoff-output{margin-top:16px;padding:15px}.handoff-output strong{font-size:12px}.handoff-output div>span{font-size:10px}.handoff-return{font-size:10px;margin-top:11px;text-align:center}.collaboration-en .overview-document{padding-inline:11px}.collaboration-en .document-title{font-size:15px}.collaboration-en .material-file{font-size:9px}.collaboration-en .material-access{font-size:8px}.collaboration-en .document-section p{font-size:10px}}
</style>
