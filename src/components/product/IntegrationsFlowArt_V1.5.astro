---
import Icon from '../Icon.astro';
import Route from './IntegrationRoute_V1.2.astro';
import type { Locale } from '../../data/types';
interface Props { locale: Locale; scene?: number; }
const { locale, scene = -1 } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const context = [
  {icon:'users',system:'CRM',object:t('客户与商机','Customers & deals'),method:t('CRM 插件','CRM plugin'),result:t('沟通记录与跟进事项','Conversations & follow-up')},
  {icon:'folder',system:t('招投标系统','Bidding system'),object:t('项目与投标','Projects & bids'),method:t('招投标插件','Bidding plugin'),result:t('资质清单与项目材料','Qualifications & project files')},
  {icon:'file-check',system:'EHS',object:t('检查与隐患','Inspections & hazards'),method:t('EHS 插件','EHS plugin'),result:t('检查记录与附件证据','Inspection records & evidence')},
  {icon:'chart',system:t('业务数据库','Business database'),object:t('经营指标','Operating metrics'),method:t('数据库连接','Database connection'),result:t('查询结果与汇总指标','Query results & aggregates')},
];
const steps = [t('关联客户与商机','Match customers and deals'), t('归集沟通与项目资料','Collect conversations and files'), t('整理结论与后续事项','Prepare decisions and next actions')];
const alt = scene < 0
  ? t('CRM 客户资料通过业务插件进入 TeGo 数字员工任务，MCP 与数据库提供工具和数据；任务成果经 RESTful API 写回 CRM 客户时间线。','CRM records enter a TeGo digital employee task through a business plugin. MCP and a database provide tools and data. Results return to the CRM timeline through RESTful API.')
  : [t('CRM、招投标、EHS 和数据库通过各自连接，把对应业务资料按来源汇入 TeGo 任务。','CRM, bidding, EHS and database connections bring sourced business context into a TeGo task.'),t('客户交流纪要进入 TeGo，数字员工读取、关联并整理跟进事项，通过 RESTful API 写入 CRM 客户时间线。','A TeGo digital employee reads meeting notes, matches records and prepares follow-up actions, then uses RESTful API to update the CRM timeline.'),t('企业业务系统通过平台 OpenAPI 向 TeGo 提交任务和附件，并以同步、异步或流式方式获取状态、人工事项与成果。','A business system submits tasks and files to TeGo through Platform OpenAPI, then receives status, human work items and results through sync, async or streaming interfaces.')][scene];
---
<figure class:list={['cp-art','if-art',`if-scene-${scene}`,{'if-en':!zh}]} role="img" aria-label={alt}>
<div aria-hidden="true">
{scene < 0 && <div class="if-hero-flow">
  <div class="if-pane if-crm-source">
    <div class="if-bar"><Icon name="users" size={16}/><strong>CRM</strong><span>{t('客户与商机','Customer & deal')}</span></div>
    <div class="if-content"><strong>{t('设备巡检数字化','Equipment inspection')}</strong><div class="if-record-field"><span>{t('沟通内容','Conversations')}</span><p>{t('补充巡检服务方案，准备下一次实施安排交流。','Expand the inspection proposal and prepare the implementation discussion.')}</p></div><div class="if-file"><Icon name="file" size={14}/>{t('客户交流纪要.docx','Meeting notes.docx')}</div></div>
  </div>
  <div class="if-ingress"><Route label={t('读取客户资料','Read customer records')} method={t('CRM 业务插件','CRM plugin')}/></div>
  <div class="if-pane if-tego-task">
    <div class="if-bar if-brand"><Icon name="layers" size={17}/><strong>TeGo</strong><span>{t('数字员工任务','Digital employee task')}</span></div>
    <div class="if-content"><div class="if-employee"><Icon name="user-check" size={18}/><strong>{t('客户经营数字员工','Customer operations digital employee')}</strong></div><p class="if-request">{t('整理客户沟通和项目进展，形成后续跟进事项。','Organize customer conversations and project progress into follow-up actions.')}</p><div class="if-step-list">{steps.map(step=><div><span class="if-step-node"><Icon name="check" size={12}/></span><span>{step}</span></div>)}</div><div class="if-task-output"><span>{t('任务成果','Task output')}</span><div class="if-file"><Icon name="file" size={14}/>{t('客户跟进摘要.docx','Customer follow-up brief.docx')}</div><div class="if-file"><Icon name="file-check" size={14}/>{t('商机行动清单.xlsx','Deal action list.xlsx')}</div></div></div>
  </div>
  <div class="if-egress"><Route reverse label={t('写入跟进记录','Write follow-up')} method="RESTful API"/></div>
  <div class="if-pane if-crm-return">
    <div class="if-bar"><Icon name="users" size={16}/><strong>CRM</strong><span>{t('客户时间线','Customer timeline')}</span></div>
    <div class="if-content"><div class="if-timeline"><strong>{t('设备巡检方案跟进','Inspection proposal follow-up')}</strong><p>{t('完善巡检服务方案；准备实施安排。','Refine the inspection proposal and implementation plan.')}</p><div class="if-file"><Icon name="file" size={14}/>{t('客户跟进摘要.docx','Customer follow-up brief.docx')}</div></div></div>
  </div>
  <div class="if-tool-branches">
    <div class="if-tool-branch"><div class="if-feed"><span>{t('调用工具','Use tools')}</span><i></i></div><div class="if-tool"><Icon name="plug" size={18}/><div><strong>{t('MCP 服务','MCP service')}</strong><span>{t('检索项目材料','Retrieve project materials')}</span></div></div></div>
    <div class="if-tool-branch"><div class="if-feed"><span>{t('查询数据','Query data')}</span><i></i></div><div class="if-tool"><Icon name="chart" size={18}/><div><strong>{t('业务数据库','Business database')}</strong><span>{t('经营数据查询结果','Business query results')}</span></div></div></div>
  </div>
</div>}
{scene === 0 && <div class="if-context-flow">
  <div class="if-source-heading">{t('现有业务系统','Existing business systems')}</div><div class="if-context-heading"><Icon name="layers" size={16}/><strong>{t('TeGo · 任务上下文','TeGo · Task context')}</strong></div>
  {context.map(item=><><div class="if-context-source"><Icon name={item.icon} size={19}/><div><strong>{item.system}</strong><span>{item.object}</span></div></div><div class="if-context-route"><Route label={item.method}/></div><div class="if-context-record"><Icon name={item.icon} size={15}/><div><strong>{item.result}</strong><span>{item.system}</span></div></div></>)}
  <div class="if-context-files"><Icon name="user-check" size={17}/><div><strong>{t('整理客户沟通与项目进展','Organize conversations and project progress')}</strong><div class="if-file"><Icon name="file-check" size={14}/>{t('商机跟进清单.xlsx','Deal follow-up list.xlsx')}</div></div></div>
</div>}
{scene === 1 && <div class="if-action-flow">
  <div class="if-action-input"><Icon name="file" size={17}/><div><strong>{t('客户交流纪要.docx','Customer meeting notes.docx')}</strong><p>{t('请补充设备巡检方案，下次交流重点看实施安排。','Expand the inspection proposal. Focus the next discussion on implementation.')}</p></div></div>
  <div class="if-action-read"><Route vertical label={t('读取沟通内容','Read conversations')} method={t('MCP / 文件工具','MCP / File tools')}/></div>
  <div class="if-pane if-action-task"><div class="if-bar if-brand"><Icon name="layers" size={17}/><strong>TeGo</strong><span>{t('客户跟进任务','Customer follow-up')}</span></div><div class="if-content"><div class="if-step-list">{[t('匹配客户与商机资料','Match customer and deal records'),t('归纳沟通结论','Organize discussion outcomes'),t('生成后续跟进事项','Prepare follow-up actions')].map(step=><div><span class="if-step-node"><Icon name="check" size={12}/></span><span>{step}</span></div>)}</div><div class="if-file"><Icon name="file-check" size={14}/>{t('商机行动清单.xlsx','Deal action list.xlsx')}</div></div></div>
  <div class="if-action-write"><Route label={t('写入业务记录','Write business record')} method="RESTful API"/></div>
  <div class="if-pane if-action-crm"><div class="if-bar"><Icon name="users" size={16}/><strong>CRM</strong><span>{t('客户时间线','Customer timeline')}</span></div><div class="if-content"><div class="if-timeline"><strong>{t('设备巡检方案跟进','Inspection proposal follow-up')}</strong><p>{t('完善巡检方案；准备实施安排，接续下一次交流。','Refine the inspection proposal and implementation plan for the next discussion.')}</p><div class="if-file"><Icon name="file" size={14}/>{t('客户跟进摘要.docx','Follow-up brief.docx')}</div></div></div></div>
  <div class="if-action-permission"><Icon name="key" size={14}/><span>{t('连接身份','Connection identity')}</span><span>{t('接口授权','API authorization')}</span><span>{t('业务委托','Business delegation')}</span></div>
</div>}
{scene === 2 && <div class="if-api-flow">
  <div class="if-pane if-api-business"><div class="if-bar"><Icon name="buildings" size={16}/><strong>{t('企业业务系统','Business system')}</strong></div><div class="if-content"><span class="if-field-label">{t('任务请求','Task request')}</span><p class="if-api-prompt">{t('根据项目附件编制服务方案，并整理交付事项清单。','Prepare a service proposal and delivery action list from the project attachments.')}</p><div class="if-file"><Icon name="file-check" size={14}/>{t('项目需求清单.xlsx','Project requirements.xlsx')}</div></div></div>
  <div class="if-api-send"><Route label={t('提交任务','Submit task')} method={t('平台 OpenAPI','Platform OpenAPI')}/></div>
  <div class="if-pane if-api-tego"><div class="if-bar if-brand"><Icon name="layers" size={17}/><strong>TeGo</strong><span>{t('数字员工任务','Digital employee task')}</span></div><div class="if-content"><div class="if-api-auth"><Icon name="key" size={15}/><div><strong>{t('绑定执行用户','Bound execution user')}</strong><span>scope · {t('幂等信息','Idempotency')}</span></div></div><div class="if-step-list">{[t('接收任务与项目资料','Receive task and project files'),t('编制方案与交付清单','Prepare proposal and action list'),t('返回状态、回应与成果','Return status, responses and results')].map(step=><div><span class="if-step-node"><Icon name="check" size={12}/></span><span>{step}</span></div>)}</div><div class="if-api-modes"><span>{t('同步','Sync')}</span><span>{t('异步','Async')}</span><span>{t('流式','Stream')}</span></div></div></div>
  <div class="if-api-receive"><Route reverse label={t('状态与成果','Status & results')} method={t('平台 OpenAPI','Platform OpenAPI')}/></div>
  <div class="if-pane if-api-result"><div class="if-bar"><Icon name="buildings" size={16}/><strong>{t('原业务入口','Original business app')}</strong></div><div class="if-content"><div class="if-return-types"><span>{t('执行状态','Task status')}</span><span>{t('人工事项与回应','Human work items & responses')}</span></div><div class="if-file"><Icon name="file" size={15}/>{t('项目服务方案.docx','Service proposal.docx')}</div><div class="if-file"><Icon name="file-check" size={15}/>{t('交付事项清单.xlsx','Delivery action list.xlsx')}</div></div></div>
</div>}
</div>
</figure>
<style>
.if-art{--if-line:#789bb72c;--if-muted:#9bb0c5;--if-panel:#101d2b;color:#d6e3ef;padding:8px 0;font-size:12px;line-height:1.6}.if-art::before{content:none}.if-art :global(svg){flex-shrink:0;stroke-width:1.5;color:#9fbdd7}.if-art :is(div,span){min-width:0}.if-art strong{font-size:12px;font-weight:550;line-height:1.6;color:#e0eaf4}.if-art p{font-size:12px;line-height:1.75;color:#b7c8d8;margin:0}.if-pane{border:1px solid #85a6c235;background:#101c29;border-radius:7px;box-shadow:0 16px 28px -20px #000a;overflow:hidden}.if-bar{display:flex;align-items:center;gap:8px;padding:12px 14px;min-height:44px;box-sizing:border-box;border-bottom:1px solid var(--if-line);background:#15243470}.if-bar>strong{font-size:12px}.if-bar>span{margin-left:auto;font-size:10px;color:#a4bbce;line-height:1.5}.if-brand{background:#1c334a66}.if-brand>strong{font-size:14px}.if-content{padding:16px}.if-content>strong{font-size:13px}.if-record-field{margin-top:15px}.if-record-field>span,.if-field-label{font-size:10px;color:#91abc3}.if-record-field p{margin-top:4px}.if-file{display:flex;align-items:center;gap:6px;font-size:10.5px;color:#b7cde0;line-height:1.6;margin-top:13px;overflow-wrap:anywhere}.if-file>svg{width:14px}.if-employee{display:flex;align-items:flex-start;gap:9px}.if-employee>svg{padding:6px;border-radius:6px;background:#253e575f;box-sizing:content-box}.if-employee>strong{font-size:13px}.if-request{margin-top:14px!important;padding-bottom:16px;border-bottom:1px solid var(--if-line)}.if-step-list{display:grid;gap:0;margin-top:16px}.if-step-list>div{display:flex;gap:9px;align-items:center;position:relative;padding:0 0 16px;font-size:11px;color:#c4d6e6}.if-step-list>div:not(:last-child)::after{content:'';position:absolute;left:9px;top:20px;bottom:0;width:1px;background:#7098b559}.if-step-list>div:last-child{padding-bottom:0}.if-step-node{width:19px;height:19px;border-radius:50%;display:grid;place-items:center;flex-shrink:0;background:#213b50;border:1px solid #8fb8d338}.if-task-output{margin-top:17px;padding-top:13px;border-top:1px solid var(--if-line)}.if-task-output>span{font-size:10px;color:#8faec7}.if-task-output .if-file{margin-top:8px}.if-timeline{padding-left:13px;border-left:1px solid #7ca6c15c;position:relative}.if-timeline::before{content:'';position:absolute;left:-3px;top:7px;width:5px;height:5px;border-radius:50%;background:#a6c8df}.if-timeline>strong{font-size:12px}.if-timeline p{margin-top:8px;font-size:11px}.if-crm-return,.if-api-result,.if-action-crm{background:#16283a;border-color:#8faec44a}
.if-hero-flow{display:grid;grid-template-columns:minmax(0,.92fr) 82px minmax(0,1.28fr);grid-template-rows:auto auto auto;gap:20px 0;align-items:stretch}.if-crm-source{grid-column:1;grid-row:1;align-self:end}.if-ingress{grid-column:2;grid-row:1;align-self:center}.if-tego-task{grid-column:3;grid-row:1/3}.if-crm-return{grid-column:1;grid-row:2;align-self:start}.if-egress{grid-column:2;grid-row:2;align-self:center}.if-ingress,.if-egress{padding-inline:8px}.if-tool-branches{grid-column:3;grid-row:3;display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:-20px}.if-feed{height:35px;position:relative;display:flex;align-items:center;justify-content:center}.if-feed>span{font-size:10px;color:#97b4ce;position:relative;z-index:1;background:#0b141e;padding:0 5px}.if-feed>i{position:absolute;height:100%;width:1px;background:#719bbd;left:50%;top:0}.if-feed>i::before{content:'';position:absolute;left:-3px;bottom:1px;width:6px;height:6px;border-right:1.5px solid #a9d2f3;border-bottom:1.5px solid #a9d2f3;transform:rotate(45deg)}.if-feed>i::after{content:'';position:absolute;left:-3px;top:1px;width:6px;height:6px;border-left:1.5px solid #a9d2f3;border-top:1.5px solid #a9d2f3;transform:rotate(45deg)}.if-tool{display:flex;align-items:center;gap:9px;border:1px solid #7398b633;border-radius:6px;padding:12px 10px;background:#101d2b}.if-tool strong{font-size:11px}.if-tool span{font-size:10px;color:#9bb4cb;display:block;margin-top:3px}
.if-context-flow{display:grid;grid-template-columns:minmax(0,.88fr) 84px minmax(0,1.24fr);row-gap:13px;align-items:stretch}.if-source-heading{grid-column:1;font-size:11px;color:#a4bbce;align-self:center;padding-left:12px}.if-context-heading{grid-column:3;display:flex;align-items:center;gap:8px;padding:12px 14px;background:#1a3045;border:1px solid #84aaca40;border-radius:6px}.if-context-heading strong{font-size:13px}.if-context-source{display:flex;align-items:center;gap:11px;padding:13px 12px;border:1px solid #7c9cb32b;border-radius:6px;background:#101c29}.if-context-source strong{font-size:12px}.if-context-source span{font-size:10px;color:#9db4c8;display:block;margin-top:4px}.if-context-route{display:flex;align-items:center;padding:0 8px}.if-context-record{display:flex;align-items:center;gap:9px;padding:13px 14px;background:#152536;border:1px solid #7ca2bf30;border-radius:5px}.if-context-record strong{font-size:11.5px}.if-context-record span{font-size:10px;color:#91adc5;display:block;margin-top:4px}.if-context-files{grid-column:3;display:flex;gap:9px;padding:13px 4px 0;border-top:1px solid #658eaa65;position:relative}.if-context-files::before{content:'';position:absolute;left:50%;top:-14px;height:13px;width:1px;background:#719bbd}.if-context-files strong{font-size:11px}.if-context-files .if-file{margin-top:7px}
.if-action-flow{display:grid;grid-template-columns:minmax(0,1.12fr) 82px minmax(0,1fr);align-items:center}.if-action-input{grid-column:1/-1;display:flex;align-items:flex-start;gap:10px;padding:16px;border:1px solid #88a6be35;border-radius:6px;background:#101c29;max-width:85%}.if-action-input>svg{margin-top:2px}.if-action-input p{margin-top:7px;font-size:11px}.if-action-read{grid-column:1}.if-action-task{grid-column:1;align-self:stretch}.if-action-task .if-step-list{margin-top:0}.if-action-task .if-step-list>div{padding-bottom:22px}.if-action-task .if-step-list>div:last-child{padding-bottom:0}.if-action-task .if-file{padding-top:15px;border-top:1px solid var(--if-line);margin-top:18px}.if-action-write{grid-column:2;padding:0 8px}.if-action-crm{grid-column:3;align-self:stretch}.if-action-permission{grid-column:1/-1;display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:20px;padding:12px 15px;border-top:1px solid var(--if-line);font-size:10px;color:#91adc5}.if-action-permission>span+span{border-left:1px solid #66849c6b;padding-left:12px}
.if-api-flow{display:grid;grid-template-columns:minmax(0,1fr) 90px minmax(0,1.1fr);gap:20px 0;align-items:stretch}.if-api-business{grid-column:1;grid-row:1}.if-api-send{grid-column:2;grid-row:1;display:flex;align-items:center;padding:0 8px}.if-api-tego{grid-column:3;grid-row:1/3}.if-api-result{grid-column:1;grid-row:2}.if-api-receive{grid-column:2;grid-row:2;display:flex;align-items:center;padding:0 8px}.if-api-prompt{margin-top:7px!important}.if-api-auth{display:flex;align-items:center;gap:9px;padding-bottom:17px;border-bottom:1px solid var(--if-line)}.if-api-auth strong{font-size:11px}.if-api-auth span{display:block;font-size:10px;color:#92afc7;margin-top:3px}.if-api-tego .if-step-list{margin-top:23px}.if-api-tego .if-step-list>div{padding-bottom:28px}.if-api-tego .if-step-list>div:last-child{padding-bottom:0}.if-api-modes{display:flex;justify-content:space-between;gap:10px;padding-top:16px;margin-top:23px;border-top:1px solid var(--if-line);color:#adcce2;font-size:11px}.if-api-modes>span+span{padding-left:14px;border-left:1px solid var(--if-line)}.if-return-types{display:flex;flex-wrap:wrap;gap:7px 11px;font-size:10px;color:#a4bdcf;margin-bottom:13px}.if-api-result .if-file{font-size:10.5px;margin-top:9px}
:global([data-capability="integrations"] .cp-hero:lang(en) h1 span){white-space:normal}:global([data-capability="integrations"] .cp-hero-field){background:linear-gradient(128deg,rgba(13,30,49,.7),transparent 45%),linear-gradient(24deg,transparent 60%,rgba(73,51,112,.19))}:global([data-capability="integrations"] .cp-hero-field::before){content:none}:global([data-capability="integrations"] .cp-hero){position:relative;z-index:1}
