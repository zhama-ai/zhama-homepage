---
import Layout from '../layouts/Layout.astro';
---
<Layout locale="zh" title="页面未找到" description="访问 TeGo 官网，查阅产品、资源与下载。" page="404" noindex><section class="not-found container"><h1>这个页面已不在这里。</h1><p>从官网首页继续查找产品、文档和下载资源。</p><a class="button" href="/zh/">返回首页</a></section></Layout>
<script is:inline>
  {
    const language = /^\/en(?:\/|$)/i.test(location.pathname) ? 'en' : /^\/zh-hant(?:\/|$)/i.test(location.pathname) ? 'zh-Hant' : '';
    if (language && location.pathname !== `/${language}/404/`) location.replace(`/${language}/404/`);
  }
</script>
