---
import Layout from '../layouts/Layout.astro';
import NotFoundPage from '../components/ui/NotFoundPage.astro';
---
<Layout locale="zh" title="页面未找到" description="访问 TeGo 官网，查阅产品、资源与下载。" page="404" noindex><NotFoundPage locale="zh"/></Layout>
<script is:inline>
  {
    const language = /^\/en(?:\/|$)/i.test(location.pathname) ? 'en' : /^\/zh-hant(?:\/|$)/i.test(location.pathname) ? 'zh-Hant' : '';
    if (language && location.pathname !== `/${language}/404/`) location.replace(`/${language}/404/`);
  }
</script>
