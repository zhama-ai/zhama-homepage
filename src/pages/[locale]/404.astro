---
import Layout from '../../layouts/Layout.astro';
import { locales } from '../../lib/site';
import type { Locale } from '../../data/types';
import NotFoundPage from '../../components/ui/NotFoundPage.astro';

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale }, props: { locale } }));
}
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const title = zh ? '页面未找到' : 'Page not found';
const description = zh ? '访问 TeGo 官网，查阅产品、资源与下载。' : 'Visit the TeGo website for products, resources and downloads.';
---
<Layout locale={locale} title={title} description={description} page="404" noindex><NotFoundPage {locale}/></Layout>
