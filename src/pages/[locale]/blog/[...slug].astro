---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ArticleCard from '../../../components/ui/ArticleCard.astro';
import { pathFor } from '../../../lib/site';
import '../../../styles/blog.css';
import '../../../styles/reading.css';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  return entries.map((entry) => ({
    params: { locale: entry.data.locale, slug: entry.data.legacySlug },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'blog'>; }
const { entry } = Astro.props;
const { data } = entry;
const locale = data.locale;
const zh = locale === 'zh';
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat(zh ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).format(data.date);
const related = (await getCollection('blog', ({ data: other }) => other.locale === locale && other.legacySlug !== data.legacySlug))
  .sort((left, right) => Number(right.data.category === data.category) - Number(left.data.category === data.category) || right.data.date.getTime() - left.data.date.getTime())
  .slice(0, 3);
---
<Layout locale={locale} title={data.title} description={data.description} page={`blog/${data.legacySlug}`} socialImage={data.image} article={{ author: data.author, authorType: 'Organization', published: data.date.toISOString(), section: data.category, tags: data.tags }}>
  <div class="container">
    <article class="article-shell ui-reading">
      <a class="text-link" href={pathFor(locale, 'blog')}>{zh ? '返回产品博客' : 'Back to blog'}</a>
      <h1 class="ui-display">{data.title}</h1>
      <div class="article-meta ui-meta"><time datetime={data.date.toISOString()}>{date}</time><span>{data.category}</span><span>{data.author}</span></div>
      <p class="article-historical ui-meta">{zh ? `本文发布于 ${date}。产品当前能力参见` : `Published ${date}. For current capabilities, see the `}<a href={pathFor(locale, 'product')}>{zh ? '产品能力' : 'product overview'}</a>{zh ? '。' : '.'}</p>
      {data.image && <img class="article-cover" src={data.image} alt={data.title} width="1200" height="750" decoding="async" />}
      <div class="prose"><Content/></div>
      <nav class="article-tags" aria-label={zh ? '文章标签' : 'Article tags'}>{data.tags.map((tag) => <span>{tag}</span>)}</nav>
    </article>
    <section class="article-related" aria-labelledby="related-title">
      <h2 class="ui-section-title" id="related-title">{zh ? '继续阅读' : 'Keep reading'}</h2>
      <div class="article-grid">
        {related.map(({ data: post }) => <ArticleCard title={post.title} description={post.description} category={post.category}
          datetime={post.date.toISOString()} date={post.date.toISOString().slice(0, 10)}
          href={pathFor(locale, `blog/${post.legacySlug}`)} level={3} />)}
      </div>
    </section>
  </div>
</Layout>

<style>
  .article-historical a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
  .article-tags{display:flex;flex-wrap:wrap;gap:var(--space-2);margin-top:var(--space-8)}
  .article-tags span{font-size:var(--type-meta);color:var(--color-meta);padding:var(--space-1) var(--space-3);background:var(--soft);border-radius:var(--radius-card)}
  .prose :global(.article-diagram){margin:var(--space-6) 0;padding:var(--space-card);background:var(--surface-card);border-radius:var(--radius-card);overflow:auto}
  .prose :global(.article-diagram-output){text-align:center;min-width:0}
  .prose :global(.article-diagram-output svg){height:auto;max-width:100%}
  .prose :global(.article-diagram details){font-size:var(--type-meta);color:var(--color-meta);margin-top:var(--space-4)}
  .prose :global(.article-diagram summary){cursor:pointer;width:fit-content}
  .prose :global(.article-diagram pre){margin-bottom:0;padding-inline:0}
  .prose :global(.article-diagram-status){font-size:var(--type-meta);line-height:var(--leading-body);color:var(--color-meta)}
  .prose :global(.article-diagram-output[hidden]),.prose :global(.article-diagram-status[hidden]){display:none}
</style>

<script>
  import { onPageMount } from '../../../lib/page-lifecycle';
  let diagramMount = 0;
  async function initializeArticleDiagrams(signal: AbortSignal) {
    const blocks = Array.from(document.querySelectorAll<HTMLPreElement>('.prose pre[data-language="mermaid"]'));
    if (!blocks.length) return;
    const zh = document.documentElement.lang.startsWith('zh');
    let mermaid: (typeof import('mermaid'))['default'];
    try {
      mermaid = (await import('mermaid')).default;
    } catch (error) {
      if (signal.aborted) return;
      blocks.forEach((block) => {
        const status = document.createElement('p');
        status.className = 'article-diagram-status';
        status.setAttribute('role', 'status');
        status.textContent = zh ? '流程图组件未能载入，原始图表文本保留在下方。' : 'The diagram renderer could not load. The original diagram text is available below.';
        block.before(status);
      });
      console.warn('Article diagram renderer could not load.', error);
      return;
    }
    if (signal.aborted) return;

    const diagrams = blocks.map((block, index) => {
      const source = block.textContent || '';
      const figure = document.createElement('figure');
      figure.className = 'article-diagram';
      const output = document.createElement('div');
      output.className = 'article-diagram-output';
      output.hidden = true;
      const status = document.createElement('p');
      status.className = 'article-diagram-status';
      status.setAttribute('role', 'status');
      status.hidden = true;
      const details = document.createElement('details');
      details.open = true;
      const summary = document.createElement('summary');
      summary.textContent = zh ? '查看图表源文本' : 'View diagram source';
      details.append(summary);
      block.replaceWith(figure);
      details.append(block);
      figure.append(output, status, details);
      return { source, index, output, status, details };
    });

    let rendering = false;
    let redrawRequested = false;
    let revision = 0;
    const renderId = `tego-article-${++diagramMount}`;
    async function drawDiagrams() {
      if (signal.aborted) return;
      if (rendering) { redrawRequested = true; return; }
      rendering = true;
      try {
        do {
          redrawRequested = false;
          revision += 1;
          const dark = document.documentElement.dataset.theme === 'dark';
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            suppressErrorRendering: true,
            htmlLabels: false,
            theme: dark ? 'dark' : 'default',
            fontFamily: '"Plus Jakarta Sans Variable", "PingFang SC", sans-serif',
          });
          for (const diagram of diagrams) {
            if (signal.aborted) return;
            try {
              const { svg } = await mermaid.render(`${renderId}-${revision}-${diagram.index}`, diagram.source);
              if (signal.aborted) return;
              diagram.output.innerHTML = svg;
              diagram.output.querySelector('svg')?.setAttribute('aria-label', zh ? `文章流程图 ${diagram.index + 1}` : `Article diagram ${diagram.index + 1}`);
              diagram.output.hidden = false;
              diagram.status.hidden = true;
              diagram.details.open = false;
            } catch (error) {
              if (signal.aborted) return;
              diagram.output.hidden = true;
              diagram.status.textContent = zh ? '这幅流程图未能绘制，原始图表文本保留在下方。' : 'This diagram could not be drawn. Its original source is available below.';
              diagram.status.hidden = false;
              diagram.details.open = true;
              console.warn(`Article diagram ${diagram.index + 1} could not be rendered.`, error);
            }
          }
        } while (redrawRequested && !signal.aborted);
      } finally {
        rendering = false;
      }
    }
    await drawDiagrams();
    if (signal.aborted) return;
    const observer = new MutationObserver(() => { void drawDiagrams(); });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    signal.addEventListener('abort', () => observer.disconnect(), { once: true });
  }

  onPageMount(signal => { void initializeArticleDiagrams(signal); });
</script>
