---
import type { Locale } from '../../../data/types';
import Icon from '../../../components/Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
const portrait = '/images/product/digital-employees/employee-portrait-public-service_V1.1.webp';
const report = [
  { title: t('本周进展', 'Progress'), text: t('测试环境接口联调完成', 'Test-environment integration completed') },
  { title: t('待跟进', 'Open item'), text: t('数据迁移窗口尚未确认', 'Data migration window unconfirmed') },
  { title: t('下周安排', 'Next week'), text: t('确认迁移排期与配合人员', 'Confirm the migration schedule and owners') },
];
---
<div class:list={['continuity-art', { 'continuity-art-en': !zh }]} data-continuity-art aria-hidden="true">
  <svg class="continuity-connections" aria-hidden="true"><defs><marker id={`continuity-tip-${locale}`} markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M1 1L6 4 1 7" fill="none" stroke="#8ab4db" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></marker></defs><path class="feedback-connection" marker-end={`url(#continuity-tip-${locale})`}/><path class="followup-connection" marker-end={`url(#continuity-tip-${locale})`}/></svg>

  <div class="assignment-conversation">
    <div class="conversation-person"><span class="human-avatar"><Icon name="users" size={17}/></span><strong>{t('项目负责人', 'Project owner')}</strong><span>{t('交办工作', 'Assign work')}</span></div>
    <div class="assignment-message">
      <p>{t('整理本周项目周报，汇总进展、风险和下周安排。', 'Prepare this week’s project report: progress, risks, and next steps.')}</p>
      <div class="assignment-files"><span><Icon name="chart" size={17}/>{t('项目进展.xlsx', 'Project progress.xlsx')}</span><span><Icon name="file" size={17}/>{t('周报编制规范.md', 'Report guide.md')}</span></div>
    </div>
  </div>

  <div class="handoff-arrow"><svg viewBox="0 0 80 100" preserveAspectRatio="none"><defs><linearGradient id={`continuity-in-${locale}`}><stop stop-color="#61a6d9" stop-opacity="0"/><stop offset=".6" stop-color="#70b4e0" stop-opacity=".45"/><stop offset="1" stop-color="#9ad1f0"/></linearGradient></defs><path d="M0 8C19 31 29 42 56 43V30L80 50 56 70V57C29 58 19 69 0 92Z" fill={`url(#continuity-in-${locale})`}/></svg></div>

  <div class="employee-execution" data-continuity-execution>
    <div class="execution-person"><img src={portrait} width="56" height="56" alt="" loading="lazy"/><strong>{t('项目周报专员', 'Project reporting specialist')}</strong></div>
    <div class="employee-reply">{t('收到，按周报规范整理。', 'Received. I’ll follow the report guide.')}</div>
    <div class="execution-actions">{[t('读取进度资料', 'Read the progress files'), t('归集进展与风险', 'Consolidate progress and risks'), t('编制周报草稿', 'Draft the weekly report')].map(text => <span><Icon name="check" size={14}/>{text}</span>)}</div>
  </div>

  <div class="handoff-arrow"><svg viewBox="0 0 80 100" preserveAspectRatio="none"><defs><linearGradient id={`continuity-out-${locale}`}><stop stop-color="#61a6d9" stop-opacity="0"/><stop offset=".6" stop-color="#70b4e0" stop-opacity=".45"/><stop offset="1" stop-color="#9ad1f0"/></linearGradient></defs><path d="M0 8C19 31 29 42 56 43V30L80 50 56 70V57C29 58 19 69 0 92Z" fill={`url(#continuity-out-${locale})`}/></svg></div>

  <div class="report-delivery">
    <div class="delivery-label"><Icon name="file-check" size={17}/><strong>{t('回交草稿，供负责人审阅', 'Return a draft for the owner to review')}</strong></div>
    <div class="report-preview">
      <div class="report-name"><Icon name="file" size={21}/><strong>{t('项目周报.docx', 'Project weekly report.docx')}</strong></div>
      <dl class="report-content">{report.map(row => <div><dt>{row.title}</dt><dd>{row.text}</dd></div>)}</dl>
    </div>
    <div class="review-feedback" data-continuity-review>
      <span class="human-avatar"><Icon name="users" size={15}/></span>
      <div><strong>{t('负责人反馈', 'Owner’s feedback')}</strong><p>{t('沿用测试环境口径，迁移窗口下周继续跟进。', 'Keep the test-environment scope. Follow up on the migration window next week.')}</p></div>
    </div>
  </div>

  <div class="next-assignment" data-continuity-followup>
    <div class="followup-heading"><span><Icon name="clock" size={17}/>{t('已配置 · 每周五', 'Scheduled · Every Friday')}</span><strong>{t('继续生成下一轮周报', 'Prepare the next weekly report')}</strong></div>
    <div class="followup-inputs">
      <span class="latest-progress"><Icon name="chart" size={17}/>{t('最新项目进展.xlsx', 'Latest project progress.xlsx')}</span>
      <div class="retained-context"><span><Icon name="book" size={16}/>{t('工作记忆', 'Work memory')}</span><p>{t('测试环境口径 · 迁移窗口待确认', 'Test-environment scope · Migration window pending')}</p></div>
    </div>
    <div class="followup-reply"><img src={portrait} width="30" height="30" alt="" loading="lazy"/><p><strong>{t('项目周报专员', 'Project reporting specialist')}</strong><span>{t('沿用上轮口径，继续跟进迁移窗口。', 'I’ll use the agreed scope and follow up on the migration window.')}</span></p></div>
  </div>
</div>

<script>
  import { onPageMount } from '../../../lib/page-lifecycle';
  onPageMount(signal => {
    document.querySelectorAll<HTMLElement>('[data-continuity-art]').forEach(root => {
      if (root.dataset.connectionsReady) return;
      const svg = root.querySelector<SVGSVGElement>('.continuity-connections');
      const review = root.querySelector<HTMLElement>('[data-continuity-review]');
      const followup = root.querySelector<HTMLElement>('[data-continuity-followup]');
      const execution = root.querySelector<HTMLElement>('[data-continuity-execution]');
      const feedbackPath = root.querySelector<SVGPathElement>('.feedback-connection');
      const followupPath = root.querySelector<SVGPathElement>('.followup-connection');
      if (!svg || !review || !followup || !execution || !feedbackPath || !followupPath) return;
      root.dataset.connectionsReady = 'true';
      function drawConnections() {
        if (signal.aborted || !root.isConnected) return;
        if (!svg || !review || !followup || !execution || !feedbackPath || !followupPath) return;
        const box = root.getBoundingClientRect();
        const from = review.getBoundingClientRect();
        const next = followup.getBoundingClientRect();
        const employee = execution.getBoundingClientRect();
        svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
        if (window.matchMedia('(max-width: 900px)').matches) {
          const x = next.left - box.left + next.width / 2;
          feedbackPath.setAttribute('d', `M${x} ${from.bottom - box.top + 5}V${next.top - box.top - 9}`);
          followupPath.removeAttribute('d');
        } else {
          const startX = from.left - box.left + from.width * .55;
          const startY = from.bottom - box.top + 6;
          const endX = next.right - box.left + 10;
          const endY = next.top - box.top + next.height * .52;
          const radius = Math.min(24, (endY - startY) / 2);
          feedbackPath.setAttribute('d', `M${startX} ${startY}V${endY - radius}Q${startX} ${endY} ${startX - radius} ${endY}H${endX}`);
          const returnX = employee.left - box.left + employee.width / 2;
          followupPath.setAttribute('d', `M${returnX} ${next.top - box.top - 5}V${employee.bottom - box.top + 12}`);
        }
      }
      const observer = new ResizeObserver(drawConnections);
      [root, review, followup, execution].forEach(element => observer.observe(element));
      drawConnections();
      document.fonts.ready.then(drawConnections);
      signal.addEventListener('abort', () => {
        observer.disconnect();
        delete root.dataset.connectionsReady;
      }, { once: true });
    });
  });
</script>

<style>
  .continuity-art { position:relative; isolation:isolate; display:grid; grid-template-columns:minmax(0,1fr) 68px minmax(0,.78fr) 68px minmax(0,1.15fr); gap:36px 18px; align-items:center; padding:22px 5px 18px; color:#bed0e2; font-size:13px; line-height:1.6; }
  .continuity-art::before { content:''; position:absolute; z-index:-2; inset:9% 14% 20%; background:radial-gradient(ellipse at 50% 45%,#2476ad22,transparent 69%); filter:blur(26px); pointer-events:none; }
  .continuity-art :global(svg) { flex-shrink:0; }
  .continuity-art strong { font-weight:550; }
  .continuity-connections { position:absolute; inset:0; z-index:-1; width:100%; height:100%; overflow:visible; pointer-events:none; }
  .continuity-connections>path { stroke:#77a6cfaa; fill:none; stroke-width:1.5; stroke-dasharray:6 6; }
  .conversation-person { display:flex; align-items:center; gap:9px; margin-bottom:12px; font-size:13px; }
  .conversation-person>span:last-child { margin-left:auto; color:#8aaac6; font-size:12px; }
  .human-avatar { display:inline-grid; place-items:center; width:28px; height:28px; flex-shrink:0; border-radius:50%; color:#a6c5e2; background:#8db4da10; }
  .assignment-message { position:relative; padding:20px 19px; border:1px solid #85b5de38; border-radius:4px 12px 12px 12px; background:linear-gradient(135deg,#1d3851,#152638); box-shadow:0 12px 30px -12px #000b,0 2px 9px #0004; }
  .assignment-message>p { margin:0; color:#deebf6; font-size:15px; line-height:1.85; }
  .assignment-files { display:grid; gap:9px; margin-top:18px; }
  .assignment-files>span { display:flex; align-items:center; gap:8px; color:#a9bfd3; font-size:12px; }
  .assignment-files :global(svg) { color:#91b9d4; }
  .handoff-arrow { height:124px; }
  .handoff-arrow>svg { display:block; width:100%; height:100%; }
  .employee-execution { position:relative; padding:20px 1px; }
  .employee-execution::before { content:''; position:absolute; z-index:-1; inset:0 -20px; background:radial-gradient(ellipse at 50% 40%,#3287bd2b,transparent 73%); filter:blur(16px); }
  .execution-person { display:flex; align-items:center; gap:10px; }
  .execution-person>img { width:48px; height:48px; object-fit:cover; border-radius:8px; box-shadow:0 8px 19px -5px #000c,0 0 15px #4479a426; }
  .execution-person>strong { color:#e5f0fa; font-size:16px; line-height:1.6; }
  .employee-reply { position:relative; margin-top:17px; padding:12px 13px; border-radius:4px 9px 9px 9px; color:#cbe1f1; background:#24415b80; font-size:13px; line-height:1.75; }
  .execution-actions { display:grid; gap:11px; margin-top:19px; }
  .execution-actions>span { display:flex; align-items:center; gap:8px; font-size:12px; color:#a7c0d4; }
  .execution-actions :global(svg) { color:#8fc4b9; }
  .delivery-label { display:flex; align-items:center; gap:7px; margin-bottom:12px; color:#a8c6df; font-size:13px; }
  .delivery-label :global(svg) { color:#93bacd; }
  .report-preview { padding:20px; border:1px solid #a6bed34a; border-radius:8px; color:#c8d7e5; background:linear-gradient(145deg,#20374c,#162535 75%); box-shadow:0 18px 34px -15px #000e,0 3px 12px #0005; }
  .report-name { display:flex; align-items:center; gap:9px; color:#e0eaf6; }
  .report-name>strong { font-size:15px; overflow-wrap:anywhere; }
  .report-name :global(svg) { color:#a5b7de; }
  .report-content { display:grid; gap:13px; margin:17px 0 0; padding-top:16px; border-top:1px solid #abc5db20; }
  .report-content>div { display:grid; grid-template-columns:60px minmax(0,1fr); gap:10px; align-items:baseline; }
  .report-content dt { color:#8faac1; font-size:11px; }
  .report-content dd { margin:0; color:#c4d4e2; font-size:12px; line-height:1.8; }
  .review-feedback { position:relative; display:flex; gap:8px; margin:15px 0 0 10px; padding:13px 14px 13px 10px; border-radius:10px 4px 10px 10px; background:#162d3a; box-shadow:0 7px 19px -9px #0009; }
  .review-feedback .human-avatar { width:24px; height:24px; color:#a4c9c6; background:#8ab5b712; }
  .review-feedback strong { display:block; color:#a8c8c9; font-size:11px; }
  .review-feedback p { margin:5px 0 0; color:#c0d5df; font-size:12px; line-height:1.8; }
  .next-assignment { grid-column:1/4; position:relative; margin-top:2px; padding:17px 19px; border:1px solid #789fc93d; border-radius:7px; background:linear-gradient(120deg,#172c40,#101f2e); box-shadow:0 10px 26px -13px #000c; }
  .followup-heading { display:flex; flex-wrap:wrap; align-items:center; gap:8px 20px; }
  .followup-heading>span { display:flex; align-items:center; gap:7px; color:#9cbedb; font-size:12px; }
  .followup-heading>strong { color:#dae7f3; font-size:14px; }
  .followup-inputs { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.2fr); gap:20px; margin-top:16px; align-items:center; }
  .latest-progress { display:flex; align-items:center; gap:8px; color:#b7cee1; font-size:12px; }
  .latest-progress :global(svg) { color:#8cb3d0; }
  .retained-context { padding-left:18px; border-left:1px solid #91aec22b; }
  .retained-context>span { display:flex; align-items:center; gap:6px; color:#b0bdd7; font-size:11px; }
  .retained-context p { margin:5px 0 0; color:#a2b7ce; font-size:11px; line-height:1.8; }
  .followup-reply { display:flex; align-items:center; gap:10px; margin-top:17px; padding-top:14px; border-top:1px solid #91aec21c; }
  .followup-reply img { width:30px; height:30px; object-fit:cover; flex-shrink:0; border-radius:5px; box-shadow:0 4px 10px #0005; }
  .followup-reply p { display:flex; flex-wrap:wrap; gap:4px 12px; margin:0; font-size:12px; }
  .followup-reply strong { color:#b0c9df; }
  .followup-reply span { color:#c9dce9; }
  @media(max-width:1050px) and (min-width:901px) {
    .continuity-art { grid-template-columns:minmax(0,1fr) 36px minmax(0,.8fr) 36px minmax(0,1.12fr); column-gap:12px; }
    .assignment-message { padding:17px 14px; }
    .assignment-message>p { font-size:14px; }
    .execution-person { flex-direction:column; align-items:flex-start; gap:9px; }
    .execution-person>strong { font-size:14px; }
    .employee-reply { padding:10px; font-size:12px; }
    .report-preview { padding:16px 13px; }
    .report-content>div { grid-template-columns:1fr; gap:3px; }
    .report-content { gap:10px; }
    .report-name>strong { font-size:13px; }
    .review-feedback { margin-left:0; padding:11px 9px; }
    .next-assignment { grid-column:1/5; }
  }
  @media(max-width:900px) {
    .continuity-art { grid-template-columns:minmax(0,1fr); max-width:580px; margin-inline:auto; row-gap:22px; padding:8px 3px 12px; }
    .continuity-art::before { inset:12% 0 20%; }
    .handoff-arrow { height:48px; position:relative; }
    .handoff-arrow>svg { position:absolute; width:50px; height:126px; left:50%; top:50%; transform:translate(-50%,-50%) rotate(90deg); }
    .assignment-message { padding:20px; }
    .assignment-message>p { font-size:15px; }
    .employee-execution { width:min(280px,100%); box-sizing:border-box; justify-self:center; padding:6px 3px; }
    .execution-person>img { width:48px; height:48px; }
    .employee-reply { margin-top:14px; }
    .execution-actions { margin-top:16px; }
    .report-preview { padding:20px; }
    .report-content>div { grid-template-columns:64px minmax(0,1fr); }
    .review-feedback { margin-left:10px; }
    .next-assignment { grid-column:1; margin-top:22px; padding:18px 16px; }
    .followup-inputs { grid-template-columns:1fr; gap:14px; }
    .retained-context { padding:0; border-left:0; }
    .retained-context p { font-size:12px; }
  }
</style>
