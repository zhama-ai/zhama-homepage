---
import { pathFor, site, ui } from '../../../lib/site';
import EmployeeMarketArt from './EmployeeMarketArt.astro';
import ProductHeroArt from '../../../components/product/ProductHeroArt.astro';
import EmployeeBannerBackdrop from './EmployeeBannerBackdrop.astro';
import EmployeeFeatureArt from './EmployeeFeatureArt.astro';
import EmployeeConfigurationArt from './EmployeeConfigurationArt.astro';
import Icon from '../../../components/Icon.astro';
import experience from './experience';
import landing from './landing';
import type { Locale } from '../../../data/types';
import '../../../styles/digital-employee-reading.css';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const copy = landing[locale];
const scenes = experience[locale];
const product = 'product/digital-employees';
const compositionParts = zh ? [
  {
    "icon": "user-check",
    "title": "岗位职责 · IDENTITY",
    "body": "明确员工身份、角色与适用范围。"
  },
  {
    "icon": "shield",
    "title": "行为与边界 · SOUL",
    "body": "约束行为准则、禁止事项与需人工确认的节点。"
  },
  {
    "icon": "cpu",
    "title": "Agent 与专业技能 · AGENTS",
    "body": "Agent 承担执行、调用技能，按岗位需要编排主 / 子 Agent 协作。"
  },
  {
    "icon": "wrench",
    "title": "工具使用规则 · TOOLS",
    "body": "规定可用插件、业务系统与调用边界。"
  },
  {
    "icon": "book",
    "title": "企业知识与业务系统",
    "body": "知识按授权检索，插件与业务系统按配置和授权接入。"
  },
  {
    "icon": "folder",
    "title": "工作区与工作记忆",
    "body": "保存文件、会话与业务成果，工作记忆按使用者隔离。"
  }
] : [
  { icon: 'user-check', title: 'Role responsibilities · IDENTITY', body: 'Define the employee’s identity, role, and scope.' },
  { icon: 'shield', title: 'Behavior and boundaries · SOUL', body: 'Define conduct, prohibited actions, and points requiring human confirmation.' },
  { icon: 'cpu', title: 'Agent and specialist skills · AGENTS', body: 'Agents execute work, call skills, and coordinate main and sub-Agents as the role requires.' },
  { icon: 'wrench', title: 'Tool rules · TOOLS', body: 'Define available plugins, business systems, and tool-use boundaries.' },
  { icon: 'book', title: 'Knowledge and business systems', body: 'Search knowledge within permissions. Connect plugins and systems with configuration and authorization.' },
  { icon: 'folder', title: 'Workspace and work memory', body: 'Keep files, conversations, and deliverables, with work memory isolated by user.' },
];
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: zh ? '首页' : 'Home', item: new URL(pathFor(locale), site.origin).href },
    { '@type': 'ListItem', position: 2, name: zh ? '产品能力' : 'Product', item: new URL(pathFor(locale, 'product'), site.origin).href },
    { '@type': 'ListItem', position: 3, name: copy.hero.lines[0], item: new URL(pathFor(locale, product), site.origin).href },
  ],
};
---
<div class="employee-page" data-capability="digital-employees">
  <div class="employee-hero-banner">
    <EmployeeBannerBackdrop locale={locale}/>
  <section class="employee-hero employee-wrap product-banner" aria-labelledby="capability-title">
    <div class="employee-hero-intro">
      <h1 id="capability-title">{copy.hero.lines[0]}</h1>
      <div class="employee-hero-copy">
        <p>{copy.hero.summary}</p>
        <a class="button employee-action" href={pathFor(locale, 'contact')}>{ui[locale].contact}</a>
      </div>
    </div>
    <ProductHeroArt canvasWidth={880}><figure class="employee-hero-art">
      <EmployeeMarketArt locale={locale}/>
    </figure></ProductHeroArt>
  </section>
  </div>

  <div class="employee-work employee-wrap">
    {scenes.sections.map(scene => {
      const { id, title, body } = scene;
      const subtitle = 'subtitle' in scene ? scene.subtitle : undefined;
      return (
        <section id={`capability-${id}`} class:list={['employee-story', `employee-story-${id}`]} aria-labelledby={`capability-${id}-title`}>
          <div class="employee-story-text">
            <h2 id={`capability-${id}-title`}>{zh ? title.split('，').map((phrase, index, phrases) => <span class="employee-title-phrase">{phrase}{index < phrases.length - 1 ? '，' : ''}</span>) : title}</h2>
            {id === 'work' ? <p class="employee-composition-description">{body}</p> : <>{subtitle && <p class="employee-story-subtitle">{subtitle}</p>}<p class="employee-story-body">{body}</p></>}
          </div>
          {id === 'work' && <dl class="employee-composition-parts">
            {compositionParts.map(part => <div><dt><Icon name={part.icon} size={18}/><span>{part.title}</span></dt><dd>{part.body}</dd></div>)}
          </dl>}
          <figure class="employee-story-art">
            <EmployeeFeatureArt locale={locale} scene={id}/>
          </figure>
        </section>
      );
    })}
  </div>

  <section id="capability-management" class="employee-management employee-wrap" aria-labelledby="capability-features-title">
    <div class="employee-management-intro">
      <h2 id="capability-features-title">{zh ? '数字员工的配置与运行，统一管理' : 'Manage digital employee configuration and operations'}</h2>
      <p class="employee-story-subtitle">{zh ? '岗位文件、技能、知识与插件按需配置，员工授权、启停状态与任务计划集中管理，运行与投递记录沿任务可查。' : 'Configure role files, skills, knowledge, and plugins. Manage employee access, enablement, and schedules, with run and delivery records traceable by task.'}</p>
    </div>
    <div class="employee-management-layout">
      <div class="employee-management-visual"><EmployeeConfigurationArt locale={locale}/></div>
      <dl class="employee-management-summary">
        {copy.features.map(feature => <div><dt><Icon name={feature.icon} size={18}/>{feature.title}</dt><dd>{feature.body}</dd></div>)}
      </dl>
    </div>
  </section>
</div>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}/>
