---
import Icon from '../../../components/Icon.astro';
import type { Locale } from '../../../data/types';
import { employeeArtworkFor } from './employee-artwork';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const employees = employeeArtworkFor(locale);
const backdrop = [...employees, ...employees, ...employees];
---
  <div class="employee-banner-backdrop" aria-hidden="true">
    <div class="market-card-field">
      {backdrop.map(employee => <div class="market-background-card">
        <div class="market-background-heading">
          <img src={`/images/product/digital-employees/employee-portrait-${employee.portrait}_V1.1.webp`} alt="" width="256" height="256" loading="eager" decoding="async"/>
          <div><strong>{employee.name}</strong><span>{employee.sector}</span></div>
        </div>
        <div class="market-background-skills">{employee.skills.slice(0, 2).map(skill => <span>{skill}</span>)}</div>
        <p class="market-background-work">{employee.description}</p>
        <div class="market-background-result"><Icon name="file-check" size={13}/><span>{employee.deliverable}</span></div>
      </div>)}
    </div>
  </div>

<style>
  .employee-banner-backdrop {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
    z-index: -1;
    mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 75%, transparent);
  }
  .employee-banner-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #06111ced, #06111ce3 34%, #06111cc7 72%, #06111cd9);
  }
  .market-card-field {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1500px;
    display: grid;
    grid-template-columns: repeat(6, 190px);
    gap: 72px;
    transform: translate(-50%, -50%) rotateX(48deg) rotateZ(-32deg);
    transform-origin: center;
    transform-style: preserve-3d;
  }
  .market-background-card {
    --card-accent: #416d9b;
    --card-stagger: -24px;
    --card-depth: 14px;
    min-width: 0;
    aspect-ratio: 9 / 16;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    padding: 22px 18px;
    border: 2px solid #fff;
    border-radius: 17px;
    background: #ffffffc7;
    box-shadow: 0 3px 8px #0003, 0 18px 32px -12px #0009, inset 0 1px 0 #fff;
    color: #243a55;
    opacity: .88;
    /* Compensate the projected height so elevation does not widen the gutters. */
    transform: translate3d(calc(var(--card-depth) * -.5885), calc(var(--card-stagger) + var(--card-depth) * .9418), var(--card-depth));
  }
  .market-background-card:nth-child(4n + 2) { --card-accent: #3d7e73; }
  .market-background-card:nth-child(4n + 3) { --card-accent: #786297; }
  .market-background-card:nth-child(4n) { --card-accent: #92764b; }
  .market-background-card:nth-child(even) { --card-stagger: 24px; }
  .market-background-card:nth-child(6n + 2) { --card-depth: 6px; }
  .market-background-card:nth-child(6n + 3) {
    --card-depth: 58px;
    box-shadow: 0 7px 10px #0003, 0 46px 40px -12px #000b, inset 0 1px 0 #fff;
  }
  .market-background-card:nth-child(6n + 4) { --card-depth: 4px; }
  .market-background-card:nth-child(6n + 5) {
    --card-depth: 36px;
    box-shadow: 0 5px 9px #0003, 0 32px 30px -10px #000a, inset 0 1px 0 #fff;
  }
  .market-background-card:nth-child(6n) { --card-depth: 18px; }
  .market-background-heading { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .market-background-heading img { display: block; width: 44px; height: 44px; flex: 0 0 auto; border-radius: 50%; object-fit: cover; border: 1px solid #c6dce880; box-shadow: 0 2px 7px #0a172d40; }
  .market-background-heading > div { min-width: 0; }
  .market-background-heading strong { display: block; font-size: 13px; font-weight: 550; line-height: 1.4; overflow-wrap: anywhere; }
  .market-background-heading span { display: block; margin-top: 5px; font-size: 10px; color: #6a7f99; }
  .market-background-skills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; }
  .market-background-skills span { padding: 5px 7px; font-size: 10px; line-height: 1.4; border: 1px solid color-mix(in srgb, var(--card-accent) 28%, transparent); border-radius: 4px; background: color-mix(in srgb, var(--card-accent) 10%, transparent); color: var(--card-accent); }
  .employee-banner-backdrop .market-background-work { margin-top: 18px; font-size: 11px; line-height: 1.8; color: #526a86; }
  .market-background-result { display: flex; align-items: flex-start; gap: 6px; margin-top: auto; padding-top: 24px; font-size: 10px; line-height: 1.6; }
  .market-background-result svg { flex-shrink: 0; color: var(--card-accent); }

  @media (max-width: 720px) {
    .market-card-field { width: 1156px; grid-template-columns: repeat(5, 180px); gap: 64px; }
    .market-background-card { --card-stagger: -18px; }
    .market-background-card:nth-child(even) { --card-stagger: 18px; }
    .employee-banner-backdrop::after { background: linear-gradient(#06111ced, #06111cdb 58%, #06111ce3); }
  }
</style>
