---
import Diagram from './Diagram.astro';
import CapabilityBreadcrumb from '../../../components/product/CapabilityBreadcrumb.astro';
import CapabilityHero from '../../../components/product/CapabilityHero.astro';
import CapabilityStory from '../../../components/product/CapabilityStory.astro';
import MultiAgentBackdrop from './MultiAgentBackdrop.astro';
import landing from './landing';
import experience from './experience';
import content from './content';
import type { Locale } from '../../../data/types';
import '../../../styles/multi-agent-product.css';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = landing[locale];
const stories = experience[locale].sections;
---
<div class="orchestration-page" data-capability="multi-agent">
  <CapabilityHero locale={locale} copy={copy.hero} fieldClass="ma-hero-field">
    <MultiAgentBackdrop slot="backdrop" locale={locale}/>
    <Diagram locale={locale} scene="overview" data={stories[0].visual}/>
  </CapabilityHero>
  <div class="container">
    {stories.map((story, index) => (
      <CapabilityStory id={story.id} title={story.title} body={story.body} points={story.points} reverse={index % 2 === 1}>
        <Diagram locale={locale} scene={story.id as 'delegate' | 'execute' | 'deliver'} data={story.visual}/>
      </CapabilityStory>
    ))}
  </div>
</div>
<CapabilityBreadcrumb locale={locale} slug="multi-agent" name={content.copy[locale].name}/>
