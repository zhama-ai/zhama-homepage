---
import { pricingPlans, capabilityGroups } from './content';
import PlanCard from './PlanCard.astro';
import CapabilityCatalog from './CapabilityCatalog.astro';
import Shell from '../resources/Shell.astro';
import { pathFor } from '../../lib/site';
import type { Locale } from '../../data/types';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
---
<Shell locale={locale} page="pricing" navigation={false}>
  <header class="pricing-hero ui-section" aria-labelledby="pricing-title">
    <div class="container">
      <div class="pricing-hero-copy ui-stack">
        <h1 class="ui-display" id="pricing-title">{zh ? <>从业务需要出发，<br/>选择合适的投入方式</> : <>Start with your business needs.<br/>Choose how to invest.</>}</h1>
        <p class="ui-lead">{zh ? '按团队规模、部署方式与交付范围沟通报价。' : 'Discuss pricing based on team size, deployment and delivery scope.'}</p>
        <a class="button" href={`${pathFor(locale, 'contact')}#enquiry-form`}>{zh ? '专属报价' : 'Get a tailored quote'}</a>
      </div>
    </div>
  </header>
  <section class="container pricing-plans ui-section" id="plans" aria-label={zh ? '方案选择' : 'Plan options'}>
    <div class="pricing-grid ui-grid">{pricingPlans[locale].map(plan => <PlanCard locale={locale} plan={plan}/>)}</div>
  </section>
  <CapabilityCatalog locale={locale} groups={capabilityGroups[locale]}/>
</Shell>

<style>
  .pricing-hero { position: relative; isolation: isolate; overflow: hidden; text-align: left; background: #070f19; }
  .pricing-hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg,#070f19f5 0%,#070f19b8 40%,#070f1926 78%),
      linear-gradient(180deg,#070f1999,transparent 48%,#070f19b3),
      url('../../assets/ocean-silk-critical_V1.0.webp') center 78%/cover no-repeat;
  }
  .pricing-hero-copy { max-width: var(--width-reading); justify-items: start; --stack-gap: var(--space-6); }
  h1, p { margin: 0; }
  .pricing-plans { scroll-margin-top: var(--space-20); }
  .pricing-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-4); }
  @media (max-width: 800px) {
    .pricing-grid { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-grid); }
  }
  @media (max-width: 700px) {
    .pricing-hero::before { background-position: center, center, 64% 78%; }
    .pricing-hero-copy { --stack-gap: var(--space-4); }
  }
</style>
