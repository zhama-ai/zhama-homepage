---
import Icon from '../../components/Icon.astro';
import type { Locale } from '../../data/types';
import type { CapabilityGroup } from './content';

interface Props { locale: Locale; groups: CapabilityGroup[]; }
const { locale, groups } = Astro.props;
const zh = locale === 'zh';
---
<section class="pricing-catalog ui-section" id="capabilities" aria-labelledby="capabilities-title">
  <div class="container ui-stack">
    <h2 id="capabilities-title" class="ui-section-title">{zh ? '产品功能' : 'Product capabilities'}</h2>
    <div class="capability-browser ui-grid" data-capability-browser>
      <nav class="capability-index" aria-label={zh ? '功能分类' : 'Capability categories'}>
        {groups.map((group, index) => <a href={`#capability-${group.id}`} data-capability-link={group.id} aria-current={index === 0 ? 'true' : undefined}>
          <Icon name={group.icon} size={18}/><span>{group.title}</span>
        </a>)}
      </nav>
      <div class="capability-content ui-stack">
        {groups.map(group => <section class="capability-group ui-surface" id={`capability-${group.id}`} data-capability-group={group.id} aria-labelledby={`capability-title-${group.id}`}>
          <h3 class="ui-card-title" id={`capability-title-${group.id}`}>{group.title}</h3>
          <dl>{group.rows.map(row => <div class="capability-row"><dt>{row.name}</dt><dd>{row.capability}</dd></div>)}</dl>
        </section>)}
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-catalog { background: #091522; scroll-margin-top: var(--space-20); }
  .pricing-catalog > .container { --stack-gap: var(--space-grid); }
  h2, h3 { margin: 0; }
  .capability-browser { grid-template-columns: minmax(0, 1fr) minmax(0, 3.3fr); align-items: start; }
  .capability-index {
    position: sticky; top: calc(var(--space-20) + var(--space-4)); display: grid; gap: var(--space-1);
    max-height: calc(100dvh - var(--space-24) - var(--space-6)); overflow-y: auto;
    overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #35536c transparent;
  }
  .capability-index a {
    display: flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: var(--space-2) var(--space-3);
    border: 1px solid transparent; border-radius: var(--radius-card); color: #a9c3d8; font-size: var(--type-ui);
  }
  .capability-index a :global(svg) { flex: none; }
  .capability-index a:is(:hover,[aria-current]) { color: #d3ecff; background: #13344e; border-color: #3684b266; }
  .capability-group { overflow: hidden; scroll-margin-top: var(--space-20); }
  .capability-group h3 { padding: var(--space-4) var(--space-card); background: #102438; border-bottom: 1px solid var(--color-edge); }
  dl { margin: 0; padding-inline: var(--space-card); }
  .capability-row {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: var(--space-4);
    padding-block: var(--space-4); font-size: var(--type-body); line-height: var(--leading-body);
  }
  .capability-row + .capability-row { border-top: 1px solid var(--color-edge); }
  .capability-row dt { color: #d8e9f7; font-weight: 600; }
  .capability-row dd { margin: 0; color: #bed0e1; }
  @media (max-width: 1000px) {
    .capability-row { grid-template-columns: minmax(0, 1fr); gap: var(--space-1); }
  }
  @media (max-width: 800px) {
    .capability-browser { grid-template-columns: minmax(0, 1fr); }
    .capability-index { position: static; display: flex; flex-wrap: wrap; gap: var(--space-2); max-height: none; overflow: visible; }
    .capability-index a { border-color: var(--color-edge); }
    .capability-index a :global(svg) { display: none; }
  }
</style>

<script>
  import { onPageMount } from '../../lib/page-lifecycle';

  onPageMount(signal => {
    const browser = document.querySelector('[data-capability-browser]');
    if (!browser) return;
    const links = [...browser.querySelectorAll<HTMLAnchorElement>('[data-capability-link]')];
    const index = browser.querySelector<HTMLElement>('.capability-index');

    const selectGroup = (id: string) => {
      links.forEach(link => {
        if (link.dataset.capabilityLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
      const selected = links.find(link => link.dataset.capabilityLink === id);
      if (!selected || !index || index.scrollHeight <= index.clientHeight) return;
      if (selected.offsetTop < index.scrollTop) index.scrollTop = selected.offsetTop;
      else if (selected.offsetTop + selected.offsetHeight > index.scrollTop + index.clientHeight) {
        index.scrollTop = selected.offsetTop + selected.offsetHeight - index.clientHeight;
      }
    };

    const syncHash = () => {
      const id = links.find(link => link.hash === location.hash)?.dataset.capabilityLink;
      if (id) selectGroup(id);
    };
    syncHash();
    links.forEach(link => link.addEventListener('click', () => {
      if (link.dataset.capabilityLink) selectGroup(link.dataset.capabilityLink);
    }, { signal }));
    window.addEventListener('hashchange', syncHash, { signal });

    const observer = new IntersectionObserver(entries => {
      const id = (entries.find(entry => entry.isIntersecting)?.target as HTMLElement | undefined)?.dataset.capabilityGroup;
      if (id) selectGroup(id);
    }, { rootMargin: '-18% 0px -58% 0px' });
    browser.querySelectorAll('[data-capability-group]').forEach(group => observer.observe(group));
    signal.addEventListener('abort', () => observer.disconnect(), { once: true });
  });
</script>
