---
import Icon from '../../components/Icon.astro';
import type { Locale } from '../../data/types';
import { aboutContent } from './content';
import './styles.css';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = aboutContent[locale];
---
<div class="about-page">
  <section class="about-hero" aria-labelledby="about-title">
    <div class="about-hero-background" aria-hidden="true">
      <img src="/images/about/architecture-banner_V1.0.webp" width="2172" height="724" alt="" fetchpriority="high"/>
    </div>
    <div class="container about-hero-content">
      <div class="about-hero-copy">
        <h1 id="about-title">{copy.title}</h1>
        <p class="about-hero-vision">{locale === 'zh' ? <><span>{copy.vision[0]}</span><span>{copy.vision[1]}{copy.vision[2]}</span></> : copy.vision.join(' ')}</p>
      </div>
    </div>
  </section>

  <section class="about-story" aria-labelledby="about-company-title">
    <div class="container">
      <div class="about-introduction">
        <h2 id="about-company-title"><Icon name="buildings" size={24}/>{copy.introductionTitle}</h2>
        {copy.introduction.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="about-beliefs" aria-labelledby="about-vision-title">
    <div class="container about-beliefs-layout">
      <div class="about-vision">
        <h2 id="about-vision-title"><Icon name="compass" size={24}/>{copy.visionTitle}</h2>
        <p>{copy.vision.join(locale === 'zh' ? '' : ' ')}</p>
      </div>
      <div class="about-values" aria-labelledby="about-values-title">
        <h2 id="about-values-title"><Icon name="layers" size={24}/>{copy.valuesTitle}</h2>
        <div class="about-values-grid">
          {copy.values.map(value => <article class="about-value">
            <h3><Icon name={value.icon} size={21}/>{value.title}</h3>
            <p class="about-value-lead">{value.lead}</p>
          </article>)}
        </div>
      </div>
    </div>
  </section>
</div>
