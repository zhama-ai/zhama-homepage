---
import Icon from '../../../components/Icon.astro';
import { appliancePage } from './content';
import type { Locale } from '../../../data/types';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = appliancePage[locale];
---

<section class="station-scenarios ui-section" aria-labelledby="station-scenarios-title" data-station-scenarios>
  <div class="container">
    <h2 id="station-scenarios-title" class="ui-section-title">{copy.titles.scenarios}</h2>
    <nav class="station-scenario-tabs" aria-labelledby="station-scenarios-title" data-scenario-tablist>
      {copy.scenarios.map(item => <a
        id={`station-tab-${item.id}`}
        href={`#station-panel-${item.id}`}
        data-scenario-tab
      ><span>{item.title}</span></a>)}
    </nav>
    <div class="station-scenario-stage">
      {copy.scenarios.map(item => <section
        class="station-scenario-panel"
        id={`station-panel-${item.id}`}
        aria-labelledby={`station-headline-${item.id}`}
        data-scenario-panel
      >
        <img class="station-scenario-background"
          src={`/images/appliance/scenario-${item.id}_V1.0.webp`}
          width="1672" height="941" alt="" loading="eager" decoding="async"
        />
        <div class="station-scenario-copy">
          <h3 id={`station-headline-${item.id}`} class="ui-subhead">{item.headline}</h3>
          <p class="ui-copy">{item.description}</p>
          <ul role="list">
            {item.points.map(point => <li><Icon name="check" size={18}/><span>{point}</span></li>)}
          </ul>
        </div>
      </section>)}
    </div>
  </div>
</section>

<script>
  import { onPageMount } from '../../../lib/page-lifecycle';
  import { initStationScenarios } from './scenarios';
  onPageMount(signal => {
    document.querySelectorAll<HTMLElement>('[data-station-scenarios]').forEach(root => initStationScenarios(root, signal));
  });
</script>

<style>
  .station-scenarios h2{margin:0 0 var(--space-grid)}
  .station-scenario-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-1);margin-bottom:var(--space-4);padding:var(--space-1);border:1px solid var(--color-edge);border-radius:var(--radius-card);background:#0c1724}
  .station-scenario-tabs a{display:flex;align-items:center;justify-content:center;min-height:48px;padding:var(--space-2) var(--space-3);border-radius:var(--space-1);color:#9fb3c7;font-size:var(--type-ui);font-weight:500;line-height:var(--leading-heading);text-align:center;text-decoration:none;transition:color .2s,background-color .2s,box-shadow .2s}
  .station-scenario-tabs a:hover{color:#edf5ff;background-color:#18334d}
  .station-scenario-tabs a[aria-selected="true"]{color:#fff;background:#126fca;box-shadow:0 4px 16px #00529b38,inset 0 1px 0 #a7e5ff24}
  .station-scenario-tabs a:focus-visible{outline:2px solid #b9e4ff;outline-offset:2px}
  .station-scenario-stage{position:relative;display:grid;gap:var(--space-grid)}
  [data-enhanced] .station-scenario-stage{isolation:isolate;overflow:hidden}
  .station-scenario-panel{position:relative;isolation:isolate;min-height:480px;overflow:hidden;background:#08131f;border-radius:var(--radius-card)}
  .station-scenario-panel[hidden]{display:none}
  .station-scenario-panel:focus-visible{outline:2px solid #88c9f7;outline-offset:5px}
  .station-scenario-background{position:absolute;inset:0;z-index:-2;display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .station-scenario-panel::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#08131ff5 0%,#08131fe8 32%,#08131f80 54%,#08131f00 77%)}
  .station-scenario-copy{position:relative;display:grid;align-content:center;gap:var(--space-4);width:56%;min-height:480px;padding:var(--space-12)}
  .station-scenario-copy h3{margin:0;text-wrap:balance}
  .station-scenario-copy>p{margin:0;text-wrap:pretty}
  .station-scenario-copy ul{display:grid;gap:var(--space-2);margin:0;padding:0;list-style:none}
  .station-scenario-copy li{display:flex;align-items:baseline;gap:var(--space-3);color:#d0e0ee;font-size:var(--type-body);line-height:var(--leading-body)}
  .station-scenario-copy li>:global(svg){flex-shrink:0;align-self:flex-start;margin-top:var(--space-1);color:#85b8d9}
  .station-scenario-outgoing{position:absolute;inset:0;z-index:2;pointer-events:none;min-height:0}
  @media(max-width:1100px){
    .station-scenario-copy{width:62%;padding:var(--space-8)}
  }
  @media(max-width:800px){
    .station-scenario-copy{width:75%}
    .station-scenario-panel::before{background:linear-gradient(90deg,#08131ff5,#08131fdb 42%,#08131f38)}
  }
  @media(max-width:600px){
    .station-scenario-tabs{grid-template-columns:repeat(2,minmax(0,1fr))}
    .station-scenario-background{height:300px;object-position:78% center}
    .station-scenario-panel::before{background:linear-gradient(180deg,#08131f00 80px,#08131f4d 140px,#08131f 270px)}
    .station-scenario-panel{min-height:0}
    .station-scenario-copy{width:100%;min-height:0;padding:210px var(--space-card) var(--space-8)}
  }
  @media(prefers-reduced-motion:reduce){
    .station-scenario-tabs a{transition:none}
  }
</style>
