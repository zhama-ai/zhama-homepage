---
import Icon from '../../../components/Icon.astro';
import { appliancePage } from './content';
import type { Locale } from '../../../data/types';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = appliancePage[locale];
---

<section class="station-section station-scenarios" aria-labelledby="station-scenarios-title" data-station-scenarios>
  <div class="container">
    <h2 id="station-scenarios-title">{copy.titles.scenarios}</h2>
    <nav class="station-scenario-tabs" aria-labelledby="station-scenarios-title" data-scenario-tablist>
      {copy.scenarios.map(item => <a
        id={`station-tab-${item.id}`}
        href={`#station-panel-${item.id}`}
        data-scenario-tab
      ><span>{item.title}</span></a>)}
    </nav>
    <div class="station-scenario-stage">
      {copy.scenarios.map(item => <section
        class="station-scenario-panel"
        id={`station-panel-${item.id}`}
        aria-labelledby={`station-headline-${item.id}`}
        data-scenario-panel
      >
        <img class="station-scenario-background"
          src={`/images/appliance/scenario-${item.id}_V1.0.webp`}
          width="1672" height="941" alt="" loading="eager" decoding="async"
        />
        <div class="station-scenario-copy">
          <h3 id={`station-headline-${item.id}`}>{item.headline}</h3>
          <p>{item.description}</p>
          <ul role="list">
            {item.points.map(point => <li><Icon name="check" size={18}/><span>{point}</span></li>)}
          </ul>
        </div>
      </section>)}
    </div>
  </div>
</section>

<script>
  import { onPageMount } from '../../../lib/page-lifecycle';
  import { initStationScenarios } from './scenarios';
  onPageMount(signal => {
    document.querySelectorAll<HTMLElement>('[data-station-scenarios]').forEach(root => initStationScenarios(root, signal));
  });
</script>

<style>
  .station-scenarios{padding:65px 0;background:transparent}
  .station-scenarios h2{margin:0 0 30px;color:#edf5ff;font-size:30px;line-height:1.5;font-weight:550;letter-spacing:-.6px}
  .station-scenario-tabs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-bottom:24px;padding:6px;border:1px solid #8abce21a;border-radius:12px;background:#0c1724}
  .station-scenario-tabs a{display:flex;align-items:center;justify-content:center;min-height:60px;padding:13px 16px;border-radius:7px;color:#9fb3c7;font-size:17px;font-weight:500;line-height:1.5;text-align:center;text-decoration:none;transition:color .2s,background-color .2s,box-shadow .2s}
  .station-scenario-tabs a:hover{color:#edf5ff;background-color:#18334d}
  .station-scenario-tabs a[aria-selected="true"]{color:#fff;background:#126fca;box-shadow:0 4px 16px #00529b38,inset 0 1px 0 #a7e5ff24}
  .station-scenario-tabs a:focus-visible{outline:2px solid #b9e4ff;outline-offset:2px}
  .station-scenario-stage{position:relative;display:grid;gap:28px}
  [data-enhanced] .station-scenario-stage{isolation:isolate;overflow:hidden}
  .station-scenario-panel{position:relative;isolation:isolate;min-height:500px;overflow:hidden;background:#08131f}
  .station-scenario-panel[hidden]{display:none}
  .station-scenario-panel:focus-visible{outline:2px solid #88c9f7;outline-offset:5px}
  .station-scenario-background{position:absolute;inset:0;z-index:-2;display:block;width:100%;height:100%;object-fit:cover;object-position:center}
  .station-scenario-panel::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,#08131ff5 0%,#08131fe8 32%,#08131f80 54%,#08131f00 77%)}
  .station-scenario-copy{position:relative;display:flex;flex-direction:column;justify-content:center;width:56%;min-height:500px;padding:48px}
  .station-scenario-copy h3{margin:0;color:#edf5ff;font-size:32px;font-weight:500;line-height:1.45;letter-spacing:-.7px;text-wrap:balance}
  .station-scenario-copy>p{margin:22px 0 0;color:#b5c5d5;font-size:var(--text-body,16px);line-height:1.9;text-wrap:pretty}
  .station-scenario-copy ul{display:grid;gap:13px;margin:28px 0 0;padding:0;list-style:none}
  .station-scenario-copy li{display:flex;align-items:baseline;gap:12px;color:#d0e0ee;font-size:var(--text-body,16px);line-height:1.65}
  .station-scenario-copy li>:global(svg){flex-shrink:0;align-self:flex-start;margin-top:5px;color:#85b8d9}
  .station-scenario-outgoing{position:absolute;inset:0;z-index:2;pointer-events:none;min-height:0}
  @media(max-width:1100px){
    .station-scenario-tabs a{font-size:16px;padding:13px 10px}
    .station-scenario-copy{width:62%;padding:38px}
    .station-scenario-copy h3{font-size:29px}
  }
  @media(max-width:800px){
    .station-scenarios{padding:46px 0}
    .station-scenarios h2{font-size:27px;margin-bottom:20px}
    .station-scenario-tabs{margin-bottom:20px}
    .station-scenario-tabs a{padding:12px 8px;font-size:15px}
    .station-scenario-copy{width:75%;padding:32px;min-height:500px}
    .station-scenario-panel::before{background:linear-gradient(90deg,#08131ff5,#08131fdb 42%,#08131f38)}
  }
  @media(max-width:600px){
    .station-scenario-tabs{grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;padding:5px}
    .station-scenario-tabs a{min-height:54px;padding:10px 8px;font-size:15px}
    .station-scenario-background{height:300px;object-position:78% center}
    .station-scenario-panel::before{background:linear-gradient(180deg,#08131f00 80px,#08131f4d 140px,#08131f 270px)}
    .station-scenario-panel{min-height:0}
    .station-scenario-copy{width:100%;min-height:0;padding:210px 24px 32px}
    .station-scenario-copy h3{font-size:26px;line-height:1.5;letter-spacing:-.5px}
    .station-scenario-copy>p{margin-top:18px}
    .station-scenario-copy ul{margin-top:24px;gap:12px}
  }
  @media(prefers-reduced-motion:reduce){
    .station-scenario-tabs a{transition:none}
  }
</style>
