---
import Delivery from './Delivery.astro';
import Scenarios from './Scenarios.astro';
import { pathFor } from '../../../lib/site';
import { appliancePage } from './content';
import type { Locale } from '../../../data/types';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = appliancePage[locale];
---

<section class="station-hero ui-section" aria-labelledby="station-title">
  <div class="container">
    <div class="station-hero-grid ui-grid">
      <div class="station-copy ui-stack">
        <h1 id="station-title" class="ui-display">{copy.name}</h1>
        <p class="station-headline ui-subhead">{copy.headline}</p>
        <p class="station-description ui-lead">{copy.description}</p>
        <a class="button" href={pathFor(locale, 'contact')}>{copy.action}</a>
      </div>
      <div class="station-product">
        <img src="/images/appliance/tego-station_V1.0.webp" width="1449" height="759" alt="TeGo Station" fetchpriority="high" decoding="async"/>
      </div>
    </div>
    <dl class="station-highlights ui-grid">
      {copy.highlights.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
    </dl>
  </div>
</section>

<Delivery locale={locale}/>

<Scenarios locale={locale}/>

<section class="station-specifications ui-section" aria-labelledby="station-specs-title">
  <div class="container">
    <h2 id="station-specs-title" class="ui-section-title">{copy.titles.specs}</h2>
    <dl class="station-specs">
      {copy.specs.map(item => <div><dt>{item.name}</dt><dd>{item.value}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .station-hero { overflow: hidden; }
  .station-hero-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: center; }
  .station-copy { justify-items: start; }
  .station-copy :is(h1, p) { margin: 0; }
  .station-headline { white-space: pre-line; }
  .station-product { display: grid; align-items: center; min-width: 0; width: 100%; max-width: 600px; justify-self: center; aspect-ratio: var(--ratio-product-hero); }
  .station-product img { display: block; width: 100%; height: auto; filter: drop-shadow(0 28px 24px #0008); }
  .station-highlights { grid-template-columns: repeat(3, minmax(0, 1fr)); margin: var(--space-grid) 0 0; }
  .station-highlights > div { display: grid; align-content: start; gap: var(--space-2); }
  .station-highlights dt { grid-row: 2; color: var(--color-meta); font-size: var(--type-meta); }
  .station-highlights dd { grid-row: 1; margin: 0; color: var(--color-heading); font-size: var(--type-subhead); font-weight: 600; line-height: var(--leading-heading); }
  h2 { margin: 0 0 var(--space-grid); }
  .station-specs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-grid); margin: 0; }
  .station-specs > div { display: grid; grid-template-columns: minmax(6em, 1fr) minmax(0, 3fr); gap: var(--space-4); padding-block: var(--space-4); border-bottom: 1px solid var(--color-edge); }
  .station-specs dt { color: var(--color-meta); }
  .station-specs dd { margin: 0; color: var(--color-copy); overflow-wrap: anywhere; }
  .station-specs > div:nth-last-child(-n+2) { border-bottom: 0; }
  @media (max-width: 800px) {
    .station-hero-grid, .station-specs { grid-template-columns: minmax(0, 1fr); }
    .station-product { aspect-ratio: auto; }
    .station-specs > div:nth-last-child(2) { border-bottom: 1px solid var(--color-edge); }
  }
  @media (max-width: 480px) {
    .station-highlights { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
