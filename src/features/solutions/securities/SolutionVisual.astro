---
import type { Locale } from '../../../data/types';

interface Props { locale: Locale; index: number; }
const { locale, index } = Astro.props;
const zh = locale === 'zh';
const copy = zh ? {
  researchEmployee: '研究论证数字员工', reviewEmployee: '研报审阅数字员工', branchEmployee: '营业部经营数字员工', serviceEmployee: '客户服务数字员工',
  research: '研究论证', evidence: '事件与指标', hypothesis: '需求兑现与业绩质量',
  source: ['订单与交付公告', '财报与现金流', '历史与同业指标'],
  support: '支持方向', counter: '反证检查',
  supports: ['交付进展与收入确认相互核对', '经营现金流与回款质量交叉验证'],
  counters: ['应收增加是否弱化现金回收', '费用变化是否偏离交付节奏'],
  hypothesisLabel: '研究假设', matrix: '研究论证表', analyst: '分析师形成观点',
  matrixRows: ['支持依据', '反证线索', '待验证项'],
  review: '发布前合规审阅', report: '发布审阅工作表', forecast: '预测假设与测算口径',
  forecastBody: '引用来源 ↔ 预测假设', forecastState: '核对引用依据',
  risk: '风险因素与研究结论', riskBody: '研究结论 ↔ 风险因素', riskState: '核对风险覆盖差异',
  rules: '适用规则', ruleItems: ['数据与事实来源', '预测口径与假设', '审慎表述与风险揭示'],
  reviewTasks: '发布复核任务表', actions: ['定位问题原句', '关联适用条款', '修订版本回核'], approved: '有权人员确认发布',
  branch: '营业部经营归因', attribution: '资产与交易变化', causes: ['资金转入转出', '市值变动', '产品结构迁移'],
  dimensions: ['营业部', '客群', '产品', '渠道'], priority: '重点客群',
  segments: ['资产转出需跟进', '交易活跃度变化', '产品到期待服务'],
  service: '客群服务准备清单', serviceRows: ['核对客户与服务背景', '整理沟通主题与材料', '交接责任人员与待办'], suitability: '人员确认适当性与服务行动',
  heroResearch: '研究论证', heroReview: '发布前审阅', heroBranch: '营业部经营',
  heroSupport: '交付与收入确认相互核对', heroCounter: '应收变化与回款质量交叉验证',
  heroConclusion: '论据 · 反证 · 待验证假设',
  heroRules: ['原句定位', '规则对照', '修订复核'], heroService: '重点客群 → 服务准备',
} : {
  researchEmployee: 'Research Argument Digital Employee', reviewEmployee: 'Research Review Digital Employee', branchEmployee: 'Branch Analysis Digital Employee', serviceEmployee: 'Client Service Digital Employee',
  research: 'Research arguments', evidence: 'Events and indicators', hypothesis: 'Demand conversion and earnings quality',
  source: ['Orders and delivery disclosures', 'Accounts and cash flow', 'History and peer indicators'],
  support: 'Supporting evidence', counter: 'Counterargument checks',
  supports: ['Reconcile delivery progress with revenue recognition', 'Cross-check collections against operating cash flow'],
  counters: ['Could receivables growth weaken cash collection?', 'Do expenses diverge from the delivery cycle?'],
  hypothesisLabel: 'Research assumption', matrix: 'Research argument matrix', analyst: 'Analyst forms a view',
  matrixRows: ['Supporting evidence', 'Counterarguments', 'Open questions'],
  review: 'Pre-release compliance review', report: 'Release review worksheet', forecast: 'Forecast assumptions and definitions',
  forecastBody: 'Cited sources ↔ Forecast assumptions', forecastState: 'Check source evidence',
  risk: 'Risk factors and research conclusions', riskBody: 'Research conclusions ↔ Risk factors', riskState: 'Check risk coverage gaps',
  rules: 'Applicable rules', ruleItems: ['Data and factual sources', 'Forecast definitions and assumptions', 'Prudent wording and risk disclosure'],
  reviewTasks: 'Release review tasks', actions: ['Locate the passage', 'Map the provision', 'Recheck the revision'], approved: 'Authorized release approval',
  branch: 'Branch business attribution', attribution: 'Asset and activity changes', causes: ['Fund transfers', 'Valuation movements', 'Product mix shifts'],
  dimensions: ['Branch', 'Segment', 'Product', 'Channel'], priority: 'Priority segments',
  segments: ['Asset outflows to follow up', 'Changes in trading activity', 'Maturing products to service'],
  service: 'Client service preparation', serviceRows: ['Check client and service context', 'Prepare discussion topics and materials', 'Hand over owners and follow-up actions'], suitability: 'Staff confirm suitability and service actions',
  heroResearch: 'Research arguments', heroReview: 'Pre-release review', heroBranch: 'Branch business',
  heroSupport: 'Reconcile delivery with revenue recognition', heroCounter: 'Cross-check receivables and cash collection',
  heroConclusion: 'Evidence · Counterarguments · Open questions',
  heroRules: ['Locate text', 'Map rules', 'Recheck revisions'], heroService: 'Priority segments → Service preparation',
};
---

<div class:list={['securities-visual', `securities-visual-${index}`, { 'securities-visual-en': !zh }]}>
  {index === -1 && <div class="securities-panorama">
    <div class="panorama-research surface">
      <div class="visual-heading"><span class="research-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 4h16v16H4zM8 8h8M8 12h3m-3 4h8"/></svg></span><h3>{copy.heroResearch}</h3></div>
      <div class="panorama-executor"><strong>TeGo</strong><span>{copy.researchEmployee}</span></div>
      <div class="panorama-sources">{copy.source.map(item => <span>{item}</span>)}</div>
      <div class="panorama-hypothesis"><span>{copy.hypothesisLabel}</span><strong>{copy.hypothesis}</strong></div>
      <div class="panorama-arguments">
        <div><span class="argument-dot" aria-hidden="true"></span><p>{copy.heroSupport}</p></div>
        <div><span class="argument-dot argument-dot-gold" aria-hidden="true"></span><p>{copy.heroCounter}</p></div>
      </div>
      <div class="panorama-research-result"><strong>{copy.matrix}</strong><span>{copy.heroConclusion}</span></div>
    </div>
    <div class="panorama-review surface">
      <div class="visual-heading"><span class="review-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 3h10l4 4v14H5zM15 3v5h4M9 12h5m-5 4h7"/></svg></span><h3>{copy.heroReview}</h3></div>
      <div class="panorama-executor"><span>{copy.reviewEmployee}</span></div>
      <div class="panorama-highlight">{copy.forecast}</div>
      <ul class="panorama-review-list">{copy.heroRules.map(item => <li><span aria-hidden="true"></span>{item}</li>)}</ul>
      <div class="small-deliverable">{copy.reviewTasks}</div>
    </div>
    <div class="panorama-branch surface">
      <div class="visual-heading"><span class="branch-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 20V5m0 15h17M8 16l4-5 4 2 5-7"/></svg></span><h3>{copy.heroBranch}</h3></div>
      <div class="panorama-executor"><span>{copy.branchEmployee}</span></div>
      <div class="panorama-causes">{copy.causes.map(cause => <span>{cause}</span>)}</div>
      <div class="panorama-service">{copy.heroService}</div>
    </div>
  </div>}

  {index === 0 && <div class="research-composition">
    <div class="research-sources"><span class="group-label">{copy.evidence}</span><div>{copy.source.map((source, sourceIndex) => <div><svg aria-hidden="true" viewBox="0 0 20 22" fill="none">{sourceIndex === 1 ? <path d="M3 18V4m0 14h14M6 14l3-4 3 2 5-6"/> : <path d="M4 2h8l4 4v14H4zM12 2v4h4M7 10h6m-6 4h6"/>}</svg><span>{source}</span></div>)}</div></div>
    <div class="research-hypothesis surface"><img src="/images/home/employee-avatar-research_V1.0.webp" alt="" width="32" height="32" loading="lazy" decoding="async"/><div><span>TeGo · {copy.researchEmployee}</span><h3>{copy.hypothesis}</h3></div></div>
    <div class="argument-columns">
      <div class="argument-column support-column"><h4><span aria-hidden="true">+</span>{copy.support}</h4><ul>{copy.supports.map(item => <li>{item}</li>)}</ul></div>
      <div class="argument-column counter-column"><h4><span aria-hidden="true">±</span>{copy.counter}</h4><ul>{copy.counters.map(item => <li>{item}</li>)}</ul></div>
    </div>
    <div class="research-result surface"><div><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 4h16v16H4zM4 9h16M10 9v11M10 14h10"/></svg><strong>{copy.matrix}</strong></div><ul>{copy.matrixRows.map(row => <li>{row}</li>)}</ul><span class="review-state">{copy.analyst}</span></div>
  </div>}

  {index === 1 && <div class="review-composition">
    <div class="review-document surface">
      <div class="document-title"><span>{copy.report}</span><span class="document-mark" aria-hidden="true"><svg viewBox="0 0 20 22" fill="none"><path d="M4 2h8l4 4v14H4zM12 2v4h4M7 10h6m-6 4h4"/></svg></span></div>
      <div class="review-passage"><h3>{copy.forecast}</h3><p><mark>{copy.forecastBody}</mark></p><span class="passage-state">{copy.forecastState}</span></div>
      <div class="review-passage"><h3>{copy.risk}</h3><p><mark>{copy.riskBody}</mark></p><span class="passage-state">{copy.riskState}</span></div>
    </div>
    <div class="rule-mapping"><h4>{copy.rules}</h4><ul>{copy.ruleItems.map(item => <li><svg aria-hidden="true" viewBox="0 0 18 18" fill="none"><path d="m6 6 2-2a3 3 0 0 1 4 4l-2 2m0 2-2 2a3 3 0 0 1-4-4l2-2m0 4 6-6"/></svg><span>{item}</span></li>)}</ul></div>
    <div class="review-taskboard surface"><div class="executor-label">TeGo · {copy.reviewEmployee}</div><h4>{copy.reviewTasks}</h4><ol>{copy.actions.map(action => <li><span class="task-checkbox" aria-hidden="true"></span><span>{action}</span></li>)}</ol><span class="review-state">{copy.approved}</span></div>
  </div>}

  {index === 2 && <div class="branch-composition">
    <div class="attribution-source"><div class="executor-label">TeGo · {copy.branchEmployee}</div><div class="visual-heading"><span class="branch-symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 20V5m0 15h17M8 16l4-5 4 2 5-7"/></svg></span><h3>{copy.attribution}</h3></div><div class="dimension-tags">{copy.dimensions.map(item => <span>{item}</span>)}</div></div>
    <div class="attribution-branches">{copy.causes.map((cause, causeIndex) => <div class:list={['attribution-cause', {'gold-cause': causeIndex === 1}]}><span class="cause-node" aria-hidden="true"></span><strong>{cause}</strong></div>)}</div>
    <div class="segment-ledger surface"><h4>{copy.priority}</h4><ul>{copy.segments.map(item => <li><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><circle cx="8" cy="6" r="3"/><path d="M2 17v-2a6 6 0 0 1 12 0v2m1-9h3m-1.5-1.5v3"/></svg>{item}</li>)}</ul></div>
    <div class="service-preparation surface"><div class="executor-label">{copy.serviceEmployee}</div><h4>{copy.service}</h4><ul>{copy.serviceRows.map(item => <li><span aria-hidden="true"></span>{item}</li>)}</ul></div>
    <div class="branch-human-review"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8"/><path d="m6 10 3 3 5-6"/></svg>{copy.suitability}</div>
  </div>}
</div>

<style>
  .securities-visual { --sv-text: #d9e8f4; --sv-muted: #91a9be; --sv-blue: #9acfe7; --sv-gold: #d3bc86; position: relative; width: 100%; max-width: 590px; container-type: inline-size; color: var(--sv-text); font-family: inherit; isolation: isolate; }
  .securities-visual::before { content: ''; position: absolute; z-index: -1; inset: 6% -5%; pointer-events: none; background: radial-gradient(ellipse at 48% 55%, #1e587621, transparent 70%); }
  .securities-visual *, .securities-visual *::before, .securities-visual *::after { box-sizing: border-box; }
  .securities-visual h3, .securities-visual h4, .securities-visual p { margin: 0; }
  .securities-visual h3, .securities-visual h4 { font-size: 14px; line-height: 1.6; font-weight: 550; color: #dcebf5; overflow-wrap: break-word; }
  .securities-visual ul, .securities-visual ol { margin: 0; padding: 0; list-style: none; }
  .securities-visual svg { flex: 0 0 auto; stroke: currentColor; stroke-width: 1.25; stroke-linecap: round; stroke-linejoin: round; }
  .surface { min-width: 0; background: linear-gradient(135deg, #1a3044f2, #101e2ff5); border: 1px solid #819db338; border-radius: 7px; box-shadow: 0 14px 30px #00081638, 0 3px 7px #00000018; }
  .visual-heading { display: flex; align-items: center; gap: 9px; }
  .visual-heading > span { display: flex; flex: 0 0 auto; color: var(--sv-blue); }
  .visual-heading svg { width: 23px; height: 23px; }
  .visual-heading > .review-symbol { color: var(--sv-gold); }
  .visual-heading > .branch-symbol { color: #92c2bd; }
  .group-label { color: var(--sv-muted); font-size: 12px; line-height: 1.6; }
  .executor-label { margin-bottom: 9px; color: #91b0c5; font-size: 12px; line-height: 1.6; }
  .review-state { display: flex; align-items: center; gap: 7px; width: fit-content; color: #a9c9bb; font-size: 12px; line-height: 1.6; }
  .review-state::before { content: ''; flex: 0 0 auto; width: 5px; height: 5px; background: #8cb9a9; border-radius: 50%; }

  .securities-panorama { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .92fr); gap: 15px; padding: 8px 3px 14px; align-items: start; }
  .panorama-research { grid-row: 1 / 3; padding: 19px 18px 17px; transform: translateY(18px); }
  .panorama-executor { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 8px; margin-top: 9px; color: #90afc2; font-size: 12px; line-height: 1.6; }
  .panorama-executor strong { color: #b4d3e3; font-size: 13px; font-weight: 600; }
  .panorama-sources { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 18px; padding-bottom: 14px; color: #91b3cc; font-size: 12px; line-height: 1.6; }
  .panorama-hypothesis { display: grid; gap: 6px; padding: 13px; background: #407fa21a; border: 1px solid #7caec72e; border-radius: 4px; }
  .panorama-hypothesis > span { color: #7fa8c3; font-size: 12px; }
  .panorama-hypothesis strong { font-size: 14px; line-height: 1.6; font-weight: 500; color: #c8e3f2; }
  .panorama-arguments { display: grid; gap: 13px; padding: 18px 1px; }
  .panorama-arguments > div { display: flex; gap: 8px; align-items: flex-start; }
  .argument-dot { flex: 0 0 auto; width: 5px; height: 5px; margin-top: 8px; border-radius: 50%; background: #83b8d0; }
  .argument-dot-gold { background: #c5ad7b; }
  .panorama-arguments p { color: #a9c1d3; font-size: 12px; line-height: 1.8; }
  .panorama-research-result { display: grid; gap: 5px; padding: 12px 13px; margin-inline: -4px; border: 1px solid #9abfce3d; border-radius: 5px; background: linear-gradient(110deg, #749eae22, #356a7f1a); box-shadow: 0 7px 14px #00071026; }
  .panorama-research-result strong { color: #d2e8ef; font-size: 14px; font-weight: 550; }
  .panorama-research-result > span { color: #94b0c1; font-size: 12px; line-height: 1.7; }
  .panorama-review { padding: 17px 16px 14px; background: linear-gradient(140deg, #253448e8, #172536f5); }
  .panorama-highlight { margin-top: 16px; padding: 8px 9px; color: #d7c9a6; font-size: 12px; line-height: 1.6; background: #bea97112; border: 1px solid #bda8782e; border-radius: 3px; }
  .panorama-review-list { display: grid; gap: 7px; margin-top: 12px !important; }
  .panorama-review-list li { display: flex; gap: 8px; align-items: center; color: #9fb4c5; font-size: 12px; line-height: 1.6; }
  .panorama-review-list li > span { flex: 0 0 auto; width: 8px; height: 8px; border: 1px solid #a99d7f8c; border-radius: 2px; }
  .small-deliverable { margin-top: 13px; color: #d3c4a1; font-size: 12px; line-height: 1.6; }
  .panorama-branch { margin-left: 10px; padding: 15px 16px; background: linear-gradient(135deg, #18323ce8, #122736f7); }
  .panorama-causes { display: flex; flex-wrap: wrap; gap: 6px 10px; margin-top: 13px; color: #9cbabf; font-size: 12px; line-height: 1.6; }
  .panorama-service { margin-top: 14px; color: #b9d8d5; font-size: 12px; line-height: 1.7; }

  .research-composition { padding: 5px 7px 15px; }
  .research-sources > div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 13px; }
  .research-sources > div > div { display: flex; gap: 8px; align-items: flex-start; min-width: 0; }
  .research-sources svg { width: 19px; height: 21px; color: #7ba9c5; }
  .research-sources > div span { color: #a9c2d4; font-size: 12px; line-height: 1.6; }
  .research-hypothesis { position: relative; display: flex; gap: 12px; align-items: center; margin: 24px 35px 19px; padding: 15px 17px; background: linear-gradient(125deg, #1b4059ea, #142a3df1); }
  .research-hypothesis > img { flex: 0 0 auto; width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
  .research-hypothesis > div { min-width: 0; }
  .research-hypothesis > div > span { display: block; margin-bottom: 5px; color: #7fa7c1; font-size: 12px; line-height: 1.6; }
  .research-hypothesis::before { content: ''; position: absolute; left: 50%; width: 1px; height: 24px; bottom: 100%; background: #6f9ab63d; }
  .argument-columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 22px; }
  .argument-column { min-width: 0; padding: 12px 15px 16px; border: 1px solid #7ea8c12e; border-radius: 5px; background: #17334a40; }
  .argument-column h4 { display: flex; align-items: center; gap: 7px; font-size: 13px; color: #9fcbdf; }
  .argument-column h4 > span { font-size: 17px; font-weight: 400; line-height: 1; }
  .argument-column ul { display: grid; gap: 11px; margin-top: 12px; }
  .argument-column li { color: #a5bfd2; font-size: 12px; line-height: 1.8; }
  .counter-column { background: #4c412b12; border-color: #bfa67929; }
  .counter-column h4 { color: #cfba8c; }
  .counter-column li { color: #b8b4a4; }
  .research-result { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 12px 18px; position: relative; margin: 21px 20px 0; padding: 16px 18px; background: linear-gradient(120deg, #1c3b4df7, #162a3bf5); }
  .research-result::before { content: ''; position: absolute; left: 50%; bottom: 100%; width: 1px; height: 21px; background: #6f9ab63d; }
  .research-result > div { display: flex; gap: 8px; align-items: center; }
  .research-result svg { width: 21px; height: 21px; color: #94c2d1; }
  .research-result strong { color: #c3e0e8; font-size: 14px; font-weight: 550; }
  .research-result ul { display: flex; flex-wrap: wrap; gap: 5px 12px; justify-content: flex-end; }
  .research-result li { color: #a2bdca; font-size: 12px; line-height: 1.6; }
  .research-result .review-state { grid-column: 1 / -1; }

  .review-composition { display: grid; grid-template-columns: minmax(0, 1.48fr) minmax(0, 1fr); align-items: start; gap: 17px 20px; padding: 8px 7px 18px; }
  .review-document { grid-row: 1 / 3; padding: 18px 20px 22px; transform: rotate(-1deg); }
  .document-title { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 19px; color: #c9dfed; font-size: 15px; font-weight: 550; }
  .document-mark { display: flex; color: #7da6c0; }
  .document-mark svg { width: 19px; height: 21px; }
  .review-passage + .review-passage { margin-top: 23px; }
  .review-passage h3 { color: #b8ccdb; font-size: 13px; }
  .review-passage p { margin-top: 9px; color: #a7bdce; font-size: 12px; line-height: 1.95; }
  .review-passage mark { padding: 2px 0; background: #b19c6719; color: inherit; box-decoration-break: clone; text-decoration: underline; text-decoration-color: #baa57270; text-underline-offset: 5px; }
  .passage-state { display: inline-block; margin-top: 10px; color: #cbb98e; font-size: 12px; line-height: 1.6; }
  .rule-mapping { padding: 15px 0 3px; }
  .rule-mapping h4 { color: #c6b58d; font-size: 13px; }
  .rule-mapping ul { display: grid; gap: 11px; margin-top: 14px; }
  .rule-mapping li { display: flex; gap: 7px; align-items: flex-start; color: #a9b7bf; font-size: 12px; line-height: 1.7; }
  .rule-mapping svg { width: 16px; height: 16px; margin-top: 2px; color: #a39675; }
  .review-taskboard { position: relative; margin-left: -7px; padding: 15px 16px; background: linear-gradient(130deg, #263746f5, #192b3bf7); }
  .review-taskboard h4 { color: #c7dbdf; font-size: 13px; }
  .review-taskboard ol { display: grid; gap: 8px; margin-top: 12px; }
  .review-taskboard li { display: flex; align-items: center; gap: 8px; color: #a9c1cf; font-size: 12px; line-height: 1.7; }
  .task-checkbox { width: 9px; height: 9px; flex: 0 0 auto; border: 1px solid #8aa9b581; border-radius: 2px; }
  .review-taskboard .review-state { margin-top: 14px; }

  .branch-composition { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 21px 20px; padding: 9px 8px 14px; }
  .attribution-source { grid-column: 1 / -1; padding-inline: 18px; }
  .dimension-tags { display: flex; flex-wrap: wrap; gap: 7px 21px; margin: 12px 0 0 32px; color: #8caebc; font-size: 12px; line-height: 1.7; }
  .attribution-branches { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; position: relative; padding: 19px 9px 0; }
  .attribution-branches::before { content: ''; position: absolute; left: 16%; right: 16%; height: 1px; top: 0; background: #689baf42; }
  .attribution-branches::after { content: ''; position: absolute; top: -10px; left: 50%; width: 1px; height: 10px; background: #689baf42; }
  .attribution-cause { position: relative; min-width: 0; display: flex; gap: 7px; align-items: center; justify-content: center; padding: 12px 6px; background: #1b3f4e36; border: 1px solid #84acae37; border-radius: 5px; }
  .attribution-cause::before { content: ''; position: absolute; left: 50%; bottom: 100%; width: 1px; height: 19px; background: #689baf42; }
  .cause-node { flex: 0 0 auto; width: 5px; height: 5px; background: #83bbb8; border-radius: 50%; }
